{
  "fromId": "t",
  "toId": "s",
  "preamble": "The voiceless alveolar stop [t] becomes the alveolar fricative [s] before a high front vowel (assibilation): the stop gains friction and loses its closure. Finnish changed *t to s before i (*vete > vesi 'water'), and Bantu spirantization turned Proto-Bantu *t into s before the first-degree high vowel *i in Swahili and many other languages.",
  "phoneticEffects": "Assibilation, Spirantization, Palatalization",
  "languageExamples": [
    {
      "language": "Finnish",
      "languageFamily": "Uralic",
      "examples": [
        {
          "from": "vete [t]",
          "to": "vesi [s]",
          "note": "Historical assibilation of t before i."
        },
        {
          "from": "käte",
          "to": "käsi"
        }
      ]
    },
    {
      "language": "Proto-Bantu to Swahili",
      "languageFamily": "Bantu",
      "examples": [
        {
          "from": "*ìtíkʊ̀ 'day'",
          "to": "siku",
          "note": "Bantu spirantization: *t > s before the first-degree high vowel *i"
        },
        {
          "from": "*bʊ̀tíkʊ̀ 'night'",
          "to": "usiku"
        },
        {
          "from": "*mpítí 'hyena'",
          "to": "fisi",
          "note": "Both stops spirantize; cf. Zulu impisi"
        }
      ]
    },
    {
      "language": "Old High German",
      "languageFamily": "High German",
      "examples": [
        {
          "from": "Proto-West Germanic *etan 'to eat'",
          "to": "ëȥȥan"
        },
        {
          "from": "Proto-West Germanic *watar 'water'",
          "to": "waȥȥar"
        },
        {
          "from": "Proto-West Germanic *witan 'to know'",
          "to": "wiȥȥan"
        },
        {
          "from": "Proto-West Germanic *bītan 'to bite'",
          "to": "bīȥan"
        },
        {
          "from": "Proto-West Germanic *fōt 'foot'",
          "to": "fuoȥ"
        },
        {
          "from": "Proto-West Germanic *hwīt 'white'",
          "to": "wīȥ",
          "note": "After vowels *t became a voiceless sibilant fricative (written ȥȥ, ȥ or zz), distinct from inherited s until the two merged from the 13th century (German essen). Old Saxon keeps t (etan, watar, fōt)."
        }
      ]
    }
  ],
