      "languageFamily": "West Slavic",
      "examples": [
        {
          "from": "Proto-Slavic *svěťa 'candle'",
          "to": "svíce (Old Czech sviecě)",
          "note": "Compare Russian свеча svečá and Serbo-Croatian svijéća, which show the other reflexes of *ť."
        },
