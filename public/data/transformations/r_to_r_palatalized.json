{
  "fromId": "r",
  "toId": "r_palatalized",
  "preamble": "Palatalization of the alveolar trill [r] to [rʲ] before front vowels. In East Slavic and Bulgarian, Proto-Slavic *r became soft [rʲ] before the front vowels *ě and *ę, and the soft trill survives as a separate phoneme before back vowels (Russian рад [rat] 'glad' vs ряд [rʲat] 'row'). Lithuanian palatalizes the trill, like all its consonants, before front vowels.",
  "phoneticEffects": "Palatalization",
  "languageExamples": [
    {
      "language": "Russian",
      "languageFamily": "East Slavic",
      "examples": [
        {
          "from": "Proto-Slavic *rěka 'river'",
          "to": "река [rʲɪˈka]",
          "note": "The trill before the front vowel *ě became palatalized [rʲ], which now contrasts with plain /r/ (рад [rat] vs ряд [rʲat])."
        },
        {
          "from": "Proto-Slavic *rędъ 'row'",
          "to": "ряд [rʲat]",
          "note": "Palatalized before the front nasal vowel *ę, which later became [a]."
        }
      ]
    },
    {
      "language": "Ukrainian",
      "languageFamily": "East Slavic",
      "examples": [
        {
          "from": "Proto-Slavic *rędъ 'row'",
          "to": "ряд [rʲad]",
          "note": "Same palatalization before *ę; Ukrainian keeps the final voiced [d]."
        },
        {
          "from": "Proto-Slavic *rěpa 'turnip'",
          "to": "ріпа [ˈrʲipɐ]"
        }
      ]
    },
    {
      "language": "Bulgarian",
      "languageFamily": "South Slavic",
      "examples": [
        {
          "from": "Proto-Slavic *rěpa 'turnip'",
          "to": "ряпа [ˈrʲa̟pɐ]",
          "note": "Before the yat reflex [ʲa] the trill surfaces as palatalized [rʲ]; some analyses treat it as /r/ + /j/."
        },
        {
          "from": "Proto-Slavic *rědъkъ 'rare'",
          "to": "рядък [ˈrʲa̟dɐk]"
        }
      ]
    },
    {
      "language": "Lithuanian",
      "languageFamily": "Baltic",
      "examples": [
        {
          "from": "Proto-Balto-Slavic *retas 'sparse, rare'",
          "to": "retas [ˈrʲæːtɐs]",
          "note": "Consonants, including the apical trill, are palatalized before front vowels."
        },
        {
          "from": "/r/ before a back vowel, marked by orthographic i",
          "to": "noriu [ˈnôːrʲʊ] 'I want'",
          "note": "Palatalized [rʲ] also occurs before back vowels, where the spelling marks it with a silent i."
        }
      ]
    }
  ],
