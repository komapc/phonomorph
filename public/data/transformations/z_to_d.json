  "preamble": "Stopping of the voiced alveolar fricative [z] to [d] is rare as a regular change. The best-documented case is Southern and South Midland American English, where /z/ becomes [d] before a syllabic or unstressed /n/ (isn't, wasn't, business).",
  "phoneticEffects": "Stopping, Fortition, Assimilation",
  "languageExamples": [
    {
      "language": "Southern American English",
      "languageFamily": "West Germanic",
      "examples": [
        {
          "from": "isn't [ˈɪzn̩t]",
          "to": "idn't /ɪdnt/",
          "note": "Anticipation of the following nasal closure turns the sibilant into a stop; heard from speakers on all social levels in the South and South Midland."
        },
        {
          "from": "wasn't [ˈwʌzn̩t]",
          "to": "wadn't /wʌdn̩t/",
          "note": "Same conditioning: /z/ before syllabic /n/."
        },
        {
          "from": "business [ˈbɪznɪs]",
          "to": "bidness /ˈbɪd.nɪs/",
          "note": "/z/ before unstressed /n/."
        }
      ]
    },
    {
      "language": "Somali",
      "languageFamily": "Lowland East Cushitic",
      "examples": [
        {
          "from": "Proto-Somaloid *báz 'lake'",
          "to": "bad /ˈbɑ́d/ 'sea'"
        },
        {
          "from": "Proto-Somaloid *wéznè (Proto-Cushitic *wazn- 'heart')",
          "to": "wadne /ˈwɑ́dnɛ̀/ 'heart'"
        },
        {
          "from": "Proto-Somaloid *geiz 'tree'",
          "to": "geed /ˈɡêːd/ 'tree'",
          "note": "Sasse's correspondences give *z > d in Saho–Afar, Somali and Oromo; Rendille has a glide instead (bey, weyna, geey), while Arbore and northern Saho keep /z/."
        }
      ]
    }
