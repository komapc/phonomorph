{
  "fromId": "sh_retroflex",
  "toId": "sh",
  "preamble": "The voiceless retroflex fricative [ʂ] loses its retroflexion and becomes the postalveolar [ʃ]. The clearest cases are Indo-Aryan: Sanskrit ṣ [ʂ] is pronounced [ʃ] in Hindi, Bengali (where it merged with ś), Punjabi and Gujarati. Outside Indo-Aryan, Proto-Quechuan *ʂ became [ʃ] across Quechua I and in several Quechua II varieties. Southern and Taiwan Mandarin deretroflexion goes to [s], not [ʃ] (see sh_retroflex_to_s).",
  "phoneticEffects": "Deretroflexion, Merger",
  "languageExamples": [
    {
      "language": "Hindi",
      "languageFamily": "Indo-Aryan",
      "examples": [
        {
          "from": "Sanskrit भाषा bhāṣā /bʱɑː.ʂɑː/ 'language'",
          "to": "Hindi भाषा [bʱäː.ʃäː]",
          "note": "Phonemically /ʂ/ in careful Sanskritized speech, realized [ʃ] in ordinary Hindi."
        },
        {
          "from": "Sanskrit विष viṣa /ʋi.ʂɐ/ 'poison'",
          "to": "Hindi विष [ʋɪʃ]"
        },
