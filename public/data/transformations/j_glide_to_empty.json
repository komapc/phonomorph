    {
      "language": "Latin",
      "languageFamily": "Italic",
      "examples": [
        {
          "from": "PIE *monéyeti 'causes to think'",
          "to": "moneō 'I warn, remind'",
          "note": "Causative *-éye- lost its intervocalic *y in Proto-Italic (*moneō)."
        },
        {
          "from": "PIE *tréyes 'three'",
          "to": "trēs",
          "note": "Loss of *y followed by contraction (Proto-Italic *trēs)."
