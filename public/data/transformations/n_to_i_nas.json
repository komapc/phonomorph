  "preamble": "A coda nasal [n] after a front vowel can be lost while its nasality passes onto the vowel, so the result is a nasalized [ĩ]. In the vernacular layer of Southern Min (Hokkien), Middle Chinese -en and -jen rhymes give -ĩ, while the literary readings keep the coda. In Portuguese, Latin and Old Galician-Portuguese -in lost its final nasal consonant, giving modern [ĩ], spelled -im.",
  "phoneticEffects": "Nasalization, Coda Loss",
  "languageExamples": [
    {
      "language": "Southern Min (Hokkien)",
      "languageFamily": "Min",
      "examples": [
        {
          "from": "天 MC then",
          "to": "thiⁿ [tʰĩ] 'sky, heaven' (vernacular)",
          "note": "The literary reading keeps the coda: thian [tʰiɛn]."
        },
        {
          "from": "錢 MC dzjen",
          "to": "chîⁿ [t͡sĩ] 'money' (vernacular)",
          "note": "Literary reading chiân [t͡siɛn]."
        }
      ]
    },
    {
      "language": "Portuguese",
      "languageFamily": "Ibero-Romance",
      "examples": [
        {
          "from": "Old Galician-Portuguese fin (< Latin finis)",
          "to": "fim [ˈfĩ] 'end'",
          "note": "The coda nasal consonant is lost and the vowel is phonemically nasal."
        },
        {
          "from": "Old Galician-Portuguese latin",
          "to": "latim [lɐˈtĩ] (EP), [laˈt͡ʃĩ] (BP) 'Latin'"
        }
      ]
    }
  ],
