  "preamble": "Devoicing of the labialized voiced velar [gʷ] to [kʷ] keeps the lip rounding and velar place while losing voicing. It is the labiovelar part of Grimm's law: Proto-Indo-European *gʷ became Proto-Germanic *kw /kʷ/, still written as a single letter in Gothic (𐌵, transliterated q) and as cw in Old English.",
  "phoneticEffects": "Devoicing, Grimm's Law",
  "languageExamples": [
    {
      "language": "Proto-Germanic",
      "languageFamily": "Germanic",
      "examples": [
        {
          "from": "PIE *gʷih₃wós 'alive'",
          "to": "*kwikwaz /ˈkʷi.kʷɑz/ (Gothic qius, Old English cwic)",
          "note": "Latin vīvus and Greek βίος show other reflexes of the same labiovelar."
        },
        {
          "from": "PIE *gʷḗn 'woman'",
          "to": "*kwenǭ /ˈkʷe.nɔ̃ː/ (Gothic qinō, Old English cwene)"
        },
        {
          "from": "PIE *gʷem- 'to go, come'",
          "to": "*kwemaną /ˈkʷe.mɑ.nɑ̃/ 'to come' (Gothic qiman)"
        }
      ]
    }
  ],
