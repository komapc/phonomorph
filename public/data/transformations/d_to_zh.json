      "language": "French",
      "languageFamily": "Gallo-Romance",
      "examples": [
        {
          "from": "Latin diurnum '(of the) day'",
          "to": "jour [ʒuʁ] 'day'",
          "note": "Latin /dj/ became Old French [dʒ], which deaffricated to [ʒ] in Middle French."
        }
      ]
    },
