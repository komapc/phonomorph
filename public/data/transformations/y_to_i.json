{
  "fromId": "y",
  "toId": "i",
  "preamble": "The shift from the close front rounded vowel [y] to its unrounded counterpart [i] (unrounding). Front rounded vowels are often lost by merger with their unrounded equivalents: Old English y unrounded in Middle English, Greek upsilon merged with iota (part of iotacism), and Yiddish unrounded the Middle High German front rounded vowels.",
  "phoneticEffects": "Unrounding, Merger",
  "languageExamples": [
    {
      "language": "English",
      "languageFamily": "West Germanic",
      "examples": [
        {
          "from": "Old English mȳs [yː] 'mice'",
          "to": "Middle English mys [iː] (Modern mice)",
          "note": "The front rounded vowels of Old English (from i-mutation) unrounded in most of Middle English."
        },
        {
          "from": "Old English cynn [y] 'kind, race'",
          "to": "Middle English kyn, Modern kin [ɪ]",
          "note": "Short y likewise unrounded."
        }
      ]
    },
    {
      "language": "Greek",
      "languageFamily": "Hellenic",
      "examples": [
        {
          "from": "ψυχή, 4th–10th c. CE /psyˈçi/ 'soul'",
          "to": "15th c. and Modern Greek /psiˈçi/",
          "note": "Upsilon, originally /y/, merged with iota /i/."
        },
        {
          "from": "λύκος /ˈly.kos/ 'wolf' (4th–10th c. CE)",
          "to": "Modern Greek /ˈlikos/"
        },
        {
          "from": "ξύλον /ˈksy.lon/ 'wood' (4th–10th c. CE)",
          "to": "Modern Greek ξύλο /ˈksilo/",
          "note": "Old Athenian kept a back vowel: ξούλο /ˈksulo/."
        },
        {
          "from": "μῦς /ˈmys/ 'mouse, muscle' (4th c. CE)",
          "to": "/ˈmis/ (15th c.)"
        }
      ]
    },
    {
      "language": "Yiddish",
      "languageFamily": "West Germanic",
      "examples": [
        {
          "from": "Middle High German grüene [y] 'green'",
          "to": "גרין grin /ɡʁin/ (Southeastern)",
          "note": "Yiddish unrounded the front rounded vowels inherited from Middle High German."
        }
      ]
    }
  ],
