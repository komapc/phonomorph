    {
      "language": "Turkish",
      "languageFamily": "Oghuz",
      "examples": [
        {
          "from": "Ottoman Turkish طاغ (dağ) 'mountain', with consonantal ğ [ɣ]",
          "to": "dağ [daː]",
          "note": "Final /ɣ/ was lost with compensatory lengthening of the vowel."
        },
        {
          "from": "Ottoman Turkish صوغوق (soğuk) 'cold', with consonantal ğ [ɣ]",
          "to": "soğuk [soˈuk]",
          "note": "Intervocalic /ɣ/ is silent, leaving a hiatus."
        }
      ]
    },
