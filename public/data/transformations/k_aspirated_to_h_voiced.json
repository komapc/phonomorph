{
  "fromId": "k_aspirated",
  "toId": "h_voiced",
  "preamble": "Debuccalization of the aspirated velar stop [kʰ] removes the oral closure, and between vowels the remnant is the voiced glottal fricative [ɦ]. In Maharashtri Prakrit every single intervocalic aspirated stop, kh included, was reduced to h, the voiced [ɦ] that continues Sanskrit h (Sanskrit mukha > Prakrit muha > Hindi mũh).",
  "phoneticEffects": "Debuccalization, Lenition, Voicing",
  "languageExamples": [
    {
      "language": "Maharashtri Prakrit",
      "languageFamily": "Indo-Aryan",
      "examples": [
        {
          "from": "Sanskrit múkha 'mouth'",
          "to": "Prakrit muha (> Hindi mũh)",
          "note": "Intervocalic aspirated stops lost their oral closure and left h; Hindi mukh is a later tatsama borrowing."
        },
        {
          "from": "Sanskrit sukhá 'happiness'",
          "to": "Prakrit suha"
        },
        {
          "from": "Sanskrit nakhá 'nail'",
          "to": "Prakrit ṇaha"
        }
      ]
    }
  ],
