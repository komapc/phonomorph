      "language": "Latin",
      "languageFamily": "Italic",
      "examples": [
        {
          "from": "PIE *widtós",
          "to": "vīsus",
          "note": "'seen', participle of videō; via Proto-Italic *wissos, with -ss- simplified after the long vowel."
        },
        {
          "from": "ad- + sedeō",
          "to": "assideō",
          "note": "'sit by, attend'; prefix /d/ totally assimilated to the following /s/."
        }
      ]
    },
    {
