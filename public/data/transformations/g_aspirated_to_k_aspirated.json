{
  "fromId": "g_aspirated",
  "toId": "k_aspirated",
  "preamble": "Devoicing of the voiced aspirated (breathy) velar stop to a voiceless aspirated stop. It is a defining sound law of Greek, where PIE *gʰ and *ǵʰ became χ [kʰ], and it recurs independently in Romani, which devoiced the Old Indo-Aryan voiced aspirates bʰ, dʰ, gʰ to pʰ, tʰ, kʰ.",
  "phoneticEffects": "Devoicing",
  "languageExamples": [
    {
      "language": "Ancient Greek",
      "languageFamily": "Hellenic",
      "examples": [
        {
          "from": "PIE *ǵʰh₂éns",
          "to": "χήν khḗn (goose)",
          "note": "Proto-Hellenic *kʰā́n; Mycenaean ka-no"
        },
        {
          "from": "PIE *ǵʰéyōm",
          "to": "χιών khiṓn (snow)",
          "note": "Proto-Hellenic *kʰiṓn"
        },
        {
          "from": "PIE *leyǵʰ-",
          "to": "λείχω leíkhō (lick)",
          "note": "Proto-Hellenic *léikʰō"
        },
        {
          "from": "PIE *steygʰ-",
          "to": "στείχω steíkhō (walk, march)",
          "note": "Plain velar *gʰ also gives χ"
        },
        {
          "from": "PIE *seǵʰ-",
          "to": "ἔχω ékhō (have, hold)",
          "note": "Proto-Hellenic *hékʰō"
        }
      ]
    },
    {
      "language": "Romani",
      "languageFamily": "Indo-Aryan",
      "examples": [
        {
          "from": "Sanskrit gharmá, Prakrit ghamma 'heat'",
          "to": "kham 'sun'",
          "note": "Initial gʰ devoiced to kʰ as part of the Romani devoicing of the voiced aspirates bʰ, dʰ, gʰ"
        },
        {
          "from": "Sauraseni Prakrit ghara 'house' (metathesized from Sanskrit gṛhá)",
          "to": "kher 'house'"
        }
      ]
    }
  ],
