      "language": "Romani",
      "languageFamily": "Indo-Aryan",
      "examples": [
        {
          "from": "Sanskrit gharmá, Prakrit ghamma (heat)",
          "to": "kham (sun)",
          "note": "Initial gʰ devoiced to kʰ as part of the Romani devoicing of voiced aspirates"
        }
      ]
    }
  ],
