{
  "fromId": "j_affricate",
  "toId": "j_glide",
  "preamble": "Lenition of the voiced postalveolar affricate jīm [dʒ] to the palatal glide [j] is a classic feature of Gulf and Eastern Arabian dialects: Kuwaiti Arabic rayyāl 'man' (MSA rajul) and diyāy 'chickens' (MSA dajāj). The change is unconditioned and optional, and it never affects recent loans from Modern Standard Arabic.",
  "phoneticEffects": "Lenition, Deaffrication, Gliding",
  "languageExamples": [
    {
      "language": "Kuwaiti Arabic",
      "languageFamily": "Semitic",
      "examples": [
        {
          "from": "rajul 'man' (MSA)",
          "to": "rayyāl",
          "note": "Al-Qenaie (2011), Table 5.2."
        },
        {
          "from": "dajāj 'chickens' (MSA)",
          "to": "diyāy",
          "note": "Both jīms become [j]."
        },
        {
          "from": "jūʿ 'hunger' (MSA)",
          "to": "yūʿ",
          "note": "Word-initial jīm becomes [j]."
        },
        {
          "from": "šajar 'trees' (MSA)",
          "to": "šiyar",
          "note": "Intervocalic jīm becomes [j]."
        }
      ]
    },
    {
      "language": "Gulf Arabic",
      "languageFamily": "Semitic",
      "examples": [
        {
          "from": "masjid [ˈmɒsd͡ʒɪd] 'mosque'",
          "to": "masyid [ˈmɒsjɪd]",
          "note": "[j] is a contemporary reflex of historical /dʒ/; both variants occur."
        },
        {
          "from": "mōj [moːd͡ʒ] 'wave'",
          "to": "mōy [moːj]",
          "note": "Word-final jīm becomes [j]."
        }
      ]
    }
  ],
  "certainty": 5,
  "commonality": 2,
  "sources": [
