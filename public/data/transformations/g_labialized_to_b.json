{
  "fromId": "g_labialized",
  "toId": "b",
  "preamble": "The labialized voiced velar stop [gʷ] becomes the bilabial stop [b] when the velar closure is lost and the lip rounding is strengthened into full bilabial closure. Proto-Indo-European *gʷ gave b in Greek (Mycenaean still writes the labiovelar, as in gʷōns 'cows'), in Proto-Celtic and in Osco-Umbrian, e.g. PIE *gʷṓws 'cow' > Greek βοῦς, Umbrian bum, while Latin turned the same sound into v (vīvus beside Oscan bivus).",
  "phoneticEffects": "Bilabialization, Merger",
  "languageExamples": [
    {
      "language": "Ancient Greek (from Proto-Greek)",
      "languageFamily": "Hellenic",
      "examples": [
        {
          "from": "Proto-Greek *gʷous 'cow, ox' (< PIE *gʷṓws; Mycenaean gʷōns)",
          "to": "βοῦς boûs"
        },
        {
          "from": "Proto-Greek *gʷarus 'heavy' (< PIE *gʷréh₂us)",
          "to": "βαρύς barús",
          "note": "Compare Latin gravis and Sanskrit gurú, which keep a velar."
        }
      ]
    },
    {
      "language": "Proto-Celtic (from Proto-Indo-European)",
      "languageFamily": "Celtic",
      "examples": [
        {
          "from": "PIE *gʷih₃wós 'alive'",
          "to": "Proto-Celtic *biwos (Old Irish béo)"
        },
        {
          "from": "PIE *gʷḗn 'woman'",
          "to": "Proto-Celtic *ben, *benā (Old Irish ben, Gaulish bena)"
        }
      ]
    },
    {
      "language": "Osco-Umbrian (from Proto-Italic)",
      "languageFamily": "Osco-Umbrian",
      "examples": [
        {
          "from": "Proto-Italic *gʷīwos 'alive' (< PIE *gʷih₃wós)",
          "to": "Oscan bivus (masc. nom. pl.)",
          "note": "Latin vīvus shows the Latin outcome v of the same labiovelar."
        },
        {
          "from": "Proto-Italic *gʷōs 'cow, ox' (< PIE *gʷṓws)",
          "to": "Umbrian bum",
          "note": "Latin bōs, with b instead of native v, is a loan from Osco-Umbrian."
        }
      ]
    }
  ],
