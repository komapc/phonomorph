{
  "fromId": "k_labialized",
  "toId": "g_labialized",
  "preamble": "The labialized voiceless velar stop [kʷ] is voiced to [ɡʷ] between vowels. This is part of Western Romance intervocalic lenition, which voiced Latin intervocalic voiceless stops: Latin qu [kʷ] in aqua and equa became the gu [ɡw] of Portuguese água, égua and Spanish agua, yegua, while Italian kept the voiceless stop (acqua).",
  "phoneticEffects": "Intervocalic Voicing, Lenition",
  "languageExamples": [
    {
      "language": "Latin to Portuguese",
      "languageFamily": "Ibero-Romance",
      "examples": [
        {
          "from": "Latin aqua [ˈa.kʷa] 'water'",
          "to": "Portuguese água /ˈa.ɡwɐ/"
        },
        {
          "from": "Latin equa [ˈɛ.kʷa] 'mare'",
          "to": "Portuguese égua /ˈɛ.ɡwɐ/",
          "note": "European Portuguese realizes the stop as [ɣ] between vowels ([ˈa.ɣwɐ]); Brazilian Portuguese keeps [ɡ]."
        }
      ]
    },
    {
      "language": "Latin to Spanish",
      "languageFamily": "Ibero-Romance",
      "examples": [
        {
          "from": "Latin aqua [ˈa.kʷa] 'water'",
          "to": "Spanish agua /ˈaɡwa/ [ˈa.ɣ̞wa]"
        },
        {
          "from": "Latin equa [ˈɛ.kʷa] 'mare'",
          "to": "Spanish yegua /ˈʝeɡwa/ [ˈɟ͡ʝe.ɣ̞wa]",
          "note": "Spanish /ɡ/ is realized as the approximant [ɣ̞] between vowels."
        }
      ]
    }
  ],
