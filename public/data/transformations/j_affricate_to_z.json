{
  "languageExamples": [
    {
      "language": "Assamese",
      "languageFamily": "Indo-Aryan",
      "examples": [
        {
          "from": "Bengali জল /d͡ʒɔl/ 'water' (cognate; both from Prakrit jala)",
          "to": "জল /zɔl/",
          "note": "Assamese has no postalveolar affricates; the letter জ is /z/."
        },
        {
          "from": "Early Assamese জুই jui 'fire' (cf. Bengali জুঁই jũi)",
          "to": "জুই /zui/",
          "note": "From Prakrit joi, Sanskrit jyótis 'light'."
        }
      ]
    },
    {
      "language": "Sylheti",
      "languageFamily": "Indo-Aryan",
      "examples": [
        {
          "from": "Standard Bengali জাতি jati 'race, kind' (in মানবজাতি 'mankind')",
          "to": "ꠝꠣꠘꠥꠎꠣꠔ manuzat 'mankind'",
          "note": "Sylheti spirantized the postalveolar affricates to alveolar fricatives (tʃ → s, dʒ → z)."
        }
      ]
    },
    {
      "language": "Proto-Mongolic to Buryat",
      "languageFamily": "Central Mongolic",
      "examples": [
        {
          "from": "*ǰaxun 'hundred'",
          "to": "зуун zuun"
        },
        {
          "from": "*ǰerge 'row, rank'",
          "to": "зэргэ zerge"
        },
        {
          "from": "*ǰirüken 'heart'",
          "to": "зүрхэн zürkhen"
        },
        {
          "from": "*ǰuǰaxan 'thick'",
          "to": "зузаан zuzaan",
          "note": "Both affricates become z; the parallel voiceless *č became s. Before *i the outcome is ж instead (*ǰïda > жада)."
        }
      ]
    }
  ],
