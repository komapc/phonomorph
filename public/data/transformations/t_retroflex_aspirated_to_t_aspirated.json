{
  "fromId": "t_retroflex_aspirated",
  "toId": "t_aspirated",
  "preamble": "De-retroflexion of the aspirated retroflex stop [ʈʰ] to the aspirated alveolar stop [tʰ] keeps the aspiration but moves the closure forward, removing the retroflex series. In Assamese the Indo-Aryan retroflex and dental stops merged into alveolars, so ঠ (ṭh) is pronounced /tʰ/ although the spelling keeps the old letter. Eastern (Dhaka and Vanga) Bengali dialects also fronted the retroflex stops to alveolars, while Western (Rarh) Bengali keeps [ʈʰ].",
  "phoneticEffects": "De-Retroflexion, Fronting, Merger",
  "languageExamples": [
    {
      "language": "Assamese",
      "languageFamily": "Eastern Indo-Aryan",
      "examples": [
        {
          "from": "Early Assamese ঠাৱ (ṭhawo)",
          "to": "ঠাই /tʰɑi/ 'place'",
          "note": "Cognate with Rarh Bengali ঠাঁই /ʈʰãi/, which keeps the retroflex."
        },
        {
          "from": "Hindi cognate पीठ /piːʈʰ/ 'back'",
          "to": "পিঠি /pi.tʰi/ 'back'",
          "note": "Both continue Prakrit piṭṭha; Assamese has the alveolar where Hindi keeps the retroflex."
        },
        {
          "from": "Hindi cognate काठ /kɑːʈʰ/ 'wood'",
          "to": "কাঠ /kɑtʰ/ 'wood'",
          "note": "Both continue Sanskrit kāṣṭha through Prakrit kaṭṭha."
        }
      ]
    },
    {
      "language": "Bengali (Eastern dialects)",
      "languageFamily": "Eastern Indo-Aryan",
      "examples": [
        {
          "from": "Rarh ঠিক /ʈʰik/ 'correct'",
          "to": "Dhaka /tʰik/",
          "note": "Western standard Bengali keeps the retroflex; Dhaka has the alveolar."
        },
        {
          "from": "Rarh ঠাঁই /ʈʰãi/ 'place'",
          "to": "Dhaka and Vanga /tʰai̯/"
        },
        {
          "from": "Rarh পিঠ /piʈʰ/ 'back'",
          "to": "Dhaka /pitʰ/"
        }
      ]
    }
  ],
