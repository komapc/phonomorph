  "preamble": "Nasal palatalization, the shift from the alveolar nasal [n] to the palatal nasal [ɲ], is triggered by a following palatal glide [j] or high front vowel. It is a hallmark of the development from Latin to the Romance languages (Latin nj > ɲ), an obligatory assimilation in Hungarian (n + j > [ɲː]), and an allophonic process in Japanese, where /n/ before /i/ or /j/ is realized as a prepalatal [ɲ].",
  "phoneticEffects": "Palatalization, Assimilation, Fronting",
  "languageExamples": [
    {
      "language": "Spanish",
      "languageFamily": "Ibero-Romance",
      "examples": [
        {
          "from": "Latin vīnea [nj] 'vineyard'",
          "to": "viña [ˈbiɲa]",
          "note": "Via Old Spanish vinna; the cluster nj became the palatal nasal ñ."
        },
        {
          "from": "Latin seniōrem, Vulgar Latin *senjor 'elder'",
          "to": "señor [seˈɲoɾ] 'lord, sir'",
          "note": "Via Old Spanish sennor."
        }
      ]
    },
    {
      "language": "Hungarian",
      "languageFamily": "Ugric",
      "examples": [
        {
          "from": "unja /unjɒ/ 's/he is bored with it'",
          "to": "[uɲːɒ]",
          "note": "Full palatal assimilation of n before j is obligatory in standard Hungarian, giving a long palatal nasal."
        },
        {
          "from": "pinty 'finch' (/n/ before palatal /c/)",
          "to": "[piɲc]"
        }
      ],
      "isAllophone": true
    },
    {
      "language": "Japanese",
      "languageFamily": "Japonic",
      "examples": [
        {
          "from": "/ni/, /nj/ (e.g. に ni)",
          "to": "[ɲi], [ɲ]",
          "note": "Allophonic: /n/ before /i/ or /j/ is lamino-alveolopalatal or prepalatal, transcribed broadly as [ɲ]."
        },
        {
          "from": "/nja/",
          "to": "[ɲa]"
        },
        {
          "from": "日 /niti/ 'day'",
          "to": "[ɲitɕi]"
        }
      ],
      "isAllophone": true
    },
    {
      "language": "North Slope Iñupiaq",
      "languageFamily": "Inuit",
      "examples": [
        {
          "from": "Proto-Inuit *inuɣ 'person'",
          "to": "iñuk",
          "note": "Alveolar n became palatal ñ /ɲ/ after a 'strong' i; Northwest Alaska Iñupiaq and the other Inuit varieties keep inuk."
        },
        {
          "from": "Proto-Inuit *iʀnəq 'son'",
          "to": "iġñiq",
          "note": "Inuinnaqtun and Inuktitut keep irniq."
        }
      ]
    }
  ],
