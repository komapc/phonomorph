  "preamble": "The shift from the bilabial nasal [m] to the voiced bilabial stop [b] is a process known as denasalization or stop-burst. It occurs when the velum (soft palate) is raised, blocking airflow through the nose and forcing the sound to be released entirely through the mouth.",
  "phoneticEffects": "Denasalization, Fortition, Domain-Initial Strengthening",
  "languageExamples": [
    {
      "language": "Modern Korean (Seoul Dialect)",
      "languageFamily": "Koreanic",
      "examples": [
        {
          "from": "mul [m] (water)",
          "to": "[bul] / [m͊ul]",
          "note": "Word-initial nasals in Korean are frequently denasalized, sounding like voiced stops to many listeners."
        },
        {
          "from": "meori (head)",
          "to": "[bʌɾi]"
        }
      ]
    },
    {
      "language": "Southern Min (Hokkien)",
      "languageFamily": "Sinitic",
      "examples": [
        {
          "from": "米 MC mejX [m]",
          "to": "bí [bi]",
          "note": "In Southern Min nasal initials became voiced stops in syllables without nasal finals."
        },
        {
          "from": "麥 MC meak",
          "to": "beh [beʔ]"
        }
      ]
    },
    {
      "language": "Proto-Salish to Lushootseed",
      "languageFamily": "Salishan",
      "examples": [
        {
          "from": "*mus 'four'",
          "to": "buus",
          "note": "Puget Sound denasalization: *m > b, *n > d"
        },
        {
          "from": "*s-məqʼʷ-aʔ 'heron'",
          "to": "sbəq̓ʷaʔ"
        },
        {
          "from": "*s-mɣaw 'large predatory canine/feline'",
          "to": "sbiaw 'coyote'"
        }
      ]
    },
    {
      "language": "Samic (Western and Inari/Skolt)",
      "languageFamily": "Samic",
      "examples": [
        {
          "from": "Proto-Samic *δāmpë 'reindeer shinbone'",
          "to": "Northern Sami dábba, Inari Sami tabbâ, Skolt Sami tabb",
          "note": "Denasalization of nasal + homorganic stop (*mp > bb); Kildin Sami (tɑ̄m̄ᵇp) and Ter Sami (та̄ммп) keep the nasal."
        },
        {
          "from": "Proto-Samic *čimpē",
          "to": "Northern Sami čibbi, Lule Sami tjibbe, Skolt Sami čeʹbb",
          "note": "Kildin чӣммьп keeps the nasal."
        },
        {
          "from": "Proto-Samic *ompë 'whole, closed' (< Proto-Germanic *umbi)",
          "to": "Lule Sami åbbå, South Sami åbbe, Inari Sami ubbâ",
          "note": "Kildin о̄ммп keeps the nasal; compare the Finnic cognate Finnish umpi."
        }
      ]
    }
