      "languageFamily": "Indo-Aryan",
      "examples": [
        {
          "from": "Sanskrit cōrá 'thief'",
          "to": "चोर cor [tsor]",
          "note": "The Nepali reflexes of the Old Indo-Aryan palatal affricates are alveolar affricates: च [ts], छ [tsʰ], ज [dz], झ [dzʱ]."
        },
        {
          "from": "Sanskrit catvā́raḥ 'four'",
          "to": "चार cār [tsar]",
          "note": "Spelled with the palatal letter च but pronounced with [ts]."
        }
      ]
    },
