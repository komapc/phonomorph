      "examples": [
        {
          "from": "invierno /inˈbjeɾno/ 'winter'",
          "to": "[imˈbjeɾno]",
          "note": "Syllable-final nasals take the place of the following consonant, also across word boundaries."
        }
      ]
    },
    {
      "language": "Modern Greek",
