{
  "fromId": "l",
  "toId": "w",
  "preamble": "L-vocalization replaces a lateral, usually the velarized 'dark' [ɫ], with the labio-velar glide [w], keeping the back-of-tongue raising and lip rounding while losing lateral contact. It went to completion in Polish and Sorbian, where almost all historical /ɫ/ became /w/ in every position; in Ukrainian and Belarusian it affected syllable codas; and most Brazilian Portuguese dialects vocalize coda /l/.",
  "phoneticEffects": "L-Vocalization, Delateralization",
  "languageExamples": [
    {
      "language": "Polish",
      "languageFamily": "West Slavic",
      "examples": [
        {
          "from": "Middle Polish mały /ˈma.ɫɨ/ 'small'",
          "to": "mały /ˈma.wɘ/"
        },
        {
          "from": "Middle Polish biały /bjɒ.ɫɨ/ 'white'",
          "to": "biały /ˈbja.wɘ/",
          "note": "Almost all historical /ɫ/ (spelled ł) became /w/, even word-initially and between vowels; the same happened in Sorbian."
        }
      ]
    },
    {
      "language": "Ukrainian",
      "languageFamily": "East Slavic",
      "examples": [
        {
          "from": "Old East Slavic вълкъ (Proto-Slavic *vьlkъ) 'wolf'",
          "to": "вовк [wɔu̯k]"
        },
        {
          "from": "Proto-Slavic *stъlpъ 'pillar'",
          "to": "стовп [stɔu̯p]",
          "note": "Coda /ɫ/ became [w], written ⟨в⟩; Belarusian shows the same change in воўк [vowk], written ⟨ў⟩."
        }
      ]
    },
    {
      "language": "Brazilian Portuguese",
      "languageFamily": "Ibero-Romance",
      "examples": [
        {
          "from": "mal 'poorly' (coda /l/)",
          "to": "[ˈmaw], homophonous with mau 'bad'",
          "note": "Coda /l/ is vocalized to a back glide in most Brazilian dialects, while European Portuguese keeps a velarized [ɫ]."
        },
        {
          "from": "sol /ˈsɔl/ 'sun'",
          "to": "[ˈsɔʊ̯]"
        },
        {
          "from": "Brasil /bɾaˈzil/",
          "to": "[bɾaˈziʊ̯]"
        }
      ],
      "isAllophone": true,
      "context": "Syllable coda"
    }
