          "to": "ғалим [ʁɑˈlʲim] 'scientist'",
          "note": "Also [ɢɑˈlʲim]."
        },
        {
          "from": "Arabic عُمْر ʿumr 'life' [ʕ]",
          "to": "ғүмер [ʁɵˈmɪɾ] 'life, lifespan'"
        },
        {
          "from": "Arabic عَرَب ʿarab [ʕ]",
          "to": "ғәрәп [ʁæˈræp] 'Arab'",
          "note": "Also [ɢæˈræp]."
        }
