{
  "fromId": "d_palatalized",
  "toId": "j_glide",
  "preamble": "The palatalized stop [dʲ] weakening to the palatal glide [j]. In Irish this is the synchronic lenition mutation of slender d (historically via a fricative stage [ðʲ] > [ʝ] > [j]); in Slovene the Proto-Slavic palatalized reflex of *dj (written *ď) lost its closure entirely and became [j].",
  "phoneticEffects": "Lenition, Approximantization",
  "languageExamples": [
    {
      "language": "Irish",
      "languageFamily": "Goidelic",
      "examples": [
        {
          "from": "Dia /dʲiə/",
          "to": "a Dhia /ə jiə/",
          "note": "'God' → vocative 'O God'; lenition turns slender /dʲ/ into /j/, spelled ⟨dh⟩."
        },
        {
          "from": "deas /dʲasˠ/",
          "to": "bean dheas /jasˠ/",
          "note": "'nice, pretty' → 'a pretty woman'; adjective lenited after a feminine singular noun."
        }
      ]
    },
    {
      "language": "Slovene",
      "languageFamily": "South Slavic",
      "examples": [
        {
          "from": "Proto-Slavic *meďa",
          "to": "méja",
          "note": "'border, boundary'; contrast Serbo-Croatian mèđa, Russian межа́, OCS межда."
        },
        {
          "from": "Proto-Slavic *sàďa",
          "to": "sája",
          "note": "'soot'; contrast Serbo-Croatian sađa, Russian са́жа."
        }
      ]
    }
  ],
  "certainty": 4,
  "commonality": 3,
