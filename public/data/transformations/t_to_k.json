      "languageFamily": "Austronesian",
      "examples": [
        {
          "from": "*tapu [t] (Proto-Polynesian)",
          "to": "kapu [k] (taboo)",
          "note": "Hawaiian systematically shifted all historical [t] sounds to [k]."
        },
        {
          "from": "*tanata",
          "to": "kanaka"
        }
      ]
    },
    {
      "language": "Chaoshan (Southern Min)",
      "languageFamily": "Sino-Tibetan",
      "examples": [
        {
          "from": "historical *-t",
          "to": "*-k",
          "note": "Historical syllable-final alveolar stops shifted to velars after the vowel [a]."
        }
      ]
