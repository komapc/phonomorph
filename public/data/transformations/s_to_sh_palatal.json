      "examples": [
        {
          "from": "Proto-Slavic *sě̑no 'hay'",
          "to": "siano [ˈɕa.nɔ]",
          "note": "Proto-Slavic *s before a front vowel became the soft sibilant ś [ɕ]."
        },
        {
          "from": "Proto-Slavic *sestra 'sister'",
          "to": "siostra /ˈɕɔs.tra/"
        }
      ]
