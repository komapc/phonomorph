      "languageFamily": "Japonic",
      "examples": [
        {
          "from": "/sio/",
          "to": "塩 shio [ɕi.o] 'salt'",
          "note": "/s/ is realized as [ɕ] before /i/."
        },
        {
          "from": "/sita/",
          "to": "下 shita [ɕita] 'below'"
        }
      ],
      "isAllophone": true,
      "context": "Before /i/"
    },
    {
      "language": "Mandarin",
      "languageFamily": "Sinitic",
      "examples": [
        {
          "from": "西 MC sej 'west'",
          "to": "xī [ɕi]",
          "note": "Middle Chinese *s- before high front vowels merged with palatalized velars as [ɕ]."
        },
        {
          "from": "心 MC sim 'heart'",
          "to": "xīn [ɕin]"
        }
      ]
    },
    {
