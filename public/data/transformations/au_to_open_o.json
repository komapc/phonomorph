          "from": "Latin aurum 'gold'",
          "to": "oro /ˈɔ.ro/"
        },
        {
          "from": "Latin causa 'cause, thing'",
          "to": "cosa /ˈkɔ.za/, traditional /ˈkɔ.sa/ 'thing'"
        },
        {
          "from": "Latin paucus 'few, little'",
          "to": "poco /ˈpɔ.ko/"
        },
        {
          "from": "Latin taurus 'bull'",
          "to": "toro /ˈtɔ.ro/",
          "note": "The learned doublet tauro keeps the diphthong."
        }
      ]
    },
