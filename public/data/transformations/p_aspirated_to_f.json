  "preamble": "Spirantization of aspirated stops into fricatives is a well-documented historical process. A classic example is found in the early stages of Grimm's Law, where Proto-Indo-European *p evolved into *pʰ and subsequently into the voiceless labiodental fricative [f].",
  "phoneticEffects": "Spirantization",
  "languageExamples": [
    {
      "language": "Germanic (Grimm's Law)",
      "languageFamily": "Germanic",
      "examples": [
        {
          "from": "*p",
          "to": "f",
          "note": "PIE *pǝtēr > English father, through an intermediate aspirated stage *pʰ."
        }
      ]
    },
    {
      "language": "Latin",
      "languageFamily": "Italic",
      "examples": [
        {
          "from": "pʰ",
          "to": "f",
          "note": "Greek loanwords like 'philosophia' often shifted from [pʰ] to [f] in Latin (filosofia)."
        }
      ]
    },
    {
      "language": "Mandarin Chinese",
      "languageFamily": "Sinitic",
      "examples": [
        {
          "from": "Middle Chinese 芳 phjang 'fragrant'",
          "to": "fāng [faŋ]"
        },
        {
          "from": "Middle Chinese 敷 phju 'spread'",
          "to": "fū [fu]"
        },
        {
          "from": "Middle Chinese 峰 phjowng 'peak'",
          "to": "fēng [fɤŋ]"
        }
      ]
    }
  ],
