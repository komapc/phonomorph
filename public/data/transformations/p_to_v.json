{
  "fromId": "p",
  "toId": "v",
  "preamble": "The voiceless bilabial stop [p] becomes the voiced labiodental fricative [v], typically between vowels. Latin intervocalic p is continued by French v (sapōnem > savon, capra > chèvre), Proto-Uralic medial *p by Hungarian v (*kepä > kevés 'few'), Proto-Uto-Aztecan *p by Tohono O'odham /v/, and Sanskrit intervocalic p by Prakrit v (kūpa > kūva 'well').",
  "phoneticEffects": "Voicing, Spirantization, Lenition",
  "languageExamples": [
    {
      "language": "Latin to French",
      "languageFamily": "Romance",
      "examples": [
        {
          "from": "Latin sāpōnem 'soap'",
          "to": "French savon",
          "note": "Intervocalic lenition of the labial stop; Old French already has savon."
        },
        {
          "from": "Latin capra 'goat'",
          "to": "French chèvre (Old French chievre)"
        }
      ]
    },
    {
      "language": "Hungarian (word-internal)",
      "languageFamily": "Uralic",
      "examples": [
        {
          "from": "*kepä [p]",
          "to": "kevés \"few\""
        },
        {
          "from": "*čupa",
          "to": "sovány \"thin\""
        }
      ]
    },
    {
      "language": "Proto-Uto-Aztecan to Tohono O'odham",
      "languageFamily": "Tepiman",
      "examples": [
        {
          "from": "Proto-Uto-Aztecan *pusi 'eye'",
          "to": "O'odham vuhi 'eye'",
          "note": "O'odham ⟨v⟩ is the phoneme /v/, distinct from /w/; Northern Tepehuan has vúji."
        },
        {
          "from": "Proto-Uto-Aztecan *pa~pakaN 'reed' (reduplicated)",
          "to": "O'odham vapk",
          "note": "Northern Tepehuan vaapákai; Hopi paaqavi keeps *p."
        }
      ]
    },
    {
      "language": "Prakrit",
      "languageFamily": "Indo-Aryan",
      "examples": [
        {
          "from": "Sanskrit कूप kūpa 'well, pit'",
          "to": "Prakrit 𑀓𑀽𑀯 kūva",
          "note": "Continued in Hindi कुआँ kuā̃, Gujarati કૂવો kūvo, Nepali कुवा kuvā."
        },
        {
          "from": "Sanskrit पाप pāpa 'sin'",
          "to": "Sauraseni Prakrit 𑀧𑀸𑀯 pāva",
          "note": "Maharashtri has 𑀧𑀸𑀬 pāya with further loss of the consonant."
        }
      ]
    }
  ],
