  "preamble": "Loss of the laminal palatal stop *c (often written tj or j) at the start of a word is part of initial dropping in Australian Pama-Nyungan languages. Proto-Pama-Nyungan had no voicing contrast in stops, so *c also covers the sound that other sources write as *ɟ. The stop disappears in Arandic (Arrernte aleñe 'tongue' < *calañ), in Northern Paman (Mpalitjanh ipa 'liver' < *cipa) and in Southwestern Paman (Uw-Oykangand uwa+ 'woman's child' < *cuwa).",
  "phoneticEffects": "Elision, Initial Dropping",
  "languageExamples": [
    {
      "language": "Eastern and Central Arrernte",
      "languageFamily": "Arandic",
      "examples": [
        {
          "from": "Proto-Pama-Nyungan *calañ 'tongue'",
          "to": "aleñe 'tongue; way of speaking'",
          "note": "Kaytetye aleñe 'tongue' shows the same loss; Nhanda thalañu keeps the stop."
        },
        {
          "from": "Proto-Pama-Nyungan *ci:rni 'stick'",
          "to": "arne 'tree, bush; stick'",
          "note": "Western Arrernte irne 'tree; stick'."
        }
      ]
    },
    {
      "language": "Mpalitjanh",
      "languageFamily": "Northern Paman",
      "examples": [
        {
          "from": "Proto-Paman *cipa 'liver'",
          "to": "ipa 'liver'",
          "note": "Kuuk Thaayorre thi:p and Yidiny jiba keep the stop."
        }
      ]
    },
    {
      "language": "Uradhi",
      "languageFamily": "Northern Paman",
      "examples": [
        {
          "from": "Proto-Paman *cangkar- 'laugh'",
          "to": "angkarr(i)- 'laugh'",
          "note": "Atampaya and Angkamuthi angka:rri 'laugh'."
