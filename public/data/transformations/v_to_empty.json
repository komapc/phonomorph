          "to": "hed > head",
          "note": "Old English intervocalic f was voiced [v]; the [v] was lost in Middle English (variants heved, hed)."
        },
        {
          "from": "Middle English loverd, laford (< Old English hlāford 'lord')",
          "to": "lourde > lord (14th century)",
          "note": "The intervocalic consonant of loverd was dropped."
        }
