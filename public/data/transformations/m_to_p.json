      "languageFamily": "Germanic",
      "examples": [
        {
          "from": "æmtig (Old English) [m]",
          "to": "empty [mp]",
          "note": "Epenthesis: A voiceless stop developed between the nasal and the following voiceless consonant."
        }
      ]
    },
