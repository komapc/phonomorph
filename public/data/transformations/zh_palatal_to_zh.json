{
  "fromId": "zh_palatal",
  "toId": "zh",
  "preamble": "Retraction of the voiced alveolo-palatal fricative [ʑ] to the postalveolar [ʒ] is the Lithuanian outcome of the Balto-Slavic satem sibilant *ź, itself from PIE *ǵ and *ǵʰ. Lithuanian merged *ź with *ž, just as voiceless *ś merged with *š, so that Lithuanian ž corresponds to Slavic z (žiema : Proto-Slavic *zima 'winter', žirnis : *zьrno).",
  "phoneticEffects": "Depalatalization, Retraction, Merger",
  "languageExamples": [
    {
      "language": "Lithuanian",
      "languageFamily": "East Baltic",
      "examples": [
        {
          "from": "Proto-Balto-Slavic *źināˀtei 'to know'",
          "to": "žinoti"
        },
        {
          "from": "Proto-Balto-Slavic *źeimā́ˀ 'winter'",
          "to": "žiema"
        },
        {
          "from": "Proto-Balto-Slavic *źírˀnan 'grain'",
          "to": "žirnis 'pea' (via Proto-Baltic *žírˀnjas)"
        },
        {
          "from": "Proto-Balto-Slavic *źénˀtas 'son-in-law'",
          "to": "žentas"
        },
        {
          "from": "Proto-Balto-Slavic *źansís 'goose'",
          "to": "žąsis",
          "note": "The Slavic cognates have z (*zьrno, *zętь); Lithuanian ž is [ʒ]."
        }
      ]
    }
  ],
