{
  "fromId": "schwa",
  "toId": "empty",
  "preamble": "The loss of the neutral central vowel /ə/, typically in unstressed syllables (syncope) or word-finally (apocope). Late Middle English lost final -e (name /ˈnaːmə/ > /naːm/), French optionally drops e muet (petit > p'tit), and Hindi deletes the inherited schwa of Sanskrit words (racanā > rachnā).",
  "phoneticEffects": "Syncope, Apocope, Elision",
  "languageExamples": [
    {
      "language": "English",
      "languageFamily": "West Germanic",
      "examples": [
        {
          "from": "Middle English name /ˈnaːm(ə)/ 'name'",
          "to": "/ˈnaːm/ (Modern English /neɪm/)",
          "note": "Final unstressed -e /ə/ was lost in late Middle English; the vowel change to /eɪ/ is the separate Great Vowel Shift."
        },
        {
          "from": "Middle English tyme /ˈtiːm(ə)/ 'time'",
          "to": "/tiːm/ (Modern English /taɪm/)"
        }
      ]
    },
    {
      "language": "French",
      "languageFamily": "Gallo-Romance",
      "examples": [
        {
          "from": "petit /pə.ti/ 'small'",
          "to": "/p.ti/",
          "note": "Deletion of e muet (schwa) in the initial syllable; often written p'tit in familiar speech."
        },
        {
          "from": "fenêtre /fə.nɛtʁ/ 'window'",
          "to": "/fnɛtʁ/"
        },
        {
          "from": "cheval /ʃə.val/ 'horse'",
          "to": "/ʃval/"
        }
      ],
      "isAllophone": true
    },
    {
      "language": "Hindi",
      "languageFamily": "Indo-Aryan",
      "examples": [
        {
          "from": "रचना, Sanskrit racanā",
          "to": "Hindi rachnā /rətʃnɑː/",
          "note": "The inherent schwa is deleted medially and word-finally; likewise नमकीन is pronounced namkīn."
        },
        {
          "from": "वेद, Sanskrit veda",
          "to": "Hindi vēd"
        }
      ]
    }
  ],
