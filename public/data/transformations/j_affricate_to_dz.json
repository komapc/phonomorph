          "to": "आज /ad͡z/"
        },
        {
          "from": "Maharashtri Prakrit 𑀚𑀟 jaḍa (Sanskrit jaḍa 'cold, stiff, dull')",
          "to": "जड /d͡zəɖ/ 'heavy'"
        },
        {
          "from": "Maharashtri Prakrit 𑀚𑀸𑀡𑀇 jāṇaï 'knows' (Sanskrit jānāti)",
          "to": "जाणणे /d͡zaɳ.ɳe/ 'to know'"
        }
