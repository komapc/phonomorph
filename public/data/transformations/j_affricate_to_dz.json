        {
          "from": "Hindi आज /ɑːd͡ʒ/ 'today'",
          "to": "आज /ad͡z/",
          "note": "Marathi ज is /d͡z/ before non-front vowels and /d͡ʑ/ elsewhere."
        },
        {
          "from": "Hindustani जड़ jaṛ (cognate, with [dʒ])",
          "to": "जड /d͡zəɖ/ 'heavy'",
          "note": "Inherited from Old Marathi jaḍa; Konkani has the same [d͡zəɖ]."
        }
      ]
    },
    {
      "language": "Modern Greek",
      "languageFamily": "Hellenic",
      "examples": [
        {
          "from": "Ottoman Turkish جامع (camiʼ), Turkish cami /dʒaːˈmi/ 'mosque'",
          "to": "τζαμί /d͡zaˈmi/",
          "note": "Loanword adaptation; Greek has no native /dʒ/ and substitutes /dz/."
        },
        {
          "from": "Ottoman Turkish جام (cam) 'glass'",
          "to": "τζάμι /ˈd͡za.mi/ 'windowpane'",
          "note": "Loanword adaptation of Turkish [dʒ] as /dz/."
        }
