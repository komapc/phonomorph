          "from": "Proto-Slavic *sъnъ 'sleep, dream' (Old Church Slavonic сънъ sŭnŭ)",
          "to": "сън [sɤn]"
        },
        {
          "from": "Proto-Slavic *mъxъ 'moss' (Old Church Slavonic мъхъ mŭxŭ)",
