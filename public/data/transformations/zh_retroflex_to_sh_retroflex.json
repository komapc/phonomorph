  "preamble": "The voiced retroflex fricative /ʐ/ is devoiced to [ʂ] in languages with final obstruent devoicing and voicing assimilation that also have retroflex sibilants. Polish ż/rz and Russian and Belarusian ж (all transcribed as retroflex [ʐ] in current IPA practice) surface as [ʂ] word-finally before a pause and next to voiceless obstruents, so the voicing contrast is neutralized there.",
  "phoneticEffects": "Devoicing, Final Devoicing, Neutralization",
  "languageExamples": [
    {
      "language": "Polish",
      "languageFamily": "West Slavic",
      "isAllophone": true,
      "examples": [
        {
          "from": "lekarza /lɛˈka.ʐa/ 'physician (gen. sg.)'",
          "to": "lekarz /ˈlɛ.kaʂ/ 'physician'",
          "note": "Word-final rz is devoiced."
        },
        {
          "from": "rz (Middle Polish /r̝/ > /ʐ/)",
          "to": "przy /ˈpʂɘ/ 'at, by'",
          "note": "After a voiceless stop, rz is devoiced by progressive assimilation."
        }
      ]
    },
    {
      "language": "Russian",
      "languageFamily": "East Slavic",
      "isAllophone": true,
      "examples": [
        {
          "from": "му́жа (múža) 'husband (gen. sg.)'",
          "to": "муж [muʂ] 'husband'",
          "note": "Word-final ж is devoiced."
        },
        {
          "from": "ножа́ (nožá) 'knife (gen. sg.)'",
          "to": "нож [noʂ] 'knife'",
          "note": "Word-final ж is devoiced."
        }
      ]
    },
    {
      "language": "Belarusian",
      "languageFamily": "East Slavic",
      "isAllophone": true,
      "examples": [
        {
          "from": "нажа́ (nažá) 'knife (gen. sg.)'",
          "to": "нож [noʂ] 'knife'",
          "note": "Belarusian also devoices word-final ж."
        }
      ]
    }
  ],
