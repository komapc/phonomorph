  "fromId": "o",
  "toId": "a",
  "preamble": "Lowering and unrounding of [o] to [a] is one of the defining mergers of several Indo-European branches: PIE short *o fell together with *a in Germanic, Indo-Iranian and Albanian (PIE *nókʷts 'night' > Gothic nahts, Albanian natë; PIE *pótis > Sanskrit páti-). East Slavic akanye turns unstressed /o/ into [a] (Belarusian вада [vaˈda] 'water'), and Proto-Northern-Iroquoian independently lowered Proto-Iroquoian *o to *a.",
  "phoneticEffects": "Lowering, Unrounding",
  "languageExamples": [
    {
      "language": "Proto-Indo-European to Albanian",
      "languageFamily": "Albanian",
      "examples": [
        {
          "from": "*nókʷts 'night'",
          "to": "natë (Proto-Albanian *naktā)",
          "note": "PIE short *o merged with *a in Albanian, as in Germanic and Indo-Iranian; cf. Latin nox"
        }
      ]
    },
    {
      "language": "Proto-Iroquoian to Proto-Northern-Iroquoian",
      "languageFamily": "Iroquoian",
      "examples": [
        {
          "from": "*-wohst 'to be good'",
          "to": "*-wahstih",
          "note": "PI *o > Northern Iroquoian *a; Cherokee keeps o (ᎣᏍᏓ osda)"
        },
        {
          "from": "*koːhkaːʔ 'crow'",
          "to": "*kahkaːʔ",
          "note": "cf. Cherokee ᎪᎦ koga"
        },
        {
          "from": "*-tsjoːɹ- 'tobacco'",
          "to": "*-tsjaɹ-",
          "note": "cf. Cherokee ᏦᎳ tsola"
        }
      ]
    },
    {
      "language": "Gothic",
