{
  "fromId": "g_aspirated",
  "toId": "g",
  "preamble": "Loss of breathy voice in the Proto-Indo-European voiced aspirate *gʰ [ɡʱ]. In Celtic, as in several other branches, the voiced aspirates merged unconditionally with the plain voiced stops, so *gʰ and *g both became g (*slowgʰos > Proto-Celtic *slougos 'host').",
  "phoneticEffects": "Deaspiration, Merger",
  "languageExamples": [
    {
      "language": "Proto-Indo-European to Proto-Celtic",
      "languageFamily": "Celtic",
      "examples": [
        {
          "from": "*gʰroh₁weh₂ 'groats'",
          "to": "*grāwā 'gravel'",
          "note": "Proto-Brythonic *grọw."
        },
        {
          "from": "*slowgʰos 'entourage'",
          "to": "*slougos 'host, army'",
          "note": "Old Irish slóg; contrast Latin hostis, where *gʰ became h."
        }
      ]
    }
  ],
