{
  "fromId": "g_aspirated",
  "toId": "g",
  "preamble": "Loss of breathy voice in the Proto-Indo-European voiced aspirate *gʰ [ɡʱ] happened in two ways. In Indo-Aryan it occurs by Grassmann's Law, dissimilatory deaspiration when another aspirate follows in the next syllable. In Iranian, Balto-Slavic, Albanian and Celtic it was an unconditioned merger of the voiced aspirates with the plain voiced stops, so *gʰ and *g both became g.",
  "phoneticEffects": "Deaspiration, Dissimilation, Merger",
  "languageExamples": [
    {
      "language": "Sanskrit",
      "languageFamily": "Indo-Aryan",
      "examples": [
        {
          "from": "Proto-Indo-Iranian *gʰr̥dʰás (PIE *gʰr̥dʰós) 'house'",
          "to": "गृह gṛhá 'house'",
          "note": "Grassmann's Law: initial *gʰ deaspirates to g before the aspirate *dʰ of the next syllable (which later became h)."
        }
      ]
    },
    {
      "language": "Avestan",
      "languageFamily": "Iranian",
      "examples": [
        {
          "from": "Proto-Indo-Iranian *gʰr̥dʰás 'house'",
          "to": "𐬔𐬆𐬭𐬆𐬜𐬀 gərəδa 'house, den'",
          "note": "Unconditioned Iranian merger of voiced aspirates with plain voiced stops."
        }
      ]
    },
    {
      "language": "Lithuanian",
      "languageFamily": "Baltic",
      "examples": [
        {
          "from": "PIE *gʰórdʰos 'enclosure' (Proto-Balto-Slavic *gárdas)",
          "to": "gar̃das 'enclosure, pen'",
          "note": "Balto-Slavic merger of *gʰ with *g; cf. Latvian gãrds."
        }
      ]
    },
    {
      "language": "Albanian",
      "languageFamily": "Albanian",
      "examples": [
        {
          "from": "PIE *gʰórdʰos 'enclosure' (Proto-Albanian *garda)",
          "to": "gardh 'fence'",
          "note": "Albanian merger of *gʰ with *g."
        }
      ]
    },
    {
      "language": "Proto-Celtic",
      "languageFamily": "Celtic",
      "examples": [
        {
          "from": "PIE *gʰóstis 'stranger, guest'",
          "to": "*gostis",
          "note": "Celtic merger of *gʰ with *g; contrast Latin hostis, where *gʰ became h."
        }
      ]
    }
  ],
