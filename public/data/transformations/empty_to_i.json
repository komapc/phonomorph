  "toId": "i",
  "preamble": "A prothetic [i] is added before a word-initial consonant cluster in languages that do not allow clusters at the start of a word. Turkish adapts loans this way (French station > istasyon, Greek Smyrna > İzmir). Hindi does the same with English loans (school > iskūl). Hungarian borrowed Latin schola as iskola. In Arabic, a prothetic i- (hamzat al-waṣl) appears before an initial cluster when the word begins an utterance, as in ism 'name' and ibn 'son'.",
  "phoneticEffects": "Prothesis, Cluster Simplification, Loanword Adaptation",
  "languageExamples": [
    {
      "language": "Turkish",
      "languageFamily": "Oghuz",
      "examples": [
        {
          "from": "French station",
          "to": "istasyon /is.tas.jɔn/",
          "note": "Turkish does not allow initial consonant clusters, so a prothetic i- is added before st-."
        },
        {
          "from": "French squelette",
          "to": "iskelet 'skeleton'",
          "note": "Prothetic i- before sk-; compare İzmir from Greek Smyrna."
        }
      ]
    },
    {
      "language": "Hindi",
      "languageFamily": "Indo-Aryan",
      "examples": [
        {
          "from": "English school (Hindi स्कूल skūl)",
          "to": "इस्कूल iskūl",
          "note": "Prothetic i- splits the onset /sk/ into two syllables; also ispesal 'special'."
        },
        {
          "from": "English station (स्टेशन sṭeśan)",
          "to": "इस्टेशन isṭeśan",
          "note": "Same prothesis before /sʈ/."
        }
      ]
    },
    {
      "language": "Hungarian",
      "languageFamily": "Ugric",
      "examples": [
        {
          "from": "Latin schola",
          "to": "iskola 'school'",
          "note": "Hungarian did not allow word-initial clusters in older loans, so i- was added before sk-."
        }
      ]
    },
    {
      "language": "Arabic",
      "languageFamily": "Semitic",
      "examples": [
        {
          "from": "Proto-Semitic *šim- 'name' (Arabic stem /sm/)",
          "to": "ism [ʔism] 'name'",
          "note": "The prothetic vowel appears only at the start of an utterance (hamzat al-waṣl) and is dropped when a vowel precedes."
        },
        {
          "from": "Proto-Semitic *bin- 'son' (Arabic stem /bn/)",
          "to": "ibn [ʔibn] 'son'",
          "note": "Same prothetic i- before an initial cluster."
        }
      ]
    }
  ],
