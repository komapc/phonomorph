      "language": "Mandarin Chinese",
      "languageFamily": "Sinitic",
      "examples": [
        {
          "from": "Middle Chinese 件 gjenX 'item'",
          "to": "jiàn [tɕjɛn]",
          "note": "Oblique-tone [g] → [k] → [tɕ] before a front medial."
        },
        {
          "from": "Middle Chinese 巨 gjoX 'huge'",
          "to": "jù [tɕy]"
        },
        {
          "from": "Middle Chinese 舊 gjuwH 'old'",
          "to": "jiù [tɕjoʊ]"
        }
      ]
    }
  ],
