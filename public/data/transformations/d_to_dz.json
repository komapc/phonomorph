          "from": "Proto-Nguni *-landa 'to follow'",
          "to": "-landza",
          "note": "Zulu, Xhosa -landa."
        },
        {
          "from": "Proto-Nguni *-linda 'to wait'",
          "to": "-lindza",
          "note": "Zulu, Xhosa -linda."
        }
      ]
    },
