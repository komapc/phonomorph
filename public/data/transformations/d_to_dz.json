      "language": "Japanese (Late Middle Japanese)",
      "languageFamily": "Japonic",
      "examples": [
        {
          "from": "Old Japanese みづ mi₁du 'water'",
          "to": "[midzu] (now mizu [mizɯ])",
          "note": "/t/ and /d/ were affricated before /u/ (and /i/); [dzu] later merged with [zu] in most dialects (the yotsugana merger)."
        },
        {
          "from": "Old Japanese 鼓 tudumi 'hand drum'",
          "to": "[tsudzumi] (now tsuzumi)",
          "note": "Both stops are affricated in the same word: /tudumi/ > /t͡sud͡zumi/ > /t͡suzumi/."
        }
      ]
