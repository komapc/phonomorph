  "preamble": "The elision of [e] is one of the most frequent sound changes in European languages. It often occurs as apocope (loss of final sounds) or syncope (loss of internal sounds), typically in unstressed positions. In Baure (Arawakan, Bolivia), apocope removed word-final vowels, including *e.",
  "phoneticEffects": "Elision, Apocope, Syncope",
  "languageExamples": [
    {
      "language": "Middle English to Modern English",
      "languageFamily": "Germanic",
      "examples": [
        {
          "from": "name [naːmə]",
          "to": "name [neɪm]",
          "note": "Loss of the final 'schwa' which was historically [e]."
        }
      ]
    },
    {
      "language": "Latin to Romance",
      "languageFamily": "Romance",
      "examples": [
        {
          "from": "facere (final -e)",
          "to": "hacer (Spanish) / faire (French)",
          "note": "Reduction and elision of the final infinitive vowel."
        }
      ]
    },
    {
      "language": "Proto-Tocharian to Tocharian A",
      "languageFamily": "Tocharian",
      "examples": [
        {
          "from": "*āke 'end'",
          "to": "āk",
          "note": "word-final vowels are lost in A; cf. B āke"
        },
        {
          "from": "*keme 'tooth'",
          "to": "kam",
          "note": "cf. B keme"
        },
        {
          "from": "*wyente 'wind'",
          "to": "want",
          "note": "cf. B yente"
        },
        {
          "from": "*āskwāce 'halfa grass'",
          "to": "āskāc",
          "note": "cf. B askace"
        }
      ]
    },
    {
      "language": "Skolt Sami",
      "languageFamily": "Samic",
      "examples": [
        {
          "from": "Proto-Samic *kuolē 'fish'",
          "to": "kueʹll",
          "note": "Skolt and Akkala Sami lost final unstressed vowels; the lost front *ē survives as palatalization of the stress group (marked ʹ). Northern Sami guolli keeps the vowel."
        },
        {
          "from": "Proto-Samic *oalkē 'shoulder'",
          "to": "vuäʹlǧǧ",
          "note": "Same apocope; compare Northern Sami oalgi."
        },
        {
          "from": "Proto-Samic *čoalmē 'strait'",
          "to": "čuäʹlmm",
          "note": "Same apocope; compare Northern Sami čoalbmi."
        },
        {
          "from": "Proto-Samic *sāppē 'gall'",
          "to": "säʹpp",
          "note": "Same apocope; compare Northern Sami sáhppi."
        }
      ]
    },
    {
      "language": "Baure",
      "languageFamily": "Bolivia-Paraná",
      "examples": [
        {
          "from": "Proto-Baure-Muxojeóne *-ose 'grandmother' (Joaquiniano -ose)",
          "to": "Baure -os"
        },
        {
          "from": "Proto-Baure-Muxojeóne *hane 'wasp' (Muxojeóne ðane, Joaquiniano hane)",
          "to": "Baure han (also hane)",
          "note": "Word-final vowel lost by apocope."
        }
      ]
    },
    {
      "language": "Proto-Tungusic to Even",
      "languageFamily": "Northern Tungusic",
      "examples": [
        {
          "from": "*beye 'body'",
          "to": "Even бэй",
          "note": "Evenki бэе keeps the final vowel."
        },
        {
          "from": "*tügde 'rain'",
          "to": "Even тӣд",
          "note": "Evenki тыгдэ."
        },
        {
          "from": "*sele 'iron'",
          "to": "Even хэл",
          "note": "Evenki сэлэ; Even also shifts *s to h."
