    {
      "language": "Uyghur",
      "languageFamily": "Turkic",
      "examples": [
        {
          "from": "sariy [a]",
          "to": "seriq [e]",
          "note": "Southeastern Turkic umlaut: /a/ in initial syllable is raised and fronted to /e/ under influence of primary /i/ in subsequent syllable. Also shows palatal-conditioned vowel lowering in final syllable (i → iq)."
        }
      ]
    },
    {
      "language": "Dinka",
      "languageFamily": "Nilo-Saharan",
      "examples": [
        {
          "from": "stem /a/",
          "to": "[ɛ]",
          "note": "Verb stem fronting: stem vowel /a/ alternates with /ɛ/ in the 3sg morphological form, a nonconcatenative vowel-change pattern. E.g., /ɣap/ 'to catch' (infinitive) → /ɣɛp/ (3sg). This is one of two complementary vowel alternations (fronting and lowering) that drive the Dinka verbal paradigm."
        }
      ]
