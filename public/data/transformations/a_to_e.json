{
  "fromId": "a",
  "toId": "e",
  "preamble": "The vowel [a] shifts to [e] or [æ] through fronting, a common process in vowel systems where back vowels advance toward the front of the oral cavity. This occurs frequently as a conditioned change (after palatalized consonants or before front vowels) and less commonly as an unconditioned historical shift.",
  "phoneticEffects": "Fronting, Vowel Raising, Vowel Reduction",
  "languageExamples": [
    {
      "language": "Old French",
      "languageFamily": "Romance",
      "examples": [
        {
          "from": "Latin mare 'sea'",
          "to": "Old French mer",
          "note": "Stressed Latin a in an open syllable became e."
        },
        {
          "from": "Latin nāsus 'nose'",
          "to": "Old French nés"
        },
        {
          "from": "Latin prātum 'meadow'",
          "to": "Old French pred, pré"
        }
      ]
    },
    {
      "language": "Uyghur",
      "languageFamily": "Turkic",
      "examples": [
        {
          "from": "Proto-Turkic *bālïk 'fish'",
          "to": "بېلىق bëliq",
          "note": "Uyghur umlaut: first-syllable *a is raised to e before a high vowel /i/ (from *ï) in the next syllable; Turkish keeps balık."
        },
        {
          "from": "Proto-Turkic *yaŋï 'new'",
          "to": "يېڭى yëngi"
        },
        {
          "from": "Proto-Turkic *siarïg 'yellow'",
          "to": "سېرىق sëriq",
          "note": "cf. Old Turkic sarïɣ, Turkish sarı."
        }
      ]
    },
    {
      "language": "Wu Chinese (Shanghainese)",
      "languageFamily": "Sinitic",
      "examples": [
        {
          "from": "三 MC sam",
          "to": "se (Wugniu)",
          "note": "Nasal coda lost and the vowel raised; Mandarin sān, Cantonese saam."
        },
        {
          "from": "反 MC pjonX",
          "to": "fe (Wugniu)",
          "note": "Mandarin fǎn."
        }
      ]
    },
    {
      "language": "Proto-Nakh to Plains Chechen",
      "languageFamily": "Nakh-Dagestani",
      "examples": [
        {
          "from": "*maqe 'harrow'",
          "to": "meqi, meqa",
          "note": "Palatal umlaut: a first-syllable *a fronts before a second-syllable *e or *i, which was later reduced"
        },
        {
          "from": "*nace 'moth'",
          "to": "neci, neca"
        }
      ]
    },
    {
      "language": "Proto-Samic (from Proto-Uralic), unstressed syllables",
      "languageFamily": "Samic",
      "examples": [
        {
          "from": "Proto-Uralic *kala 'fish'",
          "to": "Proto-Samic *kuolē",
          "note": "Reconstructed stage. After the first-syllable metaphony, unstressed *ā became *ē unless followed by *ë in a later syllable (*kalanï > *kuolānë 'my fish'); before *j it gave *i."
        },
        {
          "from": "Proto-Uralic *taka 'back, rear'",
          "to": "Proto-Samic *tuokē",
          "note": "Reconstructed stage."
        },
        {
          "from": "Proto-Uralic *sarka 'branch'",
          "to": "Proto-Samic *suorkē > Northern Sami suorgi",
          "note": "Reconstructed stage; the *ē later became i in Northern Sami."
        },
        {
          "from": "Proto-Uralic *säppä 'gall'",
          "to": "Proto-Samic *sāppē",
          "note": "Reconstructed stage; front *ä of the second syllable merged with *a before the change."
        }
      ]
    },
    {
      "language": "Old High German",
      "languageFamily": "High German",
      "examples": [
        {
          "from": "Proto-West Germanic *sattjan 'to set'",
          "to": "sezzen"
        },
        {
          "from": "Proto-West Germanic *talljan 'to count'",
          "to": "zellen"
        },
        {
          "from": "Proto-West Germanic *hari 'army'",
          "to": "heri",
          "note": "Primary i-umlaut: short *a became e before i, ī or j in the next syllable (German setzen)."
        }
      ]
    },
    {
      "language": "Old Norse",
