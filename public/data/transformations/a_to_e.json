{
  "fromId": "a",
  "toId": "e",
  "preamble": "The vowel [a] shifts to [e] or [æ] through fronting, a common process in vowel systems where back vowels advance toward the front of the oral cavity. This occurs frequently as a conditioned change (after palatalized consonants or before front vowels) and less commonly as an unconditioned historical shift.",
  "phoneticEffects": "Fronting, Vowel Raising, Vowel Reduction",
  "languageExamples": [
    {
      "language": "Old French",
      "languageFamily": "Romance",
      "examples": [
        {
          "from": "[a]",
          "to": "[e]",
          "context": "Before palatalized velar consonants (Bartsch's law)"
        },
        {
          "from": "cane",
          "to": "chien",
          "meaning": "dog"
        }
      ]
    },
    {
      "language": "Erzya",
      "languageFamily": "Uralic",
      "examples": [
        {
          "from": "[a]",
          "to": "[æ]",
          "context": "After palatalized consonants"
        }
      ]
    },
    {
      "language": "Russian",
      "languageFamily": "Slavic",
      "examples": [
        {
          "from": "[a]",
          "to": "[æ]",
          "context": "Near palatalized consonants"
        }
      ]
    },
    {
      "language": "Uyghur",
      "languageFamily": "Turkic",
      "examples": [
        {
          "from": "sariy [a]",
          "to": "seriq [e]",
          "note": "Southeastern Turkic umlaut: /a/ in initial syllable is raised and fronted to /e/ under influence of primary /i/ in subsequent syllable. Also shows palatal-conditioned vowel lowering in final syllable (i → iq)."
        }
      ]
    },
    {
      "language": "Dinka",
      "languageFamily": "Nilo-Saharan",
      "examples": [
        {
          "from": "stem /a/",
          "to": "[ɛ]",
          "note": "Verb stem fronting: stem vowel /a/ alternates with /ɛ/ in the 3sg morphological form, a nonconcatenative vowel-change pattern. E.g., /ɣap/ 'to catch' (infinitive) → /ɣɛp/ (3sg). This is one of two complementary vowel alternations (fronting and lowering) that drive the Dinka verbal paradigm."
        }
      ]
    },
    {
      "language": "Wu Chinese (Shanghainese)",
      "languageFamily": "Sinitic",
      "examples": [
        {
          "from": "三 MC sam",
          "to": "se (Wugniu)",
          "note": "Nasal coda lost and the vowel raised; Mandarin sān, Cantonese saam."
        },
        {
          "from": "反 MC pjonX",
          "to": "fe (Wugniu)",
          "note": "Mandarin fǎn."
        }
      ]
    },
    {
      "language": "Proto-Nakh to Plains Chechen",
      "languageFamily": "Nakh-Dagestani",
      "examples": [
        {
          "from": "*maqe 'harrow'",
          "to": "meqi, meqa",
          "note": "Palatal umlaut: a first-syllable *a fronts before a second-syllable *e or *i, which was later reduced"
        },
        {
          "from": "*nace 'moth'",
          "to": "neci, neca"
        }
