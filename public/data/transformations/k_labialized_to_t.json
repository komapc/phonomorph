  "preamble": "In Attic-Ionic and most other Greek dialects the labialized velar [kʷ] became the dental stop [t] before the front vowels /e/ and /i/, a palatalizing fronting that removed both the velar contact and the lip rounding; elsewhere it became p. Mycenaean still writes the labiovelar (qe-to-ro-we /kʷétroːwes/ 'four-eared'), and Lesbian and Thessalian show p in the same words (πέμπε 'five').",
  "phoneticEffects": "Fronting, Dentalization",
  "languageExamples": [
    {
      "language": "Ancient Greek (from Proto-Greek)",
      "languageFamily": "Hellenic",
      "examples": [
        {
          "from": "PIE *kʷís 'who'",
          "to": "τίς tís",
          "note": "Compare Latin quis."
        },
        {
          "from": "Proto-Greek *pénkʷe 'five' (< PIE *pénkʷe)",
          "to": "Attic-Ionic πέντε pénte",
          "note": "Lesbian and Thessalian πέμπε pémpe."
        },
        {
          "from": "PIE *kʷétwores 'four' (Mycenaean qe-to-ro-we 'four-eared')",
          "to": "Attic τέτταρες téttares, Ionic τέσσερες tésseres",
          "note": "Boeotian πέτταρες péttares shows the labial outcome."
        }
      ]
    }
