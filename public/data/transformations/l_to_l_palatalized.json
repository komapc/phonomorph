    {
      "language": "Irish",
      "languageFamily": "Goidelic",
      "examples": [
        {
          "from": "Proto-Celtic *lindos 'lake, liquid' (Old Irish lind)",
          "to": "linn /lʲiːnʲ/ (Munster) 'pool'",
          "note": "Initial l before the front vowel i became slender (palatalized) lʲ."
        },
        {
          "from": "Proto-Celtic *ɸlikkā (Old Irish lecc)",
