{
  "fromId": "l",
  "toId": "l_palatalized",
  "preamble": "Palatalization of the plain alveolar lateral [l] to [lʲ] adds a secondary palatal articulation before front vowels. In East Slavic (Russian, Ukrainian, Belarusian) the automatic palatalization of consonants before front vowels became phonemic after the loss of the yers, so Proto-Slavic *l before *ě or *i is now [lʲ]; in Goidelic Celtic consonants became slender (palatalized) before original front vowels, giving Irish [lʲ] in words such as linn and leac.",
  "phoneticEffects": "Palatalization, Secondary Articulation",
  "languageExamples": [
    {
      "language": "Russian",
      "languageFamily": "East Slavic",
      "examples": [
        {
          "from": "Proto-Slavic *lěsъ 'forest'",
          "to": "лес [ˈlʲes]",
          "note": "Plain *l before the front vowel *ě became palatalized [lʲ]; the palatalization became phonemic once the front yer was lost."
        },
        {
          "from": "Proto-Slavic *lěto 'year'",
          "to": "лето [ˈlʲetə] 'summer'"
        },
        {
          "from": "Proto-Slavic *lice 'face'",
          "to": "лицо [lʲɪˈt͡so]"
        }
      ]
    },
    {
