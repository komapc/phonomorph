      "language": "Kannada",
      "languageFamily": "South Dravidian",
      "examples": [
        {
          "from": "Old Kannada ಕೋೞಿ kōḻi 'chicken, hen' (Proto-South Dravidian *kōẓi)",
          "to": "ಕೋಳಿ kōḷi"
        },
        {
          "from": "Old Kannada ಪುೞು puḻu 'worm' (Proto-Dravidian *puẓu)",
          "to": "ಹುಳು huḷu",
          "note": "Initial p > h is a separate Kannada change; Tamil புழு puḻu keeps the approximant."
        }
      ]
    },
