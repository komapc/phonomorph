{
  "fromId": "th_vless",
  "toId": "h",
  "preamble": "Debuccalization of the voiceless dental fricative [θ] to the glottal fricative [h] is a common step in the weakening of dental sounds across several language families, most notably in Samic and Irish, where Old Irish [θ] (written ⟨th⟩) became [h].",
  "phoneticEffects": "Debuccalization, Lenition",
  "languageExamples": [
    {
      "language": "Old Irish to Irish",
      "languageFamily": "Goidelic",
      "examples": [
        {
          "from": "Old Irish athair 'father' (⟨th⟩ = [θ])",
          "to": "Irish athair /ˈɑhəɾʲ/ (Munster), /ˈahəɾʲ/ (Mayo)"
        },
        {
          "from": "Old Irish máthir 'mother'",
          "to": "Irish máthair /ˈmˠɑːhəɾʲ/"
        },
        {
          "from": "Old Irish bráthair 'brother'",
          "to": "Irish bráthair /ˈbˠɾˠɑːhəɾʲ/"
        },
        {
          "from": "Old Irish roth 'wheel'",
          "to": "Irish roth /ɾˠɞh/",
          "note": "Scottish Gaelic shows the same [h]: athair /ˈahəð/, bith /b̥ih/."
        }
      ]
    },
    {
      "language": "South Sami and Ume Sami",
      "languageFamily": "Samic",
      "examples": [
        {
          "from": "Proto-Samic *δëmē 'glue' (word-initial *δ = [θ])",
          "to": "South Sami hipmie",
          "note": "In South and Ume Sami, word-initial Proto-Samic *θ debuccalized to h, whereas the other Samic languages harden it to t (Northern Sami dapmi)."
        },
        {
          "from": "Proto-Samic *δāmpë 'shinbone of a reindeer's foreleg'",
          "to": "South Sami haabpe, Ume Sami hábˈba",
          "note": "Compare Northern Sami dábba with a stop."
        },
        {
          "from": "Proto-Samic *δāpδē",
          "to": "Ume Sami hábđđie",
          "note": "Compare Lule Sami dábdde, Inari Sami täbđi."
        }
      ]
    }
  ],
