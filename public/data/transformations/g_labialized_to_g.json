{
  "fromId": "g_labialized",
  "toId": "g",
  "preamble": "Delabialization of the labialized voiced velar [gʷ] to a plain [g] removes the lip rounding while keeping the velar closure. It is part of the satem merger, in which Proto-Indo-European *gʷ fell together with plain *g in Indo-Iranian and Balto-Slavic before back vowels and consonants (before front vowels the merged velar was later palatalized, as in Sanskrit jīvá 'alive'); Greek, Latin and Celtic show labial or glide reflexes in the same words.",
  "phoneticEffects": "Delabialization, Merger",
  "languageExamples": [
    {
      "language": "Proto-Indo-Iranian",
      "languageFamily": "Indo-Iranian",
      "examples": [
        {
          "from": "PIE *gʷṓws 'cow'",
          "to": "Proto-Indo-Iranian *gā́wš",
          "note": "Greek βοῦς and Umbrian bum have b."
        },
        {
          "from": "PIE *gʷréh₂us 'heavy'",
          "to": "Proto-Indo-Iranian *gr̥Húš (Sanskrit gurú)",
          "note": "Greek βαρύς has b."
        },
        {
          "from": "PIE *gʷem- 'to go, come'",
          "to": "Sanskrit gam, gamáyati 'causes to go'"
