  "preamble": "The palatal approximant [j] becomes the palatal nasal [ɲ] next to nasal vowels, a nasalization that also adds full oral closure. In Old Tupi (Tupinambá), /j/ is realized [ɲ] when a neighbouring syllable is nasal, as part of the nasal harmony of the Tupi-Guarani languages. In Mixtec, Proto-Mixtec *y became ñ before a nasalized vowel in nearly all varieties (*iyǫ 'six' > iñu).",
  "phoneticEffects": "Nasalization, Fortition",
  "languageExamples": [
    {
      "language": "Old Tupi (Tupinambá)",
      "languageFamily": "Tupi-Guarani",
      "examples": [
        {
          "from": "/jetiŋ/ 'fly species'",
          "to": "[ɲẽˈtĩŋ]",
          "note": "/j/ is [ɲ] when preceded or followed by a nasal syllable (Gerardi 2023)."
        },
        {
          "from": "/atõja/ 'touch'",
          "to": "[aˈtõɲã]"
        }
      ]
    },
    {
      "language": "Mixtec",
      "languageFamily": "Mixtecan",
      "examples": [
        {
          "from": "Proto-Mixtec *iyǫ 'six'",
          "to": "iñu (Chayuco, Magdalena Peñasco, San Juan Colorado, Yosondúa)",
          "note": "*y > ñ before a nasalized vowel."
        },
        {
          "from": "Proto-Mixtec *kòyǫ́ 'meat'",
          "to": "kuñu; Chayuco coño"
        }
      ]
    }
  ],
