          "to": "iñu (Chayuco, Magdalena Peñasco, San Juan Colorado, Yosondúa)",
          "note": "*y > ñ before a nasalized vowel."
        },
        {
          "from": "Proto-Mixtec *kòyǫ́ 'meat'",
          "to": "kuñu; Chayuco coño"
