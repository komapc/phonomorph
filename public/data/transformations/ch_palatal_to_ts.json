{
  "fromId": "ch_palatal",
  "toId": "ts",
  "preamble": "Depalatalization of the alveolo-palatal affricate [tɕ] to the alveolar affricate [ts]. In Kashubian, the alveolo-palatals that arose from Proto-Slavic soft t, d, s, z (still ć, dź, ś, ź in Polish) hardened to dental c, dz, s, z, probably before the 17th century (kaszëbienié).",
  "phoneticEffects": "Depalatalization, Merger",
  "languageExamples": [
    {
      "language": "Kashubian",
      "languageFamily": "West Slavic",
      "examples": [
        {
          "from": "*-ć [tɕ] (Polish chodzić 'to walk')",
          "to": "chòdzëc [-ts]",
          "note": "The infinitive ending -ć became -c."
        },
        {
          "from": "*-ć [tɕ] (Polish robić 'to do')",
          "to": "robic [-ts]"
        },
        {
          "from": "*ć [tɕ] (Polish cicho 'quietly')",
          "to": "cëchò [ts-]",
          "note": "Short i after the new dental became ë."
        }
      ]
    },
    {
      "language": "Proto-Indo-Iranian to Proto-Iranian",
      "languageFamily": "Iranian",
      "examples": [
        {
          "from": "Proto-Indo-Iranian *dáća 'ten'",
          "to": "Proto-Iranian *dáca",
          "note": "Proto-Iranian *c is the voiceless alveolar affricate; Avestan, Parthian and Sogdian later show s, Old Persian θ."
        },
        {
          "from": "Proto-Indo-Iranian *páću 'livestock'",
          "to": "Proto-Iranian *pácu"
        },
        {
          "from": "Proto-Indo-Iranian *ćánsati 'declares'",
          "to": "Proto-Iranian *cánhati",
          "note": "Old Persian θātiy 'says' continues this verb."
        },
        {
          "from": "Proto-Indo-Iranian *ćarHáts 'autumn, year'",
          "to": "Proto-Iranian *carHdáh"
        }
      ]
    }
  ],
  "certainty": 4,
