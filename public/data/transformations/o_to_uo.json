  "preamble": "A mid back vowel breaks into the rising diphthong [uo]/[ua]. Old Irish ó (< *ou, *au) became úa before consonants, Old High German turned Proto-Germanic *ō into uo, and Italian diphthongized Latin short ŏ to uo in stressed open syllables.",
  "phoneticEffects": "Diphthongization, Breaking, Chain Shift, Umlaut",
  "languageExamples": [
    {
      "language": "Old Irish",
      "languageFamily": "Goidelic",
      "examples": [
        {
          "from": "slóg 'host, army' (< *slougos)",
          "to": "slúag",
          "note": "ó breaks to úa before a consonant; both spellings occur in Old Irish"
        },
        {
          "from": "*roudos 'red'",
          "to": "rúad"
        },
        {
          "from": "*autīto- 'singleness'",
          "to": "úaithed"
        }
      ]
    },
    {
      "language": "Old High German",
      "languageFamily": "High German",
      "examples": [
        {
          "from": "*fōts 'foot' (Gothic fōtus)",
          "to": "OHG fuoz"
        },
        {
          "from": "*gōdaz 'good' (Gothic gōþs)",
          "to": "OHG guot"
        },
        {
          "from": "*brōþēr 'brother'",
          "to": "OHG bruoder",
          "note": "Monophthongized again in New High German (Fuß, gut, Bruder)"
        }
      ]
    },
    {
      "language": "Latin to Italian",
      "languageFamily": "Romance",
      "examples": [
        {
          "from": "Latin bonum 'good'",
          "to": "buono [ˈbwɔːno]",
          "note": "Stressed ŏ [ɔ] in an open syllable diphthongized; Tuscan bono keeps the monophthong."
        },
        {
          "from": "Latin focum 'hearth'",
          "to": "fuoco [ˈfwɔːko] 'fire'"
        },
        {
          "from": "Latin novum 'new'",
          "to": "nuovo [ˈnwɔːvo]"
        }
      ]
    },
    {
      "language": "Proto-Samic (from Proto-Uralic)",
      "languageFamily": "Samic",
      "examples": [
