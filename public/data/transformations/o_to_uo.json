{
  "fromId": "o",
  "toId": "uo",
  "preamble": "A mid back vowel breaks into the rising diphthong [uo]/[ua]. Old Irish ó (< *ou, *au) became úa before consonants, Old High German turned Proto-Germanic *ō into uo, and Italian diphthongized Latin short ŏ to uo in stressed open syllables.",
  "phoneticEffects": "Diphthongization, Breaking, Chain Shift, Umlaut",
  "languageExamples": [
    {
      "language": "Old Irish",
      "languageFamily": "Goidelic",
      "examples": [
        {
          "from": "slóg 'host, army' (< *slougos)",
          "to": "slúag",
          "note": "ó breaks to úa before a consonant; both spellings occur in Old Irish"
        },
        {
          "from": "*roudos 'red'",
          "to": "rúad"
        },
        {
          "from": "*autīto- 'singleness'",
          "to": "úaithed"
        }
      ]
    },
    {
      "language": "Proto-Germanic to Old High German",
      "languageFamily": "West Germanic",
      "examples": [
        {
          "from": "*fōts 'foot' (Gothic fōtus)",
          "to": "OHG fuoz"
        },
        {
          "from": "*gōdaz 'good' (Gothic gōþs)",
          "to": "OHG guot"
        },
        {
          "from": "*brōþēr 'brother'",
          "to": "OHG bruoder",
          "note": "Monophthongized again in New High German (Fuß, gut, Bruder)"
        }
      ]
    },
    {
      "language": "Latin to Italian",
      "languageFamily": "Romance",
      "examples": [
        {
          "from": "bŏnum",
          "to": "buono",
          "note": "Stressed open-syllable ŏ [ɔ] diphthongizes"
        },
        {
          "from": "fŏcum",
          "to": "fuoco"
        }
      ]
    },
    {
      "language": "Proto-Samic (from Proto-Uralic)",
      "languageFamily": "Samic",
      "examples": [
        {
          "from": "Proto-Uralic *polwe 'knee'",
          "to": "Proto-Samic *puolvë > Northern Sami buolva, Inari Sami puolˈvâ",
          "note": "Reconstructed stage. Pre-Samic *o was lengthened to *ō and diphthongized to *uo before a second-syllable *ë; before *ā or *ō it was lowered instead and gave *oa (*wolka > *oalkē 'shoulder'). Finnish polvi."
        },
        {
          "from": "Proto-Uralic *kośke 'rapids'",
          "to": "Proto-Samic *kuoškë > Northern Sami guoika, Inari Sami kuošˈkâ",
          "note": "Reconstructed stage; Finnish koski."
        },
        {
          "from": "Proto-Uralic *soske- 'to bite'",
          "to": "Proto-Samic *suoskë- > Northern Sami suoskat",
          "note": "Reconstructed stage."
        },
        {
          "from": "Proto-Uralic *korpe 'land ravaged by forest fire'",
          "to": "Proto-Samic *kuorpë > Lule Sami guorbba",
          "note": "Reconstructed stage."
        }
      ]
