          "to": "/bɔɾo/ [ˈbɔɾoˑ]",
          "note": "Wiktionary lists both pronunciations for Rarh; Dhaka has /bɔɹo/."
        },
        {
          "from": "বাড়ি /baɽi/ 'house'",
          "to": "/baɾi/ [ˈbaɾiˑ]"
        },
