{
  "fromId": "b",
  "toId": "v",
  "preamble": "The shift from the bilabial stop [b] to the labiodental (or bilabial) fricative [v] or approximant [β] is a classic instance of spirantization (lenition). It is especially common in intervocalic position, where the oral closure weakens. In Spanish, this merged with the reflex of Latin /v/ (originally [w]) to produce a single phoneme realized as [b] word-initially and [β] elsewhere.",
  "phoneticEffects": "Spirantization, Lenition",
  "languageExamples": [
    {
      "language": "Biblical Hebrew",
      "languageFamily": "Semitic",
      "examples": [
        {
          "from": "kātab [b]",
          "to": "kātav [v]",
          "note": "Begedkefat spirantization: post-vocalic /b/ → [v] in Biblical Hebrew. E.g., כָּתַב 'katav' (he wrote)."
        }
      ]
    },
    {
      "language": "Spanish",
      "languageFamily": "Romance",
      "examples": [
        {
          "from": "habēre (Latin)",
          "to": "haber [aβer]",
          "note": "Intervocalic Latin /b/ spirantized to [β]; also illustrates betacism (merger of /b/ and /v/)."
        }
      ]
    },
    {
      "language": "Middle Persian",
      "languageFamily": "Iranian",
      "examples": [
        {
          "from": "Old Persian naiba- [b] (beautiful)",
          "to": "Middle Persian nēw [w]",
          "note": "Intervocalic lenition in Middle Persian: /b/ after a vowel shifted to the approximant [w] (sometimes transcribed as /v/). The process began in the Arsacid period and was fully established in Sassanid-era Middle Persian (3rd–7th c. CE)."
        },
        {
          "from": "Old Persian asabāra- [b] (horseman)",
          "to": "Middle Persian asvār",
          "note": "Intervocalic /b/ → /w/ ~ /v/; the word shows the characteristic Iranian weakening of voiced stops between vowels."
        }
      ]
    },
    {
      "language": "Sogdian",
      "languageFamily": "Iranian",
      "examples": [
        {
          "from": "Old Iranian /b/ (all positions)",
          "to": "Sogdian /β/ (fricative)",
          "note": "Sogdian underwent spirantization of voiced stops more radically than Persian: /b/ → [β] in all positions including word-initially (not just intervocalically). This Eastern Iranian feature distinguished Sogdian from Middle Persian."
        }
      ]
    },
    {
      "language": "Kabyle",
      "languageFamily": "Berber",
      "examples": [
        {
          "from": "abrid [b] (road)",
          "to": "[aβrid] (spirantized)",
          "note": "Kabyle spirantization: lax /b/ in intervocalic position weakens to the voiced bilabial fricative [β], approaching [v] in some realizations. Geminate /bb/ and post-nasal /mb/ resist spirantization and surface as stops."
        },
        {
          "from": "amghar [stop b in compounds]",
          "to": "[β] in intervocalic environment",
          "note": "Northern Berber spirantization rule: lax (non-geminate) /b/ between vowels or sonorants → [β]. Absent in Zenaga and Tetserret (non-spirantizing Berber branches)."
        }
      ]
    },
    {
