  "preamble": "The shift from the bilabial stop [b] to the labiodental (or bilabial) fricative [v] or approximant [β] is a classic instance of spirantization (lenition). It is especially common in intervocalic position, where the oral closure weakens.",
  "phoneticEffects": "Spirantization, Lenition",
  "languageExamples": [
    {
      "language": "Biblical Hebrew",
      "languageFamily": "Semitic",
      "isAllophone": true,
      "examples": [
        {
          "from": "כָּתַב 'he wrote' (early Biblical /kaːˈtab/)",
          "to": "Tiberian /kɔːˈθav/",
          "note": "Begedkefat spirantization of post-vocalic /b/ to [v]."
        },
        {
          "from": "לֵב 'heart' (early Biblical /lib/)",
          "to": "Tiberian /ˈleːv/ [ˈleː.ev]"
        },
        {
          "from": "זָהָב 'gold' (final ב after a vowel)",
          "to": "Tiberian /zɔˈhɔv/",
          "note": "Postvocalic /b/ is spirantized to [v]; after a consonant or in gemination ב stays [b]."
        }
      ]
    },
    {
      "language": "Kabyle",
      "languageFamily": "Berber",
      "isAllophone": true,
      "examples": [
        {
          "from": "abrid [b] (road)",
          "to": "[aβrid] (spirantized)",
          "note": "Kabyle spirantization: lax /b/ in intervocalic position weakens to the voiced bilabial fricative [β], approaching [v] in some realizations. Geminate /bb/ and post-nasal /mb/ resist spirantization and surface as stops."
        },
        {
          "from": "amghar [stop b in compounds]",
          "to": "[β] in intervocalic environment",
          "note": "Northern Berber spirantization rule: lax (non-geminate) /b/ between vowels or sonorants → [β]. Absent in Zenaga and Tetserret (non-spirantizing Berber branches)."
        }
      ]
    },
