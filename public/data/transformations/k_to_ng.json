  "preamble": "A velar stop becomes the velar nasal [ŋ] next to a nasal. In Korean a stop assimilates to a following nasal consonant. In Indonesian and Malay the nasal prefix meN- fuses with a root-initial k, which is replaced by [ŋ] (nasal substitution). Welsh nasal mutation, which also comes from an earlier nasal, gives a voiceless velar nasal [ŋ̊] rather than [ŋ].",
  "phoneticEffects": "Nasal Assimilation, Nasalization, Nasal Coalescence",
  "languageExamples": [
    {
      "language": "Korean",
      "languageFamily": "Koreanic",
      "examples": [
        {
          "from": "국물 kuk-mul 'broth'",
          "to": "[kuŋmul]",
          "note": "Coda /k/ becomes [ŋ] before a nasal onset"
        },
        {
          "from": "한국말 hanguk-mal 'Korean language'",
          "to": "[hanguŋmal]",
          "note": "Pronounced 한궁말"
        }
      ]
    },
    {
      "language": "Indonesian",
      "languageFamily": "Malayic",
      "examples": [
        {
          "from": "kirim 'send'",
          "to": "mengirim [məŋirim] 'to send'",
          "note": "meN- + k: the k is replaced by [ŋ]"
        },
        {
          "from": "kenal 'know'",
          "to": "mengenal [məŋənal] 'to know, recognize'"
        }
      ]
    }
