{
  "fromId": "d_aspirated",
  "toId": "t_aspirated",
  "preamble": "Devoicing of the voiced aspirated (breathy-voiced) stop [dʱ] to the voiceless aspirated [tʰ] keeps the aspiration while losing voicing. It is the regular Greek reflex of Proto-Indo-European *dʰ (Greek θ, originally [tʰ]) and recurs independently in Romani, where the Old Indo-Aryan voiced aspirates bh, dh and gh became ph, th and kh.",
  "phoneticEffects": "Devoicing",
  "languageExamples": [
    {
      "language": "Ancient Greek",
      "languageFamily": "Hellenic",
      "examples": [
        {
          "from": "PIE *dʰuh₂mós 'smoke'",
          "to": "θυμός thūmós /tʰyː.mós/ 'spirit, soul'",
          "note": "Via Proto-Hellenic *tʰūmós; cf. Sanskrit dhūmá 'smoke', Latin fūmus."
        },
        {
          "from": "PIE *dʰwer- 'door'",
          "to": "θύρα thúra /tʰý.ra/ 'door'",
          "note": "Via Proto-Hellenic *tʰurā."
        }
      ]
    },
    {
      "language": "Romani",
      "languageFamily": "Indo-Aryan",
      "examples": [
        {
          "from": "Sanskrit धूम dhūma 'smoke'",
          "to": "thuv 'smoke'",
          "note": "cf. Hindi धूआँ dhūā̃, which keeps the voiced aspirate."
        },
        {
          "from": "Sanskrit धावति dhāvati 'washes'",
          "to": "thovel 'to wash'",
          "note": "cf. Hindi धोना dhonā, which keeps dh."
        }
      ]
    }
  ],
