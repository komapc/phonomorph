{
  "fromId": "t_retroflex_aspirated",
  "toId": "t_retroflex",
  "preamble": "Deaspiration of the aspirated retroflex stop [ʈʰ] to plain [ʈ] removes the aspiration while keeping the retroflex place. Sinhala lost the aspirated/unaspirated contrast in all its plosives, so Prakrit ṭṭh appears as ṭ, while it keeps the dental/retroflex distinction.",
  "phoneticEffects": "Deaspiration, Loss of Aspiration",
  "languageExamples": [
    {
      "language": "Sinhala",
      "languageFamily": "Insular Indo-Aryan",
      "examples": [
        {
          "from": "Prakrit aṭṭha 'eight'",
          "to": "අට (aṭa)",
          "note": "Through Apabhramsa aṭṭha; the aspiration was lost and the geminate shortened."
        },
        {
          "from": "Prakrit piṭṭha 'back'",
          "to": "පිට (piṭa) /pi.ʈa/",
          "note": "Cognate with Hindi पीठ /piːʈʰ/, which keeps the aspiration."
        }
      ]
    }
  ],
