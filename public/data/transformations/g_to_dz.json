  "fromId": "g",
  "toId": "dz",
  "preamble": "Assibilation of [ɡ] to the affricate [dz] before front vowels happened independently in two branches of Balto-Slavic. In the Slavic second palatalization, *g before *ě (from the diphthong *aj) became *dz. The affricate survives in the oldest Old Church Slavonic texts, in Lechitic (Polish nodze) and in the Ohrid dialects of Macedonian; elsewhere it became [z]. Latvian separately turned *g into dz before front vowels (dzīvs, dzert), where Lithuanian keeps g.",
  "phoneticEffects": "Palatalization, Assibilation, Affrication",
  "languageExamples": [
    {
      "language": "Old Church Slavonic",
      "languageFamily": "South Slavic",
      "examples": [
        {
          "from": "Proto-Slavic *gvězda 'star'",
          "to": "ѕвѣзда dzvězda",
          "note": "Second palatalization; South Slavic applies it across medial *v, while West Slavic keeps Polish gwiazda, Czech hvězda."
        },
        {
          "from": "Proto-Balto-Slavic *gailas",
          "to": "ѕѣло dzělo 'very'",
          "note": "Via Proto-Slavic *dzělъ 'vehement'; the letter ѕ (dzělo) records the affricate."
        }
      ]
    },
    {
      "language": "Proto-Slavic to Polish",
      "languageFamily": "West Slavic",
      "examples": [
        {
          "from": "Proto-Slavic *nogě (dat./loc. sg. of *noga 'leg')",
          "to": "nodze",
          "note": "Second palatalization: *g before *ě became [dz]; Lechitic keeps the affricate."
        },
        {
          "from": "Proto-Slavic *dorgě (dat./loc. sg. of *dorga 'road')",
          "to": "drodze",
          "note": "Same second-palatalization reflex before *ě."
        }
      ]
    },
    {
      "language": "Latvian",
      "languageFamily": "East Baltic",
      "examples": [
        {
          "from": "Proto-Balto-Slavic *gīˀwás 'alive' (Lithuanian gývas)",
          "to": "dzīvs [dzîːws]",
          "note": "Velar assibilation before a front vowel."
        },
        {
          "from": "Proto-Baltic *ger- 'to drink' (Lithuanian gérti)",
          "to": "dzert [ˈdzɛ̂ɾt]"
        },
        {
          "from": "Proto-Balto-Slavic *gied- 'to sing' (Lithuanian giesmė)",
          "to": "dziesma 'song'"
        }
      ]
    }
  ],
