  "preamble": "The velar nasal [ŋ] became the labio-velar glide [w] word-initially in two branches of Tungusic. In Manchu, Proto-Tungusic initial *ŋ gave g before most vowels but w in a small set of words (wa 'smell', we 'who', wantaha 'fir'); the Amur languages Nanai, Ulch and Orok share w in 'fir' and 'smell' while keeping ŋ in 'hand'. The change keeps the velar place but loses nasality and occlusion and adds lip rounding.",
  "phoneticEffects": "Denasalization, Lenition, Labialization",
  "languageExamples": [
    {
      "language": "Proto-Tungusic to Manchu",
      "languageFamily": "Jurchenic",
      "examples": [
        {
          "from": "*ŋō 'smell'",
          "to": "Manchu wa",
          "note": "Evenki and Even ӈо̄ keep ŋ."
        },
        {
          "from": "*ŋāŋta 'fir tree'",
          "to": "Manchu wantaha",
          "note": "Even ӈаӈта, Negidal ӈа̄ӈта (ŋāŋta) keep ŋ."
        },
        {
          "from": "*ŋüi 'who'",
          "to": "Manchu we",
          "note": "Evenki and Even ӈӣ keep ŋ; elsewhere Manchu has g- (gala 'hand' < *ŋāla)."
        }
      ]
    },
    {
      "language": "Proto-Tungusic to Nanai, Ulch and Orok",
      "languageFamily": "Southern Tungusic",
      "examples": [
        {
          "from": "*ŋāŋta 'fir tree'",
          "to": "Nanai ваӈта, Ulch ваӈта (waŋta), Orok ваӈта (waŋta)",
          "note": "Udege ӈаӈта (ŋaŋta) keeps ŋ."
        },
        {
          "from": "*ŋō 'smell'",
          "to": "Nanai ва̄нколи, Ulch ва̄коли (wākoli)",
          "note": "Orok ӈоси and Oroch ӈокки (ŋokki) keep ŋ."
        },
        {
          "from": "*ŋōlimi 'long'",
          "to": "Ulch валми̇",
          "note": "Ulch also has волми̇ and ӈолми̇; Nanai ӈонэмэ and Orok ӈоними keep ŋ."
        }
      ]
    }
