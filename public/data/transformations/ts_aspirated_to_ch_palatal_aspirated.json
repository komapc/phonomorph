{
  "fromId": "ts_aspirated",
  "toId": "ch_palatal_aspirated",
  "preamble": "The aspirated dental affricate [tsʰ] palatalizes to the aspirated alveolo-palatal [tɕʰ] before high front vowels and the glide [j]. In Mandarin and in Northern Wu (Shanghainese) Middle Chinese tsʰ- before i/y merged with palatalized aspirated velars (the jiān–tuán merger), while Cantonese keeps [tsʰ]. Seoul Korean shows the same development of Middle Korean apical ㅊ [tsʰ], which northwestern (Pyongyang) speech still keeps as [tsʰ].",
  "phoneticEffects": "Palatalization, Merger",
  "languageExamples": [
    {
      "language": "Mandarin Chinese",
      "languageFamily": "Sinitic",
      "examples": [
        {
          "from": "Middle Chinese 親 tshin 'kin'",
          "to": "qīn [tɕʰin]"
        },
        {
          "from": "Middle Chinese 清 tshjeng 'clear'",
          "to": "qīng [tɕʰiŋ]"
        },
        {
          "from": "Middle Chinese 七 tshit 'seven'",
          "to": "qī [tɕʰi⁵⁵]",
          "note": "Cantonese cat1 [tsʰɐt̚⁵] keeps the dental affricate."
        }
      ]
    },
    {
      "language": "Shanghainese",
      "languageFamily": "Sinitic",
      "examples": [
        {
          "from": "Middle Chinese 七 tshit 'seven'",
          "to": "[tɕʰiɪʔ⁵⁵]",
          "note": "Wu shares the palatalization of dental sibilants before front vowels."
        },
        {
          "from": "Middle Chinese 千 tshen 'thousand'",
          "to": "[t͡ɕʰi⁵³]"
        }
      ]
    },
    {
      "language": "Korean (Seoul)",
      "languageFamily": "Koreanic",
      "examples": [
        {
          "from": "Middle Korean 七 chílq/chíl 'seven' (ch = apical [tsʰ])",
          "to": "칠 [tɕʰiɭ]",
          "note": "Middle Korean affricates were apical, as in modern northwestern dialects; Pyongyang speech still pronounces ㅊ as [tsʰ]."
        },
        {
          "from": "Middle Korean 千 쳔 chyèn 'thousand'",
          "to": "천 cheon"
        }
      ]
    }
  ],
