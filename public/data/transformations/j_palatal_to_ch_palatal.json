{
  "fromId": "j_palatal",
  "toId": "ch_palatal",
  "preamble": "Devoicing of the voiced alveolo-palatal affricate [d͡ʑ] to [t͡ɕ]. The clear case is Polish final obstruent devoicing. Word-finally it merges dź/dzi [d͡ʑ] with ć [t͡ɕ], so a stem consonant is voiced [d͡ʑ] before a vowel and voiceless [t͡ɕ] at the end of the word (łodzi [ˈwɔ.d͡ʑi] ~ łódź [wut͡ɕ]). The change is rare across languages, mainly because few languages have /d͡ʑ/ as a phoneme.",
  "phoneticEffects": "Devoicing, Final Devoicing, Neutralization",
  "languageExamples": [
    {
      "language": "Polish",
      "languageFamily": "West Slavic",
      "examples": [
        {
          "from": "łodzi [ˈwɔ.d͡ʑi] 'boat (gen. sg.)'",
          "to": "łódź [ˈwut͡ɕ] 'boat'",
          "note": "Word-final devoicing; the final consonant of łódź is identical to that of words spelled -ć"
        },
        {
          "from": "żołędzia [ʐɔˈwɛɲ.d͡ʑa] 'acorn (gen. sg.)'",
          "to": "żołądź [ˈʐɔ.wɔɲt͡ɕ] 'acorn'",
          "note": "Same alternation after a nasal"
        },
        {
          "from": "chodzić [ˈxɔ.d͡ʑit͡ɕ] 'to walk'",
          "to": "chodź [ˈxɔt͡ɕ] 'come!'",
          "note": "The imperative is homophonous with choć 'although'"
        }
      ]
    }
  ],
