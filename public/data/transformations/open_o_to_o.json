          "from": "Late Middle English boat /ɔː/ (1400)",
          "to": "/oː/ (1600), later /oʊ/"
        },
        {
          "from": "Late Middle English whole, old with /ɔː/",
          "to": "/oː/",
          "note": "Second phase of the Great Vowel Shift: after 1600 the open-mid vowels /ɛː ɔː/ were raised to close-mid /eː oː/."
        }
      ]
    },
