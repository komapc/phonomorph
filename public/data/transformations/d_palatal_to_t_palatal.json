    {
      "language": "Khmer",
      "languageFamily": "Khmeric",
      "examples": [
        {
          "from": "Old Khmer jeṅ, jœṅa [ɟ-] 'leg, foot' (Proto-Mon-Khmer *ɟuŋ)",
          "to": "ជើង /cəːŋ/",
          "note": "Old Khmer /ɟ/ merged with /c/; the word keeps the high-register vowel of the formerly voiced series."
        },
        {
          "from": "Old Khmer ជិះ jiḥ /ɟɪh/ 'to ride, straddle'",
          "to": "ជិះ /cih/"
        },
