{
  "fromId": "b_palatalized",
  "toId": "p_palatalized",
  "preamble": "The voiced palatalized bilabial stop [bʲ] becomes voiceless [pʲ] while keeping its palatalization when a language combines word-final soft labials with final devoicing. Russian is the clear case: soft [bʲ] in голубя (gen.) alternates with final [pʲ] in голубь [ˈɡoɫʊpʲ], and the imperative ослабь [ɐsˈɫapʲ] devoices the soft stem-final labial of ослабить. Most other Slavic languages hardened final soft labials before devoicing, so they show plain [p] instead (Polish gołąb, gen. gołębia).",
  "phoneticEffects": "Devoicing, Final Devoicing",
  "languageExamples": [
    {
      "language": "Russian",
      "languageFamily": "East Slavic",
      "examples": [
        {
          "from": "голубя gólubja 'pigeon' (gen.), soft [bʲ]",
          "to": "голубь [ˈɡoɫʊpʲ] (nom.)",
          "note": "Word-final devoicing turns soft [bʲ] into [pʲ] without loss of palatalization."
        },
        {
          "from": "дроби dróbi (gen.), soft [bʲ]",
          "to": "дробь [dropʲ] 'fraction, small shot'",
          "note": "Same word-final devoicing of the soft labial."
        },
        {
          "from": "ряби (gen.), soft [bʲ]",
          "to": "рябь [rʲæpʲ] 'ripple'"
        },
        {
          "from": "глуби (gen.), soft [bʲ]",
          "to": "глубь [ɡɫupʲ] 'depth'"
        },
        {
          "from": "ослабить 'to weaken', stem-final soft [bʲ]",
          "to": "ослабь [ɐsˈɫapʲ] (imperative)",
          "note": "The imperative ending -ь leaves the soft labial word-final, where it devoices."
        }
      ]
    }
  ],
