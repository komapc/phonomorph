      "language": "Russian",
      "languageFamily": "East Slavic",
      "isAllophone": true,
      "examples": [
        {
          "from": "вода /voˈda/ 'water' (cf. stressed во́ды [ˈvodɨ])",
          "to": "[vʌˈda]",
          "note": "Akanye: unstressed /o/ immediately before the stress merges with /a/; often transcribed [ɐ]."
        },
        {
          "from": "мороз /moˈroz/ 'frost'",
          "to": "[mʌˈros]",
          "note": "Pretonic /o/ unrounds; the stressed /o/ is kept."
