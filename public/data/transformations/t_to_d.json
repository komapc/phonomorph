          "to": "cadena [d]",
          "note": "Latin [t] voices to [d] in Spanish."
        },
        {
          "from": "rota",
          "to": "roue [ø]",
          "note": "French historical voicing [t] > [d], then further lenition and elision."
        }
      ]
