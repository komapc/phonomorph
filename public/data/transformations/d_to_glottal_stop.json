      "language": "English (Cockney/Estuary)",
      "languageFamily": "Germanic",
      "examples": [
        {
          "from": "good night [d]",
          "to": "[ɡʊʔ naɪʔ]",
          "note": "The final voiced stop is replaced by a glottal catch in connected speech."
        }
      ]
    },
    {
      "language": "Lhasa Tibetan",
