  "preamble": "The shift from the velar nasal [ŋ] to the voiced velar stop [ɡ] is a process of denasalization and fortition. It involves raising the soft palate to block nasal airflow, converting a nasal sonorant into an oral obstruent while maintaining the velar place of articulation.",
  "phoneticEffects": "Denasalization, Fortition",
  "languageExamples": [
    {
      "language": "Southern Min (Hokkien)",
      "languageFamily": "Min",
      "examples": [
        {
          "from": "月 'moon', Proto-Min *ŋ- (Old Chinese *[ŋ]ʷat)",
          "to": "ge̍h /ɡeʔ⁴/ (Xiamen), goe̍h",
          "note": "Proto-Min *ŋ denasalized to g before oral vowels in Southern Min; Fuzhou, Jian'ou and Jianyang keep ŋ."
        },
        {
          "from": "銀 'silver', Proto-Min *ŋ- (Old Chinese *ŋrə[n])",
          "to": "gîn, gûn /ɡun²⁴/ (Xiamen)"
        },
        {
          "from": "鵝 'goose', Proto-Min *ŋ- (Old Chinese *ŋˤa[r])",
          "to": "gô /ɡo²⁴/ (Xiamen)"
        },
        {
          "from": "牛 'ox', Old Chinese *[ŋ]ʷə (Zhengzhang *ŋʷɯ)",
          "to": "gû /ɡu²⁴/ (Xiamen)"
        }
      ]
    },
