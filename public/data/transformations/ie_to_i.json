{
  "fromId": "ie",
  "toId": "i",
  "preamble": "A diphthong ie simplifies to a long or short i, keeping the onset and dropping the lower offglide. Early New High German monophthongized Middle High German ie (liep > lieb [liːp]); Old Spanish reduced ie to i before palatal /ʎ/ (castiello > castillo); late Old Czech turned ie into í (viera > víra); and Kildin Sami monophthongized Proto-Samic *ie to ī before a second-syllable *ë.",
  "phoneticEffects": "Monophthongization, Vowel Reduction, Diphthong Simplification",
  "languageExamples": [
    {
      "language": "German",
      "languageFamily": "Germanic",
      "examples": [
        {
          "from": "Middle High German liep [liəp] 'dear'",
          "to": "lieb [liːp]",
          "note": "Early New High German monophthongization of /iə yə uə/ to /iː yː uː/."
        },
        {
          "from": "Middle High German brief [briəf] 'letter'",
          "to": "Brief [bʁiːf]"
        }
      ]
    },
    {
      "language": "Old Spanish",
      "languageFamily": "Romance",
      "examples": [
        {
          "from": "castiello",
          "to": "castillo",
          "note": "Before palatal /ʎ/ the diphthong ie reduced to i in the suffix -iello > -illo."
        },
        {
          "from": "siella 'chair, saddle'",
          "to": "silla"
        },
        {
          "from": "martiello 'hammer'",
          "to": "martillo"
        }
      ]
    },
    {
      "language": "Kildin Sami",
      "languageFamily": "Samic",
      "examples": [
        {
          "from": "Proto-Samic *kietë 'hand'",
          "to": "кӣдт, with ӣ [iː]",
          "note": "Kildin monophthongized Proto-Samic *ie to long ī before second-syllable *ë; before *ō it gives е̄ [eː] instead. Northern Sami keeps giehta."
        },
        {
          "from": "Proto-Samic *kielë 'tongue'",
          "to": "кӣлл",
          "note": "Same change; compare Northern Sami giella."
        },
        {
          "from": "Proto-Samic *liemë 'broth'",
          "to": "лӣмм",
          "note": "Same change; compare Northern Sami liepma."
        },
        {
          "from": "Proto-Samic *nierë 'cheek'",
          "to": "нӣрр",
          "note": "Same change; compare Northern Sami nierra."
        }
      ]
    },
    {
      "language": "Czech",
      "languageFamily": "West Slavic",
      "examples": [
        {
          "from": "Old Czech viera 'faith'",
          "to": "víra, with í [iː]",
          "note": "Late Old Czech monophthongized ie to í (and uo to ú)."
        },
        {
          "from": "Old Czech miera 'measure'",
          "to": "míra"
        },
        {
          "from": "Old Czech bielý 'white'",
          "to": "bílý"
        }
      ]
    }
