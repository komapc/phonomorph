          "from": "Proto-Semitic *śimaʔl- 'left'",
          "to": "šumēlum 'left side'",
          "note": "Akkadian merged *ś with *š."
        },
        {
          "from": "Proto-Semitic *ʕaśr- 'ten'",
          "to": "ešrum 'ten'"
        }
