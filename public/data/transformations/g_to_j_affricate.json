{
  "fromId": "g",
  "toId": "j_affricate",
  "preamble": "Palatalization of the voiced velar stop [g] to the postalveolar affricate [dʒ] parallels k > tʃ. It occurred before front vowels from Latin to Italian (gelu > gelo), in Old English before or after palatal environments (Proto-Germanic *brugjō > brycġ 'bridge'), and unconditionally in Arabic, where Proto-Semitic *g became the affricate jīm (Proto-West Semitic *gamal- > jamal 'camel').",
  "phoneticEffects": "Palatalization, Affrication, Velar Fronting",
  "languageExamples": [
    {
      "language": "Italian",
      "languageFamily": "Italo-Romance",
      "examples": [
        {
          "from": "Latin gelū 'frost' [g]",
          "to": "gelo /ˈd͡ʒɛ.lo/",
          "note": "Latin /g/ before a front vowel became [dʒ]."
        },
        {
          "from": "Latin gentem [g]",
          "to": "gente [ˈd͡ʒɛnte]",
          "note": "Latin /g/ before /e/."
        }
      ]
    },
    {
      "language": "Old English",
      "languageFamily": "Germanic",
      "examples": [
        {
          "from": "Proto-Germanic *brugjō (Proto-West Germanic *bruggju)",
          "to": "brycġ /bryd͡ʒ/ > bridge",
          "note": "The geminate velar created by West Germanic gemination before *j was palatalized and affricated."
        }
      ]
    },
    {
      "language": "Arabic",
      "languageFamily": "Semitic",
      "examples": [
        {
          "from": "Proto-West Semitic *gamal- 'camel'",
          "to": "جَمَل /d͡ʒa.mal/",
          "note": "Jīm is [ɡ] in most other Semitic languages but was palatalized to an affricate in Arabic; Egyptian Arabic keeps /ɡamal/."
        }
      ]
    },
    {
      "language": "Somali",
      "languageFamily": "Lowland East Cushitic",
      "examples": [
        {
          "from": "Proto-Somaloid *git 'path' (Afar gita keeps /g/)",
          "to": "jid [ˈd͡ʒɪ̄ʔ͡t] (southern), [ˈt͡ʃʰɪ̄ʔ͡t] (northern) 'road, path'"
        },
        {
          "from": "Proto-Somaloid *gilib 'knee' (Proto-Cushitic *gʷilb-/*gulb-; Afar gulub)",
          "to": "jilib 'knee'",
          "note": "Palatalization before *i; *g stays before other vowels, as in geed 'tree' and gees 'horn'."
        }
      ]
    }
  ],
