  "preamble": "The shift from the voiceless alveolar stop [t] to the voiced dental fricative [ð] is a multi-stage lenition process. It typically involves an intermediate voiced stop stage [d], which then spirantizes in intervocalic positions to allow continuous airflow. This shift is a key historical link in Germanic and Romance phonology.",
  "phoneticEffects": "Lenition, Voicing, Spirantization, Consonant Gradation",
  "languageExamples": [
    {
      "language": "Latin to Spanish",
      "languageFamily": "Romance",
      "examples": [
        {
          "from": "vita [t]",
          "to": "vida [ð]",
          "note": "Intervocalic lenition where the stop voiced and then spirantized into a fricative/approximant."
        },
        {
          "from": "catena",
          "to": "cadena [ð]"
        }
      ]
    },
    {
      "language": "Proto-Bantu to Kikuyu",
      "languageFamily": "Bantu",
      "examples": [
        {
          "from": "*-tátʊ̀ 'three'",
          "to": "-thatu [ðatu]",
          "note": "Kikuyu regularly lenites Proto-Bantu *t to [ð] (spelled th)"
        }
      ]
    },
    {
      "language": "Northern Sami (Consonant Gradation)",
      "languageFamily": "Samic",
      "examples": [
        {
          "from": "giehta [ˈkie̯hta] 'hand' (strong grade)",
          "to": "gieđa [ˈkie̯ða] (genitive, weak grade)",
          "note": "Weak-grade single *t spirantized to [ð] in Northern Sami; Lule Sami has gieda with a stop."
        },
        {
          "from": "boahtit 'to come' (strong grade ht)",
          "to": "boađán 'I come' (weak grade đ)",
          "note": "From Proto-Samic *poatētēk; the alternation ht ~ đ is one of the regular quantity 2 ~ 1 gradation pairs."
        }
      ]
    },
    {
      "language": "Danish",
      "languageFamily": "North Germanic",
      "examples": [
        {
          "from": "Old Norse gata 'street' (Old Danish gatæ)",
          "to": "gade /ɡaːðə/"
        },
        {
          "from": "Old Norse bíta 'to bite' (Old Danish bitæ)",
          "to": "bide /biːðə/"
        },
        {
          "from": "Old Norse hvítr 'white'",
          "to": "hvid /ˈviːˀð/"
        },
        {
          "from": "Old Norse matr 'food'",
          "to": "mad /mað/"
        },
        {
          "from": "Old Norse fótr 'foot'",
          "to": "fod [ˈfoˀð]",
          "note": "Danish lenition weakened postvocalic t to the 'soft d' /ð/, still spelled d; Swedish and Norwegian keep t (gata, bita, vit, mat, fot)."
        }
