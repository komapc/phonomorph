  "preamble": "The shift from the voiceless bilabial stop [p] to its voiced counterpart [b] is a classic example of voicing lenition. In Romance, it occurs in intervocalic positions where the stop adopts the voicing of surrounding vowels (Latin lupus > Spanish lobo); Western Armenian, Middle Persian, Pashto and Danish show the same voicing historically. As synchronic allophony, Korean lax /p/ and Malayalam non-geminate /p/ are voiced [b] between vowels.",
  "phoneticEffects": "Voicing, Lenition",
  "languageExamples": [
    {
      "language": "Latin to Spanish/French",
      "languageFamily": "Romance",
      "examples": [
        {
          "from": "lupus",
          "to": "lobo [b]",
          "note": "Latin intervocalic [p] voices to [b] in Spanish."
        },
        {
          "from": "capra",
          "to": "cabra [b]",
          "note": "Latin [p] before [r] voices to [b] in Spanish."
        },
        {
          "from": "sapere",
          "to": "savoir [v]",
          "note": "French historical voicing [p] > [b], then further lenition to [v]."
        }
      ]
    },
    {
      "language": "Malayalam",
      "languageFamily": "Dravidian",
      "isAllophone": true,
      "examples": [
        {
          "from": "കോപം kōpam 'anger'",
          "to": "[koːbɐm]",
          "note": "Non-geminate voiceless stops are voiced between vowels and after nasals, as in Tamil; geminate /pp/ stays voiceless."
        },
        {
          "from": "രൂപം rūpam 'form, shape'",
          "to": "[ɾuːbɐm]"
        },
        {
          "from": "ശാപം śāpam 'curse'",
          "to": "[ʃaːbɐm]"
        }
      ]
    },
