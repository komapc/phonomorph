  "preamble": "Palatalization of the velar fricative [x] to the postalveolar [ʃ] before front vowels and *j. It is the outcome of *x in the Slavic first palatalization (*x > *xʲ > *š), which reverses the ruki retraction of *š to *x.",
  "phoneticEffects": "Palatalization, Fronting",
  "languageExamples": [
    {
      "language": "Proto-Slavic (First Palatalization)",
      "languageFamily": "Slavic",
      "examples": [
        {
          "from": "Germanic *helm- 'helmet' > Proto-Slavic *xelmъ",
          "to": "*šelmъ > Old Church Slavonic шлѣмъ šlěmŭ, Russian шлем",
          "note": "*x became *š before the front vowel *e."
        },
        {
          "from": "earlier *slyxěti 'to hear' (cf. Russian слух 'hearing')",
          "to": "*slyšati, Russian слышать",
          "note": "*x became *š before the front vowel *ě, which then became *a after the new palatal."
        },
        {
          "from": "*grěxъ 'sin' + *-iti",
          "to": "*grěšiti 'to err, sin', Russian грешить",
          "note": "Root-final *x became *š before the front vowel *i."
        },
        {
          "from": "*duxъ 'spirit' + *-ja",
          "to": "*duša 'soul', Russian душа",
          "note": "*x became *š before *j."
        }
      ]
    }
  ],
  "certainty": 5,
  "commonality": 2,
