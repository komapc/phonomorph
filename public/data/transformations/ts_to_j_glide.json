{
  "fromId": "ts",
  "toId": "j_glide",
  "preamble": "Lenition of the voiceless alveolar affricate /ts/ to the palatal glide [j] between vowels is a regular sound law of Northern Uto-Aztecan, formulated by Manaster Ramer (1992) as *-c- > -y-. Proto-Uto-Aztecan *c (= /ts/) survives in Southern Uto-Aztecan (Mayo meecha 'moon', Huichol métsa) but appears as y in Hopi and Tübatulabal (and in the Takic languages).",
  "phoneticEffects": "Lenition, Gliding, Deaffrication",
  "languageExamples": [
    {
      "language": "Proto-Uto-Aztecan to Hopi",
      "languageFamily": "Northern Uto-Aztecan",
      "examples": [
        {
          "from": "Proto-Uto-Aztecan *mïcaC-wït 'moon' (augmentative)",
          "to": "Hopi muuyaw 'moon'",
          "note": "Hopi ⟨y⟩ is /j/; Mayo meecha, Huichol métsa and Classical Nahuatl mētztli keep the affricate."
        },
        {
          "from": "Proto-Uto-Aztecan *ʼïca 'to plant'",
          "to": "Hopi uuya 'to plant'",
          "note": "Yaqui ʼéeča, Tarahumara ichá keep an affricate."
        }
      ]
    },
    {
      "language": "Proto-Uto-Aztecan to Tübatulabal",
      "languageFamily": "Northern Uto-Aztecan",
      "examples": [
        {
          "from": "Proto-Uto-Aztecan *kicu-ta 'fish' (absolutive)",
          "to": "Tübatulabal kuyu·l"
        },
        {
          "from": "Proto-Uto-Aztecan *mïcaC-ta 'moon' (absolutive)",
          "to": "Tübatulabal mɨ·yal 'month'"
        }
      ]
    }
  ],
