{
  "fromId": "j_affricate",
  "toId": "ch",
  "preamble": "Devoicing of the voiced postalveolar affricate [dʒ] to its voiceless counterpart [tʃ]: place and manner stay the same and only voicing is lost. It comes mainly from final obstruent devoicing. In languages that have both affricates and neutralize voicing at the end of a word, /dʒ/ surfaces as [tʃ] word-finally and stays [dʒ] before a vowel. Turkish applied it to Arabic and Persian loanwords (tāj > taç, birinj > pirinç). Catalan shows it in masculine ~ feminine adjective pairs (lleig ~ lletja).",
  "phoneticEffects": "Devoicing, Final Devoicing, Neutralization",
  "languageExamples": [
    {
      "language": "Turkish",
      "languageFamily": "Oghuz",
      "examples": [
        {
          "from": "Arabic/Persian tāj 'crown' (Turkish tac- [tɑːd͡ʒ] before vowel-initial suffixes, e.g. tacı)",
          "to": "taç /tɑt͡ʃ/ 'crown'",
          "note": "The loanword's final /dʒ/ is devoiced word-finally and kept voiced before vowel-initial suffixes"
        },
        {
          "from": "Classical Persian birinj 'rice'",
          "to": "pirinç /piˈɾint͡ʃ/ 'rice'",
          "note": "Final /dʒ/ of the Persian source is devoiced in Ottoman and modern Turkish"
        }
      ]
    },
    {
      "language": "Catalan",
      "languageFamily": "Occitano-Romance",
      "examples": [
        {
          "from": "lletja [ˈʎe.d͡ʒə] 'ugly' (feminine)",
          "to": "lleig [ˈʎet͡ʃ] 'ugly' (masculine)",
          "note": "The feminine keeps the voiced affricate between vowels; in the masculine it is word-final and devoiced"
        },
        {
          "from": "mitja [ˈmi.d͡ʒə] 'half' (feminine, < Latin media)",
          "to": "mig [ˈmit͡ʃ] 'half, middle' (masculine)",
          "note": "Same alternation, from Latin medius"
        }
      ]
    }
  ],
