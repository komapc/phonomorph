          "from": "Proto-Polynesian *fale 'house'",
          "to": "‘are [ʔare]",
          "note": "Cook Islands dialect table: ‘are in Rarotonga, Aitutaki and Mangaia beside fare (Manihiki) and hare (Tongareva)."
        },
        {
          "from": "Proto-Polynesian *fenua 'land'",
          "to": "‘enua [ʔenua]"
        },
        {
          "from": "Proto-Polynesian *fetuʔu 'star'",
          "to": "‘ētū [ʔeːtuː]"
        },
        {
          "from": "Proto-Polynesian *fafine 'woman'",
          "to": "va‘ine [vaʔine]",
          "note": "The initial *f became [v], the medial *f became [ʔ]."
        }
