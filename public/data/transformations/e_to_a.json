    {
      "language": "Chukchi",
      "languageFamily": "Chukotko-Kamchatkan",
      "examples": [
        {
          "from": "/e₂/ (recessive)",
          "to": "[a] (in dominant vowel context)",
          "note": "Chukchi vowel harmony: 'recessive' vowel /e₂/ lowers and backs to [a] when a 'dominant' vowel (back or lower vowels /a, o, e₂/ or /u/) appears in the word. Height-based harmony system where dominants override recessives. This is a synchronic process, not historical change, maintaining allophonic variation within paradigms."
        }
      ]
    },
