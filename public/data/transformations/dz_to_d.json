      "languageFamily": "Southwestern Iranian",
      "examples": [
        {
          "from": "Proto-Iranian *ajám 'I'",
          "to": "𐎠𐎭𐎶 adam",
          "note": "Parthian has az and Pashto zə with z."
        },
        {
          "from": "Proto-Iranian *jástah 'hand'",
          "to": "𐎭𐎿𐎫 dasta",
          "note": "Continued by Middle Persian dast, Persian dast."
        },
        {
          "from": "Proto-Iranian *jráyah 'sea'",
          "to": "𐎭𐎼𐎹 drayah",
          "note": "Continued by Middle Persian drayāb, Persian daryā."
        }
      ]
    }
