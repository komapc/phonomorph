          "to": "אָתוֹן ʾāṯôn 'she-ass'"
        },
        {
          "from": "Proto-Semitic *ṭiḥāl- 'spleen'",
          "to": "טְחוֹל təḥôl 'spleen'"
        },
        {
          "from": "Proto-Semitic *tihām- 'sea, abyss'",
          "to": "תְּהוֹם təhôm 'abyss, deep'"
        },
        {
          "from": "Proto-Semitic *ṯamāniy- 'eight'",
          "to": "שְׁמוֹנָה šəmônâ 'eight'"
        },
        {
          "from": "Proto-Semitic *kinnār- 'lyre'",
          "to": "כִּנּוֹר kinnôr 'lyre'",
          "note": "The Canaanite shift turned Proto-Northwest-Semitic *ā into ō; Amarna-period records date it to the mid-2nd millennium BCE."
        }
      ]
    },
