      "languageFamily": "Canaanite",
      "examples": [
        {
          "from": "Proto-Semitic *ḥimār- 'donkey'",
          "to": "חֲמוֹר ḥămôr 'donkey'",
          "note": "Arabic keeps ā in ḥimār; Ugaritic has ḥmr."
        },
        {
