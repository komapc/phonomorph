{
  "fromId": "z",
  "toId": "zh_palatal",
  "preamble": "Palatalization of the voiced alveolar fricative [z] to the voiced alveolo-palatal fricative [ʑ] before front vowels and /j/. In Polish, Proto-Slavic *z before a front vowel became the soft sibilant ź [ʑ], written ⟨zi⟩ before a vowel. In Japanese, /z/ before /i/ or /j/ is realized as an alveolo-palatal sibilant that alternates between the fricative [ʑ] and the affricate [dʑ]; the fricative is more frequent between vowels and in faster speech.",
  "phoneticEffects": "Palatalization",
  "languageExamples": [
    {
      "language": "Polish",
      "languageFamily": "West Slavic",
      "examples": [
        {
          "from": "Proto-Slavic *zima 'winter' (Old Polish zima)",
          "to": "zima /ˈʑi.ma/"
        },
        {
          "from": "Proto-Slavic *zelenъ 'green'",
          "to": "zielony /ʑɛˈlɔ.nɘ/"
        },
        {
          "from": "Proto-Slavic *zь̀rno 'grain' (Old Polish ziarno)",
          "to": "ziarno /ˈʑar.nɔ/",
          "note": "Proto-Slavic *z before a front vowel or front jer became the soft fricative ź [ʑ]; the voiceless counterpart *s gave ś [ɕ]."
        },
        {
          "from": "Proto-Slavic *zemľà 'earth'",
          "to": "ziemia /ˈʑɛ.mja/",
          "note": "Old Polish ziemia is given as /ʑɛːmʲa/."
        },
        {
          "from": "Proto-Slavic *zěvati 'to yawn' (cf. Russian зева́ть)",
          "to": "ziewać /ˈʑɛ.vat͡ɕ/"
        }
      ]
    },
    {
      "language": "Japanese",
      "languageFamily": "Japonic",
      "examples": [
        {
          "from": "/mozi/ 文字 'letter, character'",
          "to": "[modʑi ~ moʑi]"
        },
        {
          "from": "/ɡozjuː/ 五十 'fifty'",
          "to": "[ɡodʑɯː ~ ɡoʑɯː]",
          "note": "The fricative [ʑ] and the affricate [dʑ] are variants of the same sound; the affricate is favoured after a pause, after /N/ and after /Q/ (see z_to_j_palatal)."
        }
      ],
      "isAllophone": true,
      "context": "Before /i/ and /j/"
    }
  ],
