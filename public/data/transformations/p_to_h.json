{
  "fromId": "p",
  "toId": "h",
  "preamble": "The shift from the voiceless bilabial stop [p] to the glottal fricative [h] is a major form of debuccalization. It typically follows a lenition path where the stop first weakens to a bilabial fricative [ɸ] before losing its oral place of articulation entirely. In the Tapajós languages Kĩsêdjê and Tapayúna (Northern Jê), *p became h before rounded vowels and r, as in Kĩsêdjê ho 'bamboo'.",
  "phoneticEffects": "Debuccalization, Lenition",
  "languageExamples": [
    {
      "language": "Old Japanese to Modern Japanese",
      "languageFamily": "Japonic",
      "examples": [
        {
          "from": "pa [p] (Old Japanese)",
          "to": "ha [h] (Modern Japanese)",
          "note": "The entire /h/ series in modern Japanese historically derives from a bilabial stop /p/."
        }
      ]
    },
    {
      "language": "Proto-Indo-European to Proto-Celtic",
      "languageFamily": "Celtic",
      "examples": [
        {
          "from": "*pater (PIE)",
          "to": "athair [∅/h] (Irish)",
          "note": "PIE *p was regularly debuccalized and eventually lost in the Celtic branch."
        }
      ]
    },
    {
      "language": "Kannada",
      "languageFamily": "Dravidian",
      "examples": [
        {
          "from": "*paẓV- \"fruit\" [p]",
          "to": "ಹಣ್ಣು haṇṇu",
          "note": "Initial p- became h- in Kannada; Tamil பழம் paḻam and Telugu పండు paṇḍu keep p-."
        },
        {
          "from": "Old Kannada pasu \"cow\" [p] (from Prakrit)",
          "to": "ಹಸು hasu",
          "note": "The same shift applies to a Prakrit loan; Tamil பசு pacu keeps p-."
        }
      ]
    },
    {
      "language": "Proto-Bantu to Kinyarwanda / Nyamwezi",
      "languageFamily": "Bantu",
      "examples": [
        {
          "from": "*-páa 'give'",
          "to": "Kinyarwanda -ha",
          "note": "Debuccalization of *p, widespread in Great Lakes Bantu; cf. Swahili -pa"
        },
        {
          "from": "*-kúpɪ́ 'short'",
          "to": "Nyamwezi -guhɪ",
          "note": "*p > h, with Dahl's law voicing the initial *k"
        }
      ]
    },
    {
      "language": "Proto-Indo-European to Classical Armenian",
      "languageFamily": "Armenian",
      "examples": [
        {
          "from": "*ph₂tḗr 'father'",
          "to": "hayr",
          "note": "Initial *p > h before most vowels (via Proto-Armenian *hatir); cf. Latin pater"
        }
      ]
    },
    {
      "language": "Proto-Uto-Aztecan to Cora / Huichol",
      "languageFamily": "Uto-Aztecan",
      "examples": [
        {
          "from": "*pa 'water'",
          "to": "Cora hah; Huichol háa",
          "note": "Word-initial *p debuccalizes in Corachol"
        },
        {
          "from": "*pakaN 'reed'",
          "to": "Huichol háca"
        }
      ]
    },
    {
      "language": "Proto-Tungusic to Evenki / Even",
      "languageFamily": "Tungusic",
      "examples": [
