          "from": "Proto-Semitic *ṯūm- 'garlic'",
          "to": "Classical Syriac ܬܘܽܡܳܐ tūmā 'garlic'"
        },
        {
          "from": "Proto-Semitic *ṯabar- 'to break'",
          "to": "Syriac ܬܒܰܪ təḇar 'to break'"
        },
        {
          "from": "Proto-Semitic *θalāθ- (three)",
          "to": "Aramaic tlāθ",
          "note": "Aramaic shifted the interdental fricative to the dental stop [t]; the final ṯ of tlāṯ is the later post-vocalic spirant allophone of t, not a retained *θ."
        }
      ]
    },
