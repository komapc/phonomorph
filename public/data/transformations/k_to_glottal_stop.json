          "from": "Proto-Malayo-Polynesian *anak 'child'",
          "to": "anak [ˈʔa.naʔ]",
          "note": "Word-final /k/ is realized as a glottal stop in Standard Malay."
        },
        {
          "from": "Proto-Malayo-Polynesian *tasik 'sea'",
          "to": "tasik [ˈt̪a.siʔ] 'lake'"
