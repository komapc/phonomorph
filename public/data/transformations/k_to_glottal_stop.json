      "language": "Yucatec Maya",
      "languageFamily": "Mayan",
      "examples": [
        {
          "from": "nak [k] (to stop something)",
          "to": "nahkúuns [ʔ] (to support)",
          "note": "Word-final obstruents, including /k/, undergo debuccalization to /h/ or /ʔ/ at prosodic boundaries in Yucatec Maya. The stop loses its oral place of articulation, leaving only a laryngeal closure."
        },
        {
          "from": "Proto-Mayan *q and *k (non-K'ichean branches)",
          "to": "[k] or [kʼ]",
          "note": "In branches outside K'ichean-Mamean and Qʼanjobʼalan, Proto-Mayan uvular *q merged with velar /k/, which then underwent coda weakening including glottalization in Yucatecan."
        }
