{
  "fromId": "z",
  "toId": "sh",
  "preamble": "The voiced alveolar fricative [z] becomes the voiceless postalveolar fricative [ʃ] by regressive assimilation before /ʃ/: the [z] takes over both the place and the voicelessness of the following sibilant, giving a geminate [ʃː] or [ʃʃ]. Hungarian applies this obligatorily across morpheme boundaries (község [køʃːeːɡ] 'village'), Bulgarian does it at the prefix boundary of раз-/без- (разширя [rɐʃʃiˈrʲɤ]), and Ukrainian does it with the prefix з- (зшити [ˈʃːɪte] 'to sew together').",
  "phoneticEffects": "Regressive Assimilation, Devoicing, Sibilant Assimilation",
  "languageExamples": [
    {
      "language": "Hungarian",
      "languageFamily": "Ugric",
      "examples": [
        {
          "from": "köz 'interval, common' + -ség (/z/ + /ʃ/)",
          "to": "község [ˈkøʃːeːɡ] 'village, community'",
          "note": "z + s [ʃ] gives a geminate [ʃː]; the assimilation is regressive and obligatory within the word."
        },
        {
          "from": "ház 'house' + sor 'row' (/z/ + /ʃ/)",
          "to": "házsor [ˈhaːʃːor] 'row of houses'"
        }
      ]
    },
    {
      "language": "Bulgarian",
      "languageFamily": "South Slavic",
      "examples": [
        {
          "from": "раз- + ширя (/z/ + /ʃ/)",
          "to": "разширя [rɐʃʃiˈrʲɤ] 'to widen'",
          "note": "The prefix-final /z/ assimilates in place and voicing to the following /ʃ/."
        },
        {
          "from": "без- + шум 'noise' (/z/ + /ʃ/)",
          "to": "безшумен [bɛʃˈʃumɛn] 'noiseless'"
        }
      ]
    },
    {
      "language": "Ukrainian",
      "languageFamily": "East Slavic",
      "examples": [
        {
          "from": "з- + шити 'to sew' (/z/ + /ʃ/)",
          "to": "зшити [ˈʃːɪte] 'to sew together'",
          "note": "Word-initial prefix з- merges with following ш into a geminate [ʃː]; inside the word роз-/без- before ш only shift place, to [ʒʃ] (розшук [ˈrɔʒʃʊk])."
        },
        {
          "from": "з- + шивати (/z/ + /ʃ/)",
          "to": "зшивати [ʃːeˈʋate] 'to sew together (impf.)'"
        }
      ]
    }
  ],
