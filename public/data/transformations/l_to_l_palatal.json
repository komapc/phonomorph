{
  "fromId": "l",
  "toId": "l_palatal",
  "preamble": "Palatalization of the alveolar lateral [l] to the palatal lateral [ʎ], usually triggered by a following [j] or high front vowel. It produced Italian gli and Portuguese lh from Latin -lj-, South Slavic lj from Proto-Slavic *lj, and Catalan initial ll- from Latin l-; Modern Greek shows the same change synchronically before [i] + vowel.",
  "phoneticEffects": "Palatalization, Lateral Palatalization",
  "languageExamples": [
    {
      "language": "Italian",
      "languageFamily": "Italo-Romance",
      "examples": [
        {
          "from": "Latin fīlia [lj] 'daughter'",
          "to": "figlia [ˈfiʎʎa]",
          "note": "Latin -lj- became the geminate palatal lateral spelled gli."
        }
      ]
    },
    {
      "language": "Portuguese",
      "languageFamily": "Ibero-Romance",
      "examples": [
        {
          "from": "Latin mulier [lj] 'woman'",
          "to": "mulher [muˈʎɛɾ]",
          "note": "The palatal lateral is spelled lh."
        }
      ]
    },
    {
      "language": "Catalan",
      "languageFamily": "Ibero-Romance",
      "examples": [
        {
          "from": "Latin lūna [l] 'moon'",
          "to": "lluna [ˈʎunə]",
          "note": "Catalan palatalized every word-initial Latin l-."
        }
      ]
    },
    {
      "language": "Serbo-Croatian",
      "languageFamily": "South Slavic",
      "examples": [
        {
          "from": "Proto-Slavic *volja 'will'",
          "to": "volja [ʋôʎa]",
          "note": "Proto-Slavic *lj became the palatal lateral spelled lj."
        }
      ]
    },
    {
      "language": "Greek",
      "languageFamily": "Hellenic",
      "examples": [
        {
          "from": "ήλιος /ˈi.li.os/ 'sun'",
          "to": "[ˈi.ʎos]",
          "note": "/l/ is realized as [ʎ] before unstressed /i/ + vowel, with the /i/ absorbed."
        }
      ]
    },
    {
      "language": "North Slope Iñupiaq",
      "languageFamily": "Inuit",
      "examples": [
        {
          "from": "Proto-Eskimo *ila 'part'",
          "to": "iḷa",
          "note": "After a 'strong' i, l became palatal ḷ /ʎ/; Northwest Alaska Iñupiaq, Inuktitut and Greenlandic keep ila."
        },
        {
          "from": "Proto-Inuit *ailaq 'dampness'",
          "to": "aiḷḷaq",
          "note": "A geminate is palatalized as a whole; Inuktitut has ailaq."
        }
      ]
    }
  ],
