{
  "fromId": "l",
  "toId": "l_palatal",
  "preamble": "Palatalization of the alveolar lateral [l] to the palatal lateral [ʎ], usually triggered by a following [j] or high front vowel. It produced South Slavic lj from Proto-Slavic *lj, and Catalan initial ll- from Latin l-; Modern Greek shows the same change synchronically before [i] + vowel.",
  "phoneticEffects": "Palatalization, Lateral Palatalization",
  "languageExamples": [
    {
      "language": "Catalan",
      "languageFamily": "Ibero-Romance",
      "examples": [
        {
          "from": "Latin lūna [l] 'moon'",
          "to": "lluna [ˈʎunə]",
          "note": "Catalan palatalized every word-initial Latin l-."
        },
        {
          "from": "Latin lingua 'tongue'",
          "to": "llengua 'tongue, language'"
        },
        {
          "from": "Latin locus 'place'",
          "to": "lloc [ˈʎɔk]"
        }
      ]
    },
    {
      "language": "Serbo-Croatian",
      "languageFamily": "South Slavic",
      "examples": [
        {
          "from": "Proto-Slavic *volja 'will'",
          "to": "volja [ʋôʎa]",
          "note": "Proto-Slavic *lj became the palatal lateral spelled lj."
        },
        {
          "from": "Proto-Balto-Slavic *kljaukjas 'key' (Proto-Slavic *kľučь)",
          "to": "ključ /kʎûːt͡ʃ/"
        }
      ]
    },
    {
      "language": "Greek",
      "languageFamily": "Hellenic",
      "examples": [
        {
          "from": "ήλιος /ˈi.li.os/ 'sun'",
          "to": "[ˈi.ʎos]",
          "note": "/l/ is realized as [ʎ] before unstressed /i/ + vowel, with the /i/ absorbed."
        },
        {
          "from": "μαλλί 'a hair' + plural -ιά (/l/ + nonsyllabic /i/)",
          "to": "μαλλιά /maˈʎa/ 'hair'"
        }
      ],
      "isAllophone": true
    },
    {
      "language": "North Slope Iñupiaq",
      "languageFamily": "Inuit",
      "examples": [
        {
          "from": "Proto-Eskimo *ila 'part'",
          "to": "iḷa",
          "note": "After a 'strong' i, l became palatal ḷ /ʎ/; Northwest Alaska Iñupiaq, Inuktitut and Greenlandic keep ila."
        },
        {
          "from": "Proto-Inuit *ailaq 'dampness'",
          "to": "aiḷḷaq",
          "note": "A geminate is palatalized as a whole; Inuktitut has ailaq."
        }
      ]
    }
  ],
