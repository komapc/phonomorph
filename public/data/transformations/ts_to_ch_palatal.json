    {
      "language": "Mandarin Chinese",
      "languageFamily": "Sinitic",
      "examples": [
        {
          "from": "Middle Chinese 精 tsjeng 'essence'",
          "to": "jīng [tɕiŋ⁵⁵]",
          "note": "Cantonese zing1 [tsɪŋ⁵⁵] keeps the dental affricate."
        },
        {
          "from": "Middle Chinese 津 tsin 'ford'",
          "to": "jīn [tɕin]"
        }
      ]
    },
