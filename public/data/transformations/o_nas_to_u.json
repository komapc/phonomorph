{
  "fromId": "o_nas",
  "toId": "u",
  "preamble": "Denasalization of the Proto-Slavic back nasal vowel *ǫ with raising to oral [u]. *ǫ is usually reconstructed as a nasalized back mid vowel (given as [õ] for Early West Slavic and as [ɤ̃ː ~ ɔ̃ː] for Proto-Slavic; this atlas files the back mid nasals under õ). Around the 10th century it became u in East Slavic, where ѫ merged with у before the earliest manuscripts, and in Czech and Slovak; Serbo-Croatian has the same reflex. Lechitic (Polish ręka, ząb) kept the vowel nasal, Slovene has o, Bulgarian ъ and Macedonian a.",
  "phoneticEffects": "Denasalization, Raising",
  "languageExamples": [
    {
      "language": "Russian",
      "languageFamily": "East Slavic",
      "examples": [
        {
          "from": "Proto-Slavic *rǫka 'hand, arm'",
          "to": "рука́ (ruká)",
          "note": "Old East Slavic texts show both рѫка and рука; Ukrainian and Belarusian also have рука́."
        },
        {
          "from": "Proto-Slavic *zǫbъ 'tooth'",
          "to": "зуб (zub)",
          "note": "Old East Slavic зѫбъ ~ зубъ; Ukrainian зуб."
        }
      ]
    },
    {
      "language": "Czech",
      "languageFamily": "West Slavic",
      "examples": [
        {
          "from": "Proto-Slavic *rǫka",
          "to": "ruka (Old Czech ruka)",
          "note": "Denasalization ǫ [õ] > u in Early West Slavic, dated to roughly the 10th century; Slovak also has ruka."
        },
        {
          "from": "Proto-Slavic *zǫbъ",
          "to": "zub",
          "note": "Contrast Polish ząb, which keeps a nasal vowel."
        }
      ]
    },
    {
      "language": "Serbo-Croatian",
      "languageFamily": "South Slavic",
      "examples": [
        {
          "from": "Proto-Slavic *rǫka",
          "to": "rúka / ру́ка"
        },
        {
          "from": "Proto-Slavic *zǫbъ",
          "to": "zȗb / зу̑б",
          "note": "Old Church Slavonic still writes the nasal: зѫбъ, рѫка."
        }
      ]
    }
  ],
