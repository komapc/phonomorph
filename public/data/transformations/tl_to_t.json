      "languageFamily": "Uto-Aztecan",
      "examples": [
        {
          "from": "*mətla- 'metate'",
          "to": "metat",
          "note": "*tl > t; Classical Nahuatl keeps metlatl"
        },
        {
          "from": "*pətla- 'mat'",
          "to": "petat",
          "note": "cf. Nahuatl petlatl"
        },
        {
          "from": "*kooloo- 'scorpion'",
          "to": "kulut",
          "note": "absolutive -tl > -t; cf. Nahuatl cōlōtl"
        },
