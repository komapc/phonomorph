      "examples": [
        {
          "from": "Proto-Indo-Iranian *bʰráHtā 'brother'",
          "to": "𐎲𐎼𐎠𐎫𐎠 brātā",
          "note": "Via Proto-Iranian *bráHtā; contrast Sanskrit bhrā́tṛ, which keeps the aspirate."
        }
      ]
    }
