  "fromId": "b_aspirated",
  "toId": "b",
  "preamble": "Loss of breathy-voiced release turns [bʱ] into plain [b]. It happened wholesale in several Indo-European branches, where PIE *bʰ merged with *b: Balto-Slavic (*bʰréh₂tēr > Old Church Slavonic bratrъ), Celtic (Old Irish bráthair) and Iranian (Old Persian brātā). Inside Indo-Aryan, which otherwise keeps [bʱ], it occurs conditionally through Grassmann's law, which deaspirates the first of two aspirates in successive syllables, as in reduplicated perfects.",
  "phoneticEffects": "Deaspiration, Merger, Dissimilation",
  "languageExamples": [
    {
      "language": "Sanskrit",
      "languageFamily": "Indo-Aryan",
      "examples": [
        {
          "from": "*bʱa-bʱūva (reduplicated perfect of bʱū- 'be, become')",
          "to": "babhūva",
          "note": "Grassmann's law: the reduplication syllable loses its aspiration before the following bʱ."
        },
        {
          "from": "*bʱu-bʱutsā- (desiderative of budh- 'wake, know')",
          "to": "बुभुत्सा bubhutsā- 'desire to know'",
          "note": "Same dissimilation in desiderative reduplication."
        }
      ]
    },
    {
      "language": "Old Church Slavonic",
      "languageFamily": "Slavic",
      "examples": [
        {
          "from": "PIE *bʰréh₂tēr 'brother'",
          "to": "братръ (bratrŭ), братъ (bratŭ)",
          "note": "Via Proto-Balto-Slavic *brā́ˀtē and Proto-Slavic *bràtrъ; *bʰ merged with *b throughout Balto-Slavic."
        }
      ]
    },
    {
      "language": "Proto-Indo-European to Proto-Celtic",
      "languageFamily": "Celtic",
      "examples": [
        {
          "from": "*bʰéreti 'carries'",
          "to": "*bereti",
          "note": "Old Irish beirid."
        },
        {
          "from": "*bʰréh₂tēr 'brother'",
          "to": "*brātīr",
          "note": "Old Irish bráthair, Proto-Brythonic *brọdr."
        },
        {
          "from": "*bʰeh₂nós 'shining'",
          "to": "*bānos 'white'",
          "note": "Old Irish bán."
        },
        {
          "from": "*bʰébʰrus 'beaver'",
          "to": "*bebrus",
          "note": "Both aspirates became plain *b; Old Breton beuer, Welsh befer."
        }
