  "toId": "h",
  "preamble": "Debuccalization of the voiceless alveolar fricative [s] to the glottal fricative [h] removes the oral constriction and leaves only glottal friction. It is one of the most frequent consonant lenitions: it defines the Iranian branch (*saptá > hapta), Ancient Greek (heptá vs Latin septem), Brythonic Celtic (Welsh hen vs Irish sean), Eastern Polynesian (hina vs Samoan sina), Buryat within Mongolic (hara 'moon'), and Igala within Yoruboid (hì 'cook'). In Quechuan, Proto-Quechuan *s became h in 'one' (*suk > huk) in several Quechua I varieties and in Ayacucho and Cuzco Quechua.",
  "phoneticEffects": "Debuccalization, Lenition",
  "languageExamples": [
    {
      "language": "Proto-Iranian / Avestan, Persian",
      "languageFamily": "Iranian",
      "examples": [
        {
          "from": "Proto-Indo-Iranian *saptá 'seven'",
          "to": "Proto-Iranian *haptá > Avestan hapta, Persian haft",
          "note": "Iranian debuccalized *s to *h except after *k, *n, *p, *t or before *t; Sanskrit keeps saptá."
        }
      ]
    },
    {
      "language": "Buryat",
      "languageFamily": "Mongolic",
      "examples": [
        {
          "from": "Proto-Mongolic *sara 'moon'",
          "to": "һара hara /hara/",
          "note": "Buryat regularly debuccalizes Proto-Mongolic *s to h; cf. Khalkha Mongolian сар sar."
        }
      ]
    },
    {
      "language": "Proto-Celtic to Welsh",
      "languageFamily": "Brythonic",
      "examples": [
        {
          "from": "*senos 'old'",
          "to": "hen",
          "note": "Regular initial *s- > h- before vowels in Brythonic; cf. Irish sean"
        },
        {
          "from": "*salanos 'salt'",
          "to": "halen",
          "note": "cf. Irish salann"
        }
      ]
    },
    {
      "language": "Proto-Polynesian to Hawaiian / Māori",
      "languageFamily": "Polynesian",
      "examples": [
        {
          "from": "*sina 'grey-haired'",
          "to": "Hawaiian, Māori hina",
          "note": "Eastern Polynesian *s > h; Samoan keeps sina"
        }
      ]
    },
    {
      "language": "Proto-Indo-European to Ancient Greek",
