          "to": "naaja",
          "note": "cf. Inuktitut naujak"
        }
      ]
    },
    {
      "language": "Latin (Late/Vulgar)",
      "languageFamily": "Italic",
      "examples": [
        {
          "from": "augustus 'of August'",
          "to": "agustus (nonstandard, attested from the mid–late 1st century CE)",
          "note": "Dissimilation of /au̯/ before a following /u/; continued in Italian and Spanish agosto, Romanian agust."
        },
        {
          "from": "auscultō 'listen'",
          "to": "ascultō (attested 2nd century CE)",
