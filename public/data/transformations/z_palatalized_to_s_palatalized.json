{
  "fromId": "z_palatalized",
  "toId": "s_palatalized",
  "preamble": "Devoicing of the palatalized voiced fricative [zʲ] to [sʲ] keeps the palatal secondary articulation while neutralizing voicing. Russian devoices word-final obstruents, so final soft /zʲ/ surfaces as [sʲ] (Russian князь [knʲæsʲ] 'prince', грязь [ɡrʲæsʲ] 'mud'), and the voiced [zʲ] reappears before a vowel (кня́зя, гря́зи). Ukrainian, which lacks final devoicing, keeps [knʲazʲ].",
  "phoneticEffects": "Devoicing, Final Devoicing, Neutralization",
  "languageExamples": [
    {
      "language": "Russian",
      "languageFamily": "East Slavic",
      "examples": [
        {
          "from": "/knʲazʲ/ князь 'prince'",
          "to": "[knʲæsʲ]",
          "note": "The genitive кня́зя keeps voiced [zʲ] before the vowel."
        },
        {
          "from": "/ɡrʲazʲ/ грязь 'mud, dirt'",
          "to": "[ɡrʲæsʲ]",
          "note": "Voiced [zʲ] alternates with final [sʲ]: genitive гря́зи."
        }
      ]
    }
  ],
