{
  "fromId": "w",
  "toId": "u",
  "preamble": "Vocalization of the labio-velar approximant [w] into the high back rounded vowel [u]. It typically happens when [w] loses its syllable margin: word-finally after a consonant, before a consonant after syncope, or in zero-grade ablaut where the glide becomes the syllable nucleus.",
  "phoneticEffects": "Vocalization, Syllabification",
  "languageExamples": [
    {
      "language": "Old English",
      "languageFamily": "West Germanic",
      "examples": [
        {
          "from": "Proto-West Germanic *balw- (Proto-Germanic *balwą 'evil')",
          "to": "Old English bealu 'harm, evil'",
          "note": "Word-final *w after a consonant vocalized to -u; the glide survives before a vowel in the genitive bealwes and dative bealwe."
        }
      ]
    },
    {
      "language": "Middle English",
      "languageFamily": "West Germanic",
      "examples": [
        {
          "from": "Old English sāwol 'soul'",
          "to": "Middle English soule, sowle",
          "note": "Intervocalic w became the second element of a diphthong (ou) once the following vowel was lost."
        }
      ]
    },
    {
      "language": "Sanskrit",
      "languageFamily": "Indo-Aryan",
      "examples": [
        {
          "from": "svap- 'sleep' (PIE *swep-)",
          "to": "suptá 'asleep' (PIE *sup-tó-s)",
          "note": "Samprasāraṇa: in the zero grade, the glide becomes the syllable nucleus u."
        },
        {
          "from": "vac- 'speak' (PIE *wekʷ-)",
          "to": "uktá 'spoken' (Proto-Indo-Iranian *uktás)",
          "note": "Zero-grade syllabification of the same kind."
        }
      ]
    },
    {
      "language": "Latin",
      "languageFamily": "Italic",
      "examples": [
        {
          "from": "Proto-Italic *kawVtos (cf. caveō 'beware')",
          "to": "cautus 'careful'",
          "note": "After the medial vowel was syncopated, w stood before a consonant and vocalized, giving the diphthong au."
        }
      ]
    }
  ],
