{
  "fromId": "t_palatalized",
  "toId": "t",
  "preamble": "Depalatalization (hardening) removes the palatal secondary articulation of [tʲ]. In Late Common Slavic, consonants were phonetically palatalized before front vowels and front jers. East Slavic (Russian) and Polish kept this softening, but South Slavic and Czech hardened word-final /tʲ/ after the loss of the jers.",
  "phoneticEffects": "Depalatalization, Hardening",
  "languageExamples": [
    {
      "language": "Bulgarian",
      "languageFamily": "South Slavic",
      "examples": [
        {
          "from": "Proto-Slavic *kostь 'bone' (cf. Russian кость [kostʲ])",
          "to": "кост [kɔst]",
          "note": "Final /tʲ/ arising before the front jer lost its palatalization."
        },
        {
          "from": "Proto-Slavic *pętь 'five' (OCS пѧть)",
          "to": "пет [pɛt]"
        }
      ]
    },
    {
      "language": "Serbo-Croatian",
      "languageFamily": "South Slavic",
      "examples": [
        {
          "from": "Proto-Slavic *kostь 'bone'",
          "to": "kȏst / ко̑ст",
          "note": "Hard final t, as throughout South Slavic."
        },
        {
          "from": "Proto-Slavic *pętь 'five'",
          "to": "pet /pêːt/"
        }
      ]
    },
    {
      "language": "Czech",
      "languageFamily": "West Slavic",
      "examples": [
        {
          "from": "Proto-Slavic *kostь 'bone'",
          "to": "kost [kost]",
          "note": "Czech hardened the final consonant, contrasting with Polish kość [kɔɕt͡ɕ], which kept it soft."
        },
        {
          "from": "Proto-Slavic *pętь 'five' (Old Czech pět)",
          "to": "pět [ˈpjɛt]"
        }
      ]
    }
  ],
  "certainty": 5,
  "commonality": 2,
