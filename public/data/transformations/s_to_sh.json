        {
          "from": "Proto-Muskogean *sokča 'bag, sack'",
          "to": "Choctaw and Chickasaw shokcha",
          "note": "Compare Alabama and Koasati sokcha, Creek sukcv."
        },
        {
          "from": "Proto-Muskogean *isko 'to drink'",
          "to": "Choctaw ishko",
          "note": "Compare Alabama isko, Creek esketv. The vacated /s/ slot was refilled by the parallel change of *¢ [ts] to s in the same languages."
        }
