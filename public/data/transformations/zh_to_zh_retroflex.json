      "examples": [
        {
          "from": "Proto-Slavic *žito [ʒ] 'grain, rye'",
          "to": "жыта [ˈʐɨta] 'rye'",
          "note": "All Belarusian postalveolars are hard retroflex consonants; the spelling ⟨жы⟩ reflects the hardening."
        },
        {
          "from": "Proto-Slavic *žena [ʒ]",
          "to": "жонка [ˈʐonka] 'wife'"
