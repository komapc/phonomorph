{
  "fromId": "l",
  "toId": "r_flap",
  "preamble": "Rhotacization of the lateral [l] to the alveolar tap [ɾ]. It happened historically in Galician-Portuguese consonant clusters (Latin pl-, bl-, fl-, cl- > pr-, br-, fr-, cr-), in Basque intervocalic position, and in Andalusian Spanish syllable codas. Korean shows the same relation synchronically: its single liquid ㄹ is [l] in codas and [ɾ] between vowels.",
  "phoneticEffects": "Rhotacism, Loss of Laterality",
  "languageExamples": [
    {
      "language": "Portuguese",
      "languageFamily": "Ibero-Romance",
      "examples": [
        {
          "from": "Medieval Latin plagia 'shore'",
          "to": "praia [ˈpɾajɐ] 'beach'",
          "note": "Latin l after an onset stop became the tap ɾ."
        },
        {
          "from": "Latin blandus 'soft'",
          "to": "brando 'mild, soft'"
        }
      ]
    },
    {
      "language": "Andalusian Spanish",
      "languageFamily": "Ibero-Romance",
      "examples": [
        {
          "from": "alma [ˈalma] 'soul'",
          "to": "[ˈarma] (coda rhotic, phonetically a tap)",
          "note": "Syllable-final /l/ becomes a rhotic (Huelva > Huerva), merging alma with arma."
        },
        {
          "from": "Huelva [ˈwel.β̞a] (place name)",
          "to": "[ˈweɾ.β̞a]"
        }
      ]
    },
    {
      "language": "Basque",
      "languageFamily": "Basque",
      "examples": [
        {
          "from": "Latin caelum > Proto-Basque *zelu 'sky'",
          "to": "zeru [s̻e.ɾu]",
          "note": "Intervocalic *l became the tap in most dialects; Souletin keeps l."
        },
        {
          "from": "Latin angelus > Proto-Basque *angelu 'angel'",
          "to": "aingeru"
        }
      ]
    },
    {
      "language": "Korean",
      "languageFamily": "Koreanic",
      "examples": [
        {
          "from": "다리 dali 'leg' (ㄹ /l/)",
          "to": "[ta̠ɾi]",
          "note": "Allophonic: ㄹ is [ɾ] between vowels and [l] word-finally or before a consonant."
        },
        {
          "from": "노래 norae 'song'",
          "to": "[no̞ɾɛ]"
        },
        {
          "from": "머리 meori 'head'",
          "to": "[mʌ̹ɾi]"
        }
      ],
      "isAllophone": true
    }
  ],
