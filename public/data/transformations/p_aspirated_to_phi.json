          "from": "/sʌpʰa/ 'clean'",
          "to": "[sʌɸa]",
          "note": "Non-geminate aspirated stops may become fricatives, with /pʰ/ realized as [ɸ]."
        },
        {
          "from": "/bapʰ/ 'vapour'",
          "to": "[bäɸ]"
