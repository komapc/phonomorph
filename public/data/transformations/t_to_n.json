{
  "fromId": "t",
  "toId": "n",
  "preamble": "Nasal assimilation of [t] to [n] occurs when a stop immediately precedes a nasal and the velum lowers early, so the oral closure is kept but released through the nose. Korean applies this obligatorily to coronal codas before nasals (낱말 [nanmal]), Sanskrit sandhi turns final t into n before a nasal (jagat + nātha > jagannātha), and Latin assimilated Proto-Italic *tn to nn (*petnā > penna).",
  "phoneticEffects": "Nasalization, Regressive Assimilation",
  "languageExamples": [
    {
      "language": "Korean",
      "languageFamily": "Koreanic",
      "examples": [
        {
          "from": "낱말 nat-mal 'word' (coda [t̚] before [m])",
          "to": "[ˈna(ː)nmaɭ]",
          "note": "Obligatory regressive nasalization: the coronal coda, neutralized to [t̚], becomes [n] before a nasal."
        },
        {
          "from": "끝나다 kkeut-nada 'to end' (coda [t̚] before [n])",
          "to": "[k͈ɯnnada]",
          "note": "The neutralized coronal coda becomes [n] before the nasal [n]."
        }
      ]
    },
    {
      "language": "Sanskrit",
      "languageFamily": "Indo-Aryan",
      "examples": [
        {
          "from": "jagat 'world' + nātha 'lord'",
          "to": "jagannātha 'lord of the world'",
          "note": "Sandhi: word-final t becomes n before a nasal; जगन् jagan is the combining form of जगत् jagat."
        }
      ]
    },
    {
      "language": "Latin",
      "languageFamily": "Italic",
      "examples": [
        {
          "from": "Proto-Italic *petnā 'feather'",
          "to": "penna",
          "note": "The cluster *tn assimilated to nn; the dialectal variant pinna shows the same assimilation."
        },
        {
          "from": "Proto-Italic *atnos 'year'",
          "to": "annus",
          "note": "*tn > nn; cf. Gothic aþn- and Oscan akno-."
        }
      ]
    }
  ],
