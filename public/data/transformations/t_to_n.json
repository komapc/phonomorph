{
  "fromId": "t",
  "toId": "n",
  "preamble": "Nasal assimilation of [t] to [n] occurs when a stop immediately precedes a nasal and the velum lowers early, so the oral closure is kept but released through the nose. Korean applies this obligatorily to coronal codas before nasals (낱말 [nanmal]), and Latin assimilated Proto-Italic *tn to nn (*petnā > penna). In the Chibchan family, Kuna and Guaymí (Ngäbere) reflect Proto-Chibchan *t as n, as in Kuna nakpe 'snake'.",
  "phoneticEffects": "Nasalization, Regressive Assimilation",
  "languageExamples": [
    {
      "language": "Korean",
      "languageFamily": "Koreanic",
      "examples": [
        {
          "from": "낱말 nat-mal 'word' (coda [t̚] before [m])",
          "to": "[ˈna(ː)nmaɭ]",
          "note": "Obligatory regressive nasalization: the coronal coda, neutralized to [t̚], becomes [n] before a nasal."
        },
        {
          "from": "끝나다 kkeut-nada 'to end' (coda [t̚] before [n])",
          "to": "[k͈ɯnnada]",
          "note": "The neutralized coronal coda becomes [n] before the nasal [n]."
        }
      ],
      "isAllophone": true,
      "context": "Coronal coda before a nasal"
    },
    {
      "language": "Latin",
      "languageFamily": "Italic",
      "examples": [
        {
          "from": "Proto-Italic *petnā 'feather'",
          "to": "penna",
          "note": "The cluster *tn assimilated to nn; the dialectal variant pinna shows the same assimilation."
        },
        {
          "from": "Proto-Italic *atnos 'year'",
          "to": "annus",
          "note": "*tn > nn; cf. Gothic aþn- and Oscan akno-."
        }
      ]
    },
    {
      "language": "Kuna (Guna)",
      "languageFamily": "Eastern Isthmic",
      "examples": [
        {
          "from": "Proto-Chibchan *taB(a) 'earth, floor, mud'",
          "to": "nappa 'earth, land, ground'",
          "note": "Pache follows Constenla in deriving Kuna n from Proto-Chibchan *t; Kuna p and k stay unchanged (apa 'body', kapa 'to sleep')."
        },
        {
          "from": "Proto-Chibchan *takamb- ~ *tambak- 'snake'",
          "to": "nakpe 'snake'"
        },
        {
          "from": "Proto-Chibchan *taukaʔ 'calabash'",
          "to": "noka 'calabash, drinking vessel'"
        },
        {
          "from": "Proto-Chibchan *taʔ 'rattle'",
          "to": "naa 'gourd rattle'"
        }
      ]
    }
  ],
