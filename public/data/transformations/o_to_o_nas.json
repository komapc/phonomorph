  "preamble": "Nasalization of the close-mid back vowel [o] to [õ], normally through assimilation to a following nasal consonant that is then lost. Portuguese õ in bom and som continues Latin o + nasal; Hindi shows spontaneous nasalization of o in hõṭh 'lip' < Sanskrit oṣṭha.",
  "phoneticEffects": "Nasalization, Nasal Coalescence",
  "languageExamples": [
    {
      "language": "Portuguese",
      "languageFamily": "Ibero-Romance",
      "examples": [
        {
          "from": "Latin bonus 'good'",
          "to": "bom /ˈbõ/",
          "note": "Via Old Galician-Portuguese bõo; the nasal consonant was absorbed into the vowel."
        },
        {
          "from": "Latin sonus 'sound'",
          "to": "som /ˈsõ/"
        }
      ]
    },
    {
      "language": "Hindi",
      "languageFamily": "Indo-Aryan",
      "examples": [
        {
          "from": "Sanskrit óṣṭha 'lip' (Prakrit hŏṭṭha)",
          "to": "होंठ hõṭh /ɦõːʈʰ/",
          "note": "Spontaneous nasalization without an etymological nasal consonant; the unnasalized doublet ओठ oṭh also exists."
        }
      ]
    }
  ],
