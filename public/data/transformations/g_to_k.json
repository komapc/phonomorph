  "fromId": "g",
  "toId": "k",
  "preamble": "Devoicing of the voiced velar stop [ɡ] to [k] is one of the most widespread consonant changes. It occurs as a regular historical shift (Grimm's law, PIE *g > Proto-Germanic *k), as the general loss of voiced initials in most Chinese varieties (Middle Chinese *ɡ- > k-/kʰ-, with the former voicing surviving as the yang tone register), and as final-obstruent devoicing in German and Russian. In the Armenian consonant shift PIE *g became k (*gerh₂no- > կռունկ kṙunk 'crane').",
  "phoneticEffects": "Devoicing, Final Devoicing, Register Split",
  "languageExamples": [
    {
      "language": "Proto-Germanic",
      "languageFamily": "Germanic",
      "examples": [
        {
          "from": "PIE *yugóm 'yoke' (cf. Latin iugum)",
          "to": "Proto-Germanic *juką > English yoke, German Joch",
          "note": "Grimm's law devoiced the PIE plain voiced stops: *g > *k."
        }
      ]
    },
    {
      "language": "Xiang Chinese (Changsha)",
      "languageFamily": "Sinitic",
      "examples": [
        {
          "from": "共 'together, common', Middle Chinese gjowngH [ɡ-]",
          "to": "Changsha /kʊŋ²¹/ (vernacular), Mandarin gòng [kʊŋ⁵¹]",
          "note": "The Middle Chinese voiced initial devoiced to unaspirated [k]; Shanghainese /ɡoŋ²³/ keeps the voiced initial. The lost voicing is reflected in the low (yang) tone category."
        }
      ]
    },
    {
      "language": "German",
      "languageFamily": "West Germanic",
      "examples": [
        {
          "from": "Tage /ˈtaːɡə/ 'days'",
          "to": "Tag /taːk/ 'day'",
          "note": "Final obstruent devoicing (Auslautverhärtung) in the standard language of Germany and Austria."
        }
      ]
    },
    {
      "language": "Russian",
      "languageFamily": "East Slavic",
      "examples": [
        {
          "from": "друга [ˈdruɡə] 'friend (gen.)'",
          "to": "друг [druk] 'friend'",
          "note": "Word-final devoicing of /ɡ/; southern Russian varieties have [drux] instead."
        }
      ]
    },
    {
      "language": "Itunyoso Triqui",
