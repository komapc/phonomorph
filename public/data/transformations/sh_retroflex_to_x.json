{
  "fromId": "sh_retroflex",
  "toId": "x",
  "preamble": "The voiceless retroflex sibilant [ʂ] backs to the voiceless velar fricative [x] through retraction and loss of sibilance. It is visible as a living dialect cline in Pashto, where ښ is [ʂ] in conservative Kandahar speech but [x] in the northeastern dialects (Yusufzai, Afridi, Momand), and in deep time as the Indo-European ruki outcome that separates Indic (which keeps [ʂ]) from Slavic (which retracted it to [x]).",
  "phoneticEffects": "Backing, Retraction, Desibilantization",
  "languageExamples": [
    {
      "language": "Pashto (Northeastern dialects)",
      "languageFamily": "Iranian",
      "examples": [
        {
          "from": "پښتو 'Pashto', conservative [ʂ] /pəʂˈt̪o/ (kept in Kandahar)",
          "to": "/pʊxˈt̪o/ (Yusufzai, Peshawar)",
          "note": "Kandahar keeps the original retroflex [ʂ], so the from-forms show the conservative pronunciation; in the medieval consonant shift the northeastern dialects changed it to [x] and the central ones to [ç]."
        },
        {
          "from": "پښه 'foot', conservative [ʂ] /pʂa/ (kept in Kandahar)",
          "to": "/pxa/ (northeastern)"
        },
        {
          "from": "ښځه 'woman', conservative [ʂ] /ʂəˈd͡za/ (kept in Kandahar)",
          "to": "/xəˈd͡za/ (northeastern)"
        }
      ]
    },
    {
      "language": "Proto-Slavic (Ruki Law)",
      "languageFamily": "Slavic",
      "examples": [
        {
          "from": "ruki *š (Proto-Balto-Slavic *saušás 'dry')",
          "to": "Proto-Slavic *sȗxъ 'dry'",
          "note": "After *r, *u, *k, *i PIE *s became a retracted sibilant, which became retroflex in pre-Slavic and was then retracted to the velar fricative *x; Sanskrit kept ष [ʂ]."
        },
        {
          "from": "ruki *š (Proto-Balto-Slavic *paršás 'dust')",
          "to": "Proto-Slavic *pȏrxъ 'dust'",
          "note": "Cf. Sanskrit पृषत् pṛ́ṣat with retained [ʂ]."
        }
      ]
    },
    {
      "language": "Amawaka",
      "languageFamily": "Panoan",
      "examples": [
        {
          "from": "Proto-Panoan *ʂao 'bone'",
          "to": "xaó",
          "note": "Oliveira (2014) gives x as the Amawaka reflex of *ʂ in all positions; Shipibo-Konibo keeps ʂao."
        },
        {
          "from": "Proto-Panoan *ʂɨta 'tooth'",
          "to": "xɨtá",
          "note": "Shipibo-Konibo ʂɨta."
        },
        {
          "from": "Proto-Panoan *ʔoʂa- 'to sleep'",
          "to": "ʔoxaʔí 'to sleep' (Hyde 1980)",
          "note": "Shipibo-Konibo ʔoʂa-."
        },
        {
          "from": "Proto-Panoan *ʔoʂɨ 'moon'",
          "to": "ʔóxɨ"
        }
      ]
    }
  ],
