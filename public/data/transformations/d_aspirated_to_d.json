{
  "fromId": "d_aspirated",
  "toId": "d",
  "preamble": "Loss of breathy voice turns [dʱ] into plain [d]. This is one of the most common fates of the Proto-Indo-European voiced aspirates: Iranian, Balto-Slavic, Celtic and Albanian all merged *dʰ with *d, and Germanic arrived at d initially via a fricative stage [ð]. Within Indo-Aryan, which otherwise preserves dʱ, it occurs as dissimilation under Grassmann's Law in Sanskrit and as a wholesale loss of aspiration in Sinhala. In Armenian PIE *dʰ became d (*dʰugh₂tḗr > դուստր dustr 'daughter'), while PIE *d became t.",
  "phoneticEffects": "Deaspiration, Merger",
  "languageExamples": [
    {
      "language": "Sanskrit",
      "languageFamily": "Indo-Aryan",
      "examples": [
        {
          "from": "PIE *dʰédʰeh₁ti 'puts' (reduplicated *dʰa-dʰā-)",
          "to": "dádhāti 'puts, places'",
          "note": "Grassmann's Law: the first of two aspirates in successive syllables loses its aspiration, so the reduplicating syllable has d."
        },
        {
          "from": "Proto-Indo-Iranian *dʰáǰʰati 'burns'",
          "to": "दहति dáhati 'burns'",
          "note": "Grassmann's Law again deaspirates the first aspirate (the second became h)."
        }
      ]
    },
    {
