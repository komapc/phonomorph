{
  "fromId": "l",
  "toId": "v",
  "preamble": "The shift from the lateral approximant [l] to the labiodental fricative [v] (or more commonly the labial semivowel [w]) is a widespread form of L-vocalization. In Slavic languages, the historical 'dark L' [ɫ] frequently vocalized into a sound that became phonologically identified with /v/ or /w/, particularly in word-final or preconsonantal positions.",
  "phoneticEffects": "L-vocalization, Labialization, Velarization Loss",
  "languageExamples": [
    {
      "language": "Polish",
      "languageFamily": "Slavic",
      "examples": [
        {
          "from": "był [ɫ]",
          "to": "[biw]",
          "note": "Historical dark L (ł) shifted to [w] in all positions."
        },
        {
          "from": "mały [ɫ]",
          "to": "[mawɨ]",
          "note": "The letter ł is now phonetically identical to the English 'w'."
        }
      ]
    },
    {
      "language": "Ukrainian",
      "languageFamily": "Slavic",
      "examples": [
        {
          "from": "vovk [ɫ]",
          "to": "[vɔwk]",
          "note": "Corresponds to Russian 'volk' (wolf)."
        },
        {
          "from": "buv [ɫ]",
          "to": "[buw]",
          "note": "Corresponds to Russian 'byl' (was)."
        }
      ]
    },
    {
      "language": "Komi (Central dialects)",
      "languageFamily": "Uralic",
      "examples": [
        {
          "from": "kɨl [-l]",
          "to": "kɨv \"tongue\"",
          "note": "Syllable-final l vocalized in northern dialects; the change began in the 17th century."
        },
        {
          "from": "Proto-Permic *vɔ̇l 'horse'",
          "to": "Komi-Zyrian вӧв vöv",
          "note": "Komi-Permyak keeps л in the stem (вӧл-)."
        },
        {
          "from": "Proto-Permic *tul",
          "to": "Komi-Zyrian тув tuv 'nail'"
        }
      ]
    }
  ],
