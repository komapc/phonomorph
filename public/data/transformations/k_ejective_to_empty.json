    },
    {
      "language": "Proto-Athabaskan to Dogrib",
      "languageFamily": "Athabaskan",
      "examples": [
        {
          "from": "Proto-Athabaskan *tsʼakʼʸ 'dish'",
          "to": "Dogrib kwʼà",
          "note": "Final ejective lost with low tone; Navajo tsʼaaʼ has ʔ."
        }
      ]
    }
