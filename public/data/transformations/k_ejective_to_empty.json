      "languageFamily": "Cushitic",
      "examples": [
        {
          "from": "Somali qaniin 'to bite'",
          "to": "Boni aniin",
          "note": "Rendille xanʼín."
        },
        {
          "from": "Somali qaad 'to take'",
          "to": "Boni aad"
        },
        {
          "from": "Somali qori 'wood'",
          "to": "Boni ʼóre"
        },
        {
          "from": "Somali maqal 'hear'",
          "to": "Boni maʔal",
          "note": "Intervocalically the reflex is ʔ, not zero."
        }
      ]
    },
    {
      "language": "Proto-East-Cushitic to Afar and Bayso",
      "languageFamily": "Cushitic",
      "examples": [
