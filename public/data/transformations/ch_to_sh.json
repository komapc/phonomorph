      "language": "Quechua",
      "languageFamily": "Quechuan",
      "isAllophone": true,
      "examples": [
        {
          "from": "/tʃ/",
          "to": "[ʃ]",
          "note": "Occurs in the coda position."
        }
      ]
    },
    {
      "language": "Mordvinic (Erzya and Moksha)",
      "languageFamily": "Uralic",
      "isAllophone": true,
      "examples": [
        {
          "from": "Erzya word-initial [tʃ]",
          "to": "Moksha [ʃ]",
          "note": "Word-initially Erzya has the affricate where Moksha has the fricative."
        }
      ]
    },
    {
      "language": "Terena",
      "languageFamily": "Bolivia-Paraná",
      "isAllophone": true,
      "examples": [
        {
          "from": "Proto-Mojeño *-ʧene 'breast' (Paunaka -ʧene)",
          "to": "Terena -ʃêne"
        },
        {
          "from": "Proto-Mojeño *sáʧe 'sun' (Paunaka saʧe)",
          "to": "Terena káʃe"
        },
        {
          "from": "Proto-Mojeño *-eʧo 'know' (Paunaka -iʧu)",
          "to": "Terena -êʃo",
          "note": "Terena changed its affricates to simple fricatives; Mojeño and Paunaka keep ʧ."
        }
      ]
    },
