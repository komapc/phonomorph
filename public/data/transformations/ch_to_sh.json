      "language": "Baure",
      "languageFamily": "Bolivia-Paraná",
      "isAllophone": true,
      "examples": [
        {
          "from": "Proto-Baure-Muxojeóne *iʧini 'jaguar' (Muxojeóne iʧini)",
          "to": "Baure iʃini, Joaquiniano ʃini"
