{
  "fromId": "sh_retroflex",
  "toId": "s",
  "preamble": "The retroflex fricative [ʂ] loses its retroflexion and becomes the alveolar fricative [s] in several unrelated languages. Polish mazurzenie (sz > s) is filed under ʃ > s, since the mazurating dialects merged the older palato-alveolar with the dental directly.",
  "phoneticEffects": "De-retroflexion, Merger, Fronting",
  "languageExamples": [
    {
      "language": "Sanskrit to Pali / Hindi",
      "languageFamily": "Indo-Aryan",
      "examples": [
        {
          "from": "varṣa 'rain, year'",
          "to": "Pali vassa, Hindi baras",
          "note": "Retroflex ṣ merges with s, and the cluster assimilates"
        },
        {
          "from": "Sanskrit दोष doṣa 'fault'",
          "to": "Pali dosa"
        },
        {
          "from": "Sanskrit भाषा bhāṣā 'language'",
          "to": "Pali bhāsā, Prakrit 𑀪𑀸𑀲𑀸 bhāsā"
        }
      ]
    },
    {
      "language": "Vietnamese (Hanoi)",
      "languageFamily": "Austroasiatic",
      "examples": [
        {
          "from": "sáu 'six', conservative [ʂ] (written s; Quảng Nam [ʂaː˦˥])",
          "to": "Hanoi [saw]",
          "note": "The from-forms give the conservative retroflex [ʂ], spelled s and kept in central and southern speech; northern Vietnamese merged it with x [s]."
        },
        {
          "from": "sông 'river', conservative [ʂ] (Huế [ʂəwŋ͡m˧˧])",
          "to": "Hanoi [səwŋ͡m˧˧]"
        },
        {
          "from": "sữa 'milk', conservative [ʂ] (Saigon [ʂɨə˨˩˦])",
          "to": "Hanoi [sɨə˦ˀ˥]"
        }
      ]
    },
    {
      "language": "Proto-Kartvelian to Old Georgian",
      "languageFamily": "Karto-Zan",
      "examples": [
        {
          "from": "Proto-Kartvelian *as₁- 'hundred' (Laz, Mingrelian ოში oši)",
          "to": "Old Georgian ასი asi"
        },
        {
          "from": "Proto-Kartvelian *-is₁ (genitive; Mingrelian, Svan -იშ -iš)",
          "to": "Old Georgian, Georgian -ის -is"
        },
        {
          "from": "Proto-Kartvelian *s₁wel- 'whey' (Svan შუ̂ელ šûel)",
          "to": "Old Georgian სუელი sueli"
        },
        {
          "from": "Proto-Kartvelian *s₁iʒ₁e- 'son-in-law'",
          "to": "Old Georgian სიძჱ siʒē"
        },
        {
          "from": "Proto-Kartvelian *kwis₁l- 'brother-in-law' (Mingrelian ქვიშილი kvišili)",
          "to": "Georgian ქვისლი kvisli",
          "note": "Georgian merged the subscript-1 sibilant with plain *s, while Zan and Svan have š. Wiktionary's subscript-1 series (*s₁, *z₁, *c₁, *ʒ₁) is the Gamkrelidze-Machavariani 'hissing-hushing' series, given in the Wikipedia Proto-Kartvelian consonant table (after Gamkrelidze 1966 and Fähnrich 2002) as retroflex [ʂ ʐ ʈ͡ʂ ɖ͡ʐ]."
        }
      ]
    }
  ],
