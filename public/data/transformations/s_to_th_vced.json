          "from": "Proto-Oceanic *pasu- 'eyebrow'",
          "to": "vacu"
        },
        {
          "from": "Proto-Oceanic *asa(q) 'to grate, sharpen by rubbing'",
          "to": "yaca"
        },
        {
          "from": "Proto-Oceanic *puso- 'navel'",
          "to": "vico"
        }
      ]
    },
    {
      "language": "Tezoatlán Mixtec",
      "languageFamily": "Mixtecan",
      "examples": [
        {
          "from": "Proto-Mixtec *isa 'day after tomorrow'",
          "to": "idá",
          "note": "Mixtec ⟨d⟩ = [ð]; compare San Juan Colorado isá, Yosondúa isa."
        },
        {
          "from": "Proto-Mixtec *kɨ̀sɨ́ 'clay pot'",
          "to": "ki̱di",
          "note": "Compare Yosondúa kɨsɨ, Magdalena Peñasco kisi."
        },
        {
          "from": "Proto-Mixtec *kasaʔ 'sister's husband'",
          "to": "ka̱dá 'son-in-law, sister's husband'",
          "note": "Compare San Miguel el Grande cāsá, Yosondúa kasa."
        }
      ]
    }
