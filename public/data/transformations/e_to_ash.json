  "fromId": "e",
  "toId": "ash",
  "preamble": "Lowering of the close-mid front vowel /e/ to near-open [æ], conditioned by the following segment. In Turkish, /e/ is lowered to [æ] before coda sonorants /m, n, l, r/ in words such as sen [sæn] 'you' and ben [bæn] 'I'. In Latvian, the Proto-Balto-Slavic short and long *e split into 'narrow' [ɛ] where a palatal element (a front vowel, i-diphthong or palatal consonant) followed and 'broad' [æ] elsewhere, giving vecs [væt͡s] 'old' < *wétušas and ezers [æzæɾs] 'lake' < *éźeran.",
  "phoneticEffects": "Lowering, Conditioned Split",
  "languageExamples": [
    {
      "language": "Turkish",
      "languageFamily": "Oghuz",
      "isAllophone": true,
      "examples": [
        {
          "from": "/sen/ 'you (sg.)'",
          "to": "[sæn]",
          "note": "Most speakers lower /e/ to [ɛ]~[æ] before coda /m, n, l, r/; Wiktionary gives /sæn/."
        },
        {
          "from": "/ben/ 'I'",
          "to": "[bæn]",
          "note": "Same lowering before coda /n/; likewise gel [ɟæl] 'come!' and hem [hæm] 'both'."
        }
      ]
    },
    {
      "language": "Latvian",
      "languageFamily": "East Baltic",
      "isAllophone": true,
      "examples": [
        {
          "from": "Proto-Balto-Slavic *wétušas 'of the year'",
          "to": "vecs [væt͡s] 'old'",
          "note": "Broad [æ] arose where no palatal element followed; compare narrow [ɛ] in zeme [zɛmɛ] 'land', where a front vowel follows."
        },
        {
          "from": "Proto-Balto-Slavic *éźeran 'lake'",
          "to": "ezers [æzæɾs] 'lake'",
          "note": "Both e-vowels are broad, as the following syllables originally contained back vowels."
        }
      ]
    },
    {
      "language": "Proto-Balto-Slavic to Proto-Slavic",
      "languageFamily": "Slavic",
      "examples": [
        {
          "from": "Proto-Balto-Slavic *dēˀd-",
          "to": "Proto-Slavic *dědъ 'grandfather' (OCS дѣдъ)"
        },
        {
          "from": "Proto-Balto-Slavic *wēˀrāˀ",
          "to": "Proto-Slavic *věra 'faith' (OCS вѣра)"
        },
        {
          "from": "Proto-Balto-Slavic *dḗˀlan",
          "to": "Proto-Slavic *dělo 'deed' (OCS дѣло)",
          "note": "Long *ē became yat, generally reconstructed as open [æː]; the same vowel arose from the diphthong *ai."
        }
      ]
    }
