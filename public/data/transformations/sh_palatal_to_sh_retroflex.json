{
  "fromId": "sh_palatal",
  "toId": "sh_retroflex",
  "preamble": "Retraction of the alveolo-palatal fricative [ɕ] to the retroflex fricative [ʂ]. In the history of Mandarin, the Middle Chinese palatal sibilant series (the 章 initials, including the fricative 書 [ɕ]) merged with the retroflex series, so Middle Chinese [ɕ] is continued as Mandarin sh [ʂ]. In Sanskrit sandhi, the palatal sibilant ś [ɕ] becomes the retroflex ṣ [ʂ] before t and th, which are themselves made retroflex (viś + ta > viṣṭá).",
  "phoneticEffects": "Retraction, Retroflexion, Merger",
  "languageExamples": [
    {
      "language": "Mandarin Chinese",
      "languageFamily": "Sinitic",
      "examples": [
        {
          "from": "Middle Chinese 書 /ɕɨʌ/ (Baxter syo) 'book'",
          "to": "shū [ʂu⁵⁵]",
          "note": "The 書 initial [ɕ] became retroflex [ʂ]."
        },
        {
          "from": "Middle Chinese 深 /ɕiɪm/ (Baxter syim) 'deep'",
          "to": "shēn [ʂən⁵⁵]",
          "note": "Same change before a different rhyme."
        },
        {
          "from": "Middle Chinese 手 /ɕɨuX/ (Baxter syuwX) 'hand'",
          "to": "shǒu [ʂoʊ̯²¹⁴]"
        }
      ]
    },
    {
      "language": "Sanskrit",
      "languageFamily": "Indo-Aryan",
      "examples": [
        {
          "from": "viś- 'enter' + -ta",
          "to": "viṣṭá [ʂʈ] 'entered'",
          "note": "Final ś becomes ṣ before t or th in internal combination (Whitney §218)"
        },
        {
          "from": "vaś- 'wish' + -ti",
          "to": "váṣṭi [ʂʈ] 'wishes'",
          "note": "Same rule before the 3rd singular ending -ti"
        },
        {
          "from": "diś- 'point' + -tu",
          "to": "dídeṣṭu [ʂʈ]",
          "note": "Reduplicated imperative form of diś cited by Whitney (§218)"
        }
      ]
    }
  ],
