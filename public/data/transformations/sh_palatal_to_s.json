      "language": "Hungarian",
      "languageFamily": "Uralic",
      "examples": [
        {
          "from": "*śilmä [ɕ]",
          "to": "szem \"eye\" [sɛm]"
        },
        {
          "from": "*śuwe",
          "to": "száj \"mouth\"",
          "note": "Cf. Finnish suu."
        }
      ]
    },
    {
      "language": "Finnic (Finnish)",
      "languageFamily": "Uralic",
      "examples": [
        {
          "from": "*śilmä",
          "to": "silmä \"eye\"",
          "note": "Proto-Finnic: *ś, *ć, *δ́, *ń > *s, *c, *δ, *n."
        }
      ]
    },
    {
      "language": "Sanskrit to Pali",
      "languageFamily": "Indo-Aryan",
      "examples": [
        {
          "from": "śata 'hundred'",
          "to": "sata",
          "note": "Pali and most Prakrits merge the three sibilants ś, ṣ, s into s"
        },
        {
          "from": "daśa 'ten'",
          "to": "dasa"
        }
      ]
    }
  ],
