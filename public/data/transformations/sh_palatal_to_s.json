  "preamble": "The Proto-Uralic alveolo-palatal fricative *ś lost its palatal articulation in the daughter branches. Finnic and Hungarian both give a plain sibilant, spelled sz in Hungarian.",
  "phoneticEffects": "Depalatalization",
  "languageExamples": [
    {
      "language": "Hungarian",
      "languageFamily": "Uralic",
      "examples": [
        {
          "from": "*śilmä [ɕ]",
          "to": "szem \"eye\" [sɛm]"
        },
        {
          "from": "*śuwe",
          "to": "száj \"mouth\"",
          "note": "Cf. Finnish suu."
        }
      ]
    },
    {
      "language": "Finnic (Finnish)",
      "languageFamily": "Uralic",
      "examples": [
        {
          "from": "*śilmä",
          "to": "silmä \"eye\"",
          "note": "Proto-Finnic: *ś, *ć, *δ́, *ń > *s, *c, *δ, *n."
        },
        {
          "from": "Proto-Uralic *śüdäme",
          "to": "sydän 'heart' (Proto-Finnic *südän)"
        }
      ]
    },
    {
      "language": "Sanskrit to Pali",
      "languageFamily": "Indo-Aryan",
      "examples": [
        {
          "from": "śata 'hundred'",
          "to": "sata",
          "note": "Pali and most Prakrits merge the three sibilants ś, ṣ, s into s"
        },
        {
          "from": "daśa 'ten'",
          "to": "dasa"
        }
      ]
    },
    {
      "language": "Proto-Balto-Slavic to Proto-Slavic",
      "languageFamily": "Slavic",
      "examples": [
        {
          "from": "Proto-Balto-Slavic *déśimt 'ten'",
          "to": "Proto-Slavic *desętь (OCS десѧть, Russian де́сять)"
        },
        {
          "from": "Proto-Balto-Slavic *aśís 'axle'",
          "to": "Proto-Slavic *osь (OCS ось, Russian ось)"
        },
        {
          "from": "Proto-Balto-Slavic *śímtan, dialectal *śumtan 'hundred'",
          "to": "Proto-Slavic *sъto (OCS съто, Russian сто)",
          "note": "In Slavic *ś merged with plain s, while the ruki *š stayed distinct (later *x before back vowels)."
        }
      ]
    }
  ],
