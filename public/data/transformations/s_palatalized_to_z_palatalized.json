{
  "fromId": "s_palatalized",
  "toId": "z_palatalized",
  "preamble": "Voicing of the palatalized fricative [sʲ] to [zʲ] through regressive voicing assimilation. In Russian and Belarusian an obstruent takes on the voicing of a following voiced obstruent, so the soft /sʲ/ of проси́ть 'to ask' and коси́ть 'to mow' is voiced before the suffix -ьба: просьба [ˈprozʲbə] 'request', косьба [kɐzʲˈba] 'mowing'.",
  "phoneticEffects": "Voicing, Regressive Assimilation, Neutralization",
  "languageExamples": [
    {
      "language": "Russian",
      "languageFamily": "East Slavic",
      "examples": [
        {
          "from": "/ˈprosʲbə/ просьба 'request' (cf. проси́ть 'to ask')",
          "to": "[ˈprozʲbə]",
          "note": "Soft /sʲ/ voices before the voiced stop [b] and keeps its palatalization."
        },
        {
          "from": "/kɐsʲˈba/ косьба 'mowing' (cf. коси́ть 'to mow')",
          "to": "[kɐzʲˈba]",
          "note": "Same regressive voicing before the suffix -ьба."
        }
      ]
    },
    {
      "language": "Belarusian",
      "languageFamily": "East Slavic",
      "examples": [
        {
          "from": "/ˈprosʲba/ просьба 'request'",
          "to": "[ˈprozʲba]",
          "note": "Belarusian has the same regressive voicing assimilation."
        }
      ]
    }
  ],
  "certainty": 5,
  "commonality": 2,
  "sources": [
