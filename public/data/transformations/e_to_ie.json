{
  "fromId": "e",
  "toId": "ie",
  "preamble": "A long mid front vowel [eː] breaks into an opening diphthong [ie]/[iə]/[ia], typically in stressed syllables. Independent cases are the Old Irish diphthongization of é to ía before non-palatalized consonants, the Finnish and Karelian diphthongization of Proto-Finnic long *ee to ie (Estonian keeps ee), and the West Frisian development of Old Frisian ē to the centering diphthong ie [iə].",
  "phoneticEffects": "Diphthongization, Breaking",
  "languageExamples": [
    {
      "language": "Old Irish",
      "languageFamily": "Goidelic",
      "examples": [
        {
          "from": "archaic ·tégot 'they go'",
          "to": "·tíagat",
          "note": "é (< *ei) breaks to ía before a non-palatalized consonant; PIE *steigʰ-."
        },
        {
          "from": "é 'god' (genitive dé; < Proto-Celtic *deiwos)",
          "to": "día",
          "note": "Nominative día; in the genitive dé the following palatal quality blocked breaking."
        },
        {
          "from": "é 'sense' (genitive céille; < Proto-Celtic *kʷeislā)",
          "to": "cíall",
          "note": "Nominative cíall; the genitive keeps é before the palatalized consonant."
        }
      ]
    },
    {
      "language": "Finnish",
      "languageFamily": "Finnic",
      "examples": [
        {
          "from": "Proto-Finnic *tee 'road'",
          "to": "tie [tie̯]",
          "note": "Long mid vowels *ee, *oo, *öö became ie, uo, yö in Finnish and Karelian; Estonian and Votic keep tee."
        },
        {
          "from": "Proto-Finnic *mees 'man'",
          "to": "mies [mie̯s]",
          "note": "Estonian mees; Karelian mieš and Livvi mies show the same change."
        }
      ]
    },
    {
      "language": "West Frisian",
      "languageFamily": "Anglo-Frisian",
      "examples": [
        {
          "from": "Old Frisian stēn 'stone'",
          "to": "stien /stiə̯n/",
          "note": "Breaks further to rising [jɪ] in the plural stiennen /ˈstjɪnən/."
        },
        {
          "from": "Old Frisian bēn 'bone, leg'",
          "to": "bien /biə̯n/"
        },
        {
          "from": "Old Frisian wēt 'wet'",
          "to": "wiet /viə̯t/"
        }
      ]
    },
    {
      "language": "Proto-Yukaghir to Kolyma Yukaghir",
      "languageFamily": "Yukaghir",
      "examples": [
        {
          "from": "Proto-Yukaghir *pe: 'rock, mountain'",
          "to": "Kolyma Yukaghir пиэ pie"
        },
        {
          "from": "Proto-Yukaghir *eče: 'father'",
          "to": "Kolyma Yukaghir эчиэ ečie"
        },
        {
          "from": "Proto-Yukaghir *lewe: 'earth'",
          "to": "Kolyma Yukaghir лэбиэ lebie"
        },
        {
          "from": "Proto-Yukaghir *čel- 'to be cold'",
          "to": "Kolyma Yukaghir чиэч čieč, чиэдьэ čiedʼe",
          "note": "In the first three words the source is long *e:, which Kolyma Yukaghir renders as the diphthong иэ [ie]; reconstructions follow Nikolaeva (2006)."
        }
      ]
    },
    {
      "language": "Proto-Nahuan to Tetelcingo Nahuatl",
      "languageFamily": "Nahuan",
      "examples": [
        {
          "from": "Proto-Nahuan *meeȼ- 'moon'",
          "to": "Tetelcingo mietztli̱",
          "note": "Long /eː/ became the rising diphthong [i̯e], written ⟨ie⟩; short e stays [e]. Classical Nahuatl has mētztli."
        },
        {
          "from": "Proto-Nahuan *teeka 'to lay down'",
          "to": "Tetelcingo qui̱tieca",
          "note": "Classical Nahuatl tēca."
        }
      ]
    }
