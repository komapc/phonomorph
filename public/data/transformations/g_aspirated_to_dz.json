{
  "fromId": "g_aspirated",
  "toId": "dz",
  "preamble": "In Armenian the Proto-Indo-European palatovelar aspirate *ǵʰ (a palatalized variety of the voiced aspirated velar) was affricated and fronted to the voiced alveolar affricate ձ /dz/ (transliterated j), alongside a fricative outcome զ /z/ in other words. The change is a satem development specific to Armenian; the plain velar aspirate *gʰ gives Armenian g instead.",
  "phoneticEffects": "Palatalization, Affrication, Deaspiration, Fronting",
  "languageExamples": [
    {
      "language": "Old Armenian",
      "languageFamily": "Armenian",
      "examples": [
        {
          "from": "PIE *ǵʰéyōm 'snow'",
          "to": "ձիւն (jiwn) [dziwn] 'snow'",
          "note": "Genitive ձեան (jean)."
        },
        {
          "from": "PIE *ǵʰésr-m̥ 'hand' (acc.)",
          "to": "ձեռն (jeṙn) [dzeɾn] 'hand'",
          "note": "Cognate with Ancient Greek χείρ 'hand'; the plural ձեռք (jeṙkʻ) shows the same initial."
        },
        {
          "from": "PIE *ǵʰéyos 'horse' (cf. Sanskrit háya)",
          "to": "ձի (ji) [dzi] 'horse'",
          "note": "A poetic word according to Martirosyan, as cited by Wiktionary."
        },
        {
          "from": "PIE *ǵʰim-er-n- 'winter' (from *ǵʰey-)",
          "to": "ձմեռն (jmeṙn) [dzmeɾn] 'winter'",
          "note": "Related to ձիւն 'snow'; the same initial *ǵʰ gives ձ."
        }
      ]
    }
  ],
