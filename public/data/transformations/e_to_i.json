{
  "fromId": "e",
  "toId": "i",
  "preamble": "The shift from the mid front vowel [e] to the high front vowel [i] is a process of Vowel Raising. This can occur as a regular sound change in stressed syllables, part of a chain shift, or as a reduction process in unstressed syllables. In Greek, the Attic long close-mid vowel /eː/ spelled ει became /i/ in Koine (εἰρήνη /eːrɛ̌ːnɛː/ > /iˈrini/), part of itacism.",
  "phoneticEffects": "Vowel Raising",
  "languageExamples": [
    {
      "language": "English (Great Vowel Shift)",
      "languageFamily": "Germanic",
      "examples": [
        {
          "from": "Middle English meet [meːt]",
          "to": "meet [miːt]"
        },
        {
          "from": "Middle English feet [feːt]",
          "to": "feet [fiːt]",
          "note": "Middle English long /eː/ raised to /iː/ in the first phase of the Great Vowel Shift."
        }
      ]
    },
    {
      "language": "Proto-Indo-European to Proto-Celtic",
      "languageFamily": "Celtic",
      "examples": [
        {
          "from": "*weh₁-ro- (*wēro-) 'true'",
          "to": "*wīros > Old Irish fír, Welsh gwir",
          "note": "Regular Proto-Celtic raising of long *ē to *ī; cf. Latin vērus"
        },
        {
          "from": "*h₃rēǵs 'king'",
          "to": "*rīxs > Old Irish rí",
          "note": "cf. Latin rēx"
        },
        {
          "from": "*bʰréh₂tēr 'brother'",
          "to": "*brātīr > Old Irish bráthair"
        },
        {
          "from": "*méh₂tēr 'mother'",
          "to": "*mātīr > Old Irish máthir"
        }
      ]
    },
    {
      "language": "Proto-Japonic to Okinawan",
      "languageFamily": "Japonic",
      "examples": [
        {
          "from": "*ke 'hair'",
          "to": "kī [kiː]",
          "note": "*e > i; unlike original *i, the new i does not palatalize a preceding k"
        },
        {
          "from": "*ame 'rain'",
          "to": "ami"
        }
      ]
    },
    {
      "language": "Northern Sami",
      "languageFamily": "Samic",
      "examples": [
        {
          "from": "Proto-Samic *kuolē 'fish'",
          "to": "guolli",
          "note": "Proto-Samic unstressed *ē is reflected as i in Northern Sami second syllables."
        },
        {
          "from": "Proto-Samic *ājmē 'needle'",
          "to": "áibmi",
          "note": "Same regular correspondence."
        },
        {
          "from": "Proto-Samic *oalkē 'shoulder'",
          "to": "oalgi",
          "note": "Same regular correspondence."
        },
        {
          "from": "Proto-Samic *ealē- 'to live'",
          "to": "eallit",
          "note": "Verb stems in *-ē- give -it infinitives."
        }
      ]
    },
    {
      "language": "Proto-Nakh to Ingush",
      "languageFamily": "Vainakh",
      "examples": [
        {
          "from": "*de 'day'",
          "to": "di",
          "note": "Final *e of monosyllables is raised to i in Ingush; Chechen and Bats keep de"
        },
        {
          "from": "*c̣e 'fire, name'",
          "to": "cʼi",
          "note": "Chechen cʼe and Bats c̣e keep the mid vowel"
        },
        {
          "from": "*ge 'span'",
          "to": "gi"
        }
      ]
    },
    {
      "language": "Proto-Ryukyuan to Southern Ryukyuan (Miyako, Yaeyama, Yonaguni)",
      "languageFamily": "Southern Ryukyuan",
      "examples": [
        {
          "from": "*ame 'rain'",
          "to": "Miyako ami, Yaeyama āmi, Yonaguni ami"
        },
        {
          "from": "*nabe 'pot'",
          "to": "Miyako nabi, Yaeyama nabi, Yonaguni nabi"
        },
        {
          "from": "*tera 'temple'",
          "to": "Miyako tira, Yaeyama tira, Yonaguni tira"
        },
        {
          "from": "*me 'eye'",
          "to": "Miyako mī, Yaeyama mī, Yonaguni mī",
          "note": "In Miyako *e and *o rose to i and u while the old high vowels *i and *u centralized to /ɨ/; Northern Amami Ōshima has ɨ for *e instead (Naze amï)."
        }
      ]
    },
    {
      "language": "Proto-Japonic to Old Japanese",
      "languageFamily": "Japonic",
      "examples": [
        {
          "from": "*peru 'garlic'",
          "to": "Old Japanese pi₁ru, Modern Japanese hiru"
        },
        {
          "from": "*mentu 'water'",
          "to": "Old Japanese mi₁du, Modern Japanese mizu"
        },
        {
          "from": "*penti 'elbow'",
          "to": "Old Japanese pi₁di, Modern Japanese hiji",
          "note": "Non-final *e was raised to i₁; word-final *e stays, as in *pone > pone 'bone'."
        }
      ]
    },
    {
      "language": "Koine Greek",
      "languageFamily": "Hellenic",
      "examples": [
        {
          "from": "Attic εἰρήνη /eː.rɛ̌ː.nɛː/ 'peace' (ει = /eː/)",
          "to": "4th-century Koine /iˈri.ni/",
          "note": "By the 5th century BCE Attic ει was already the monophthong /eː/; it merged with i in Koine."
        },
        {
          "from": "Attic εἶδος /êː.dos/ 'form, kind'",
          "to": "4th-century Koine /ˈi.ðos/"
        }
      ]
    },
    {
      "language": "Sicilian",
      "languageFamily": "Italo-Dalmatian",
      "examples": [
        {
          "from": "Latin sēra (diēs) 'late (day)'",
          "to": "sira /ˈsiɾa/ 'evening'"
        },
        {
          "from": "Latin mēnsis, mēnsem 'month'",
          "to": "misi /ˈmi.si/ 'month'",
          "note": "Compare Italian sera 'evening', which keeps e."
        }
      ]
    },
    {
      "language": "Proto-Germanic",
      "languageFamily": "Germanic",
      "examples": [
        {
          "from": "PIE *médʰyos 'middle'",
          "to": "*midjaz /ˈmið.jɑz/"
        },
        {
          "from": "PIE *pénkʷe 'five'",
          "to": "*fimf /ɸimɸ/"
        },
        {
          "from": "PIE *sédyeti 'sits'",
          "to": "*sitjaną /ˈsit.jɑ.nɑ̃/ 'to sit'",
          "note": "PIE *e was raised to *i before *i or *j in the next syllable and before a nasal plus consonant."
        }
      ]
    },
    {
      "language": "Gothic",
      "languageFamily": "East Germanic",
      "examples": [
        {
          "from": "Proto-Germanic *etaną 'to eat'",
          "to": "𐌹𐍄𐌰𐌽 (itan)"
        },
        {
          "from": "Proto-Germanic *gebaną 'to give'",
          "to": "𐌲𐌹𐌱𐌰𐌽 (giban)"
        },
        {
          "from": "Proto-Germanic *nemaną 'to take'",
          "to": "𐌽𐌹𐌼𐌰𐌽 (niman)"
        },
        {
          "from": "Proto-Germanic *wegaz 'way'",
          "to": "𐍅𐌹𐌲𐍃 (wigs)"
        },
        {
          "from": "Proto-Germanic *geldą 'payment'",
          "to": "𐌲𐌹𐌻𐌳 (gild)",
          "note": "Gothic raised every short *e to i; before r, h and ƕ the result was lowered again to ai [ɛ] (𐌱𐌰𐌹𐍂𐌰𐌽 bairan < *beraną)."
        }
      ]
    }
  ],
