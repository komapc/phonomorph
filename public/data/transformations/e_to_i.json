{
  "fromId": "e",
  "toId": "i",
  "preamble": "The shift from the mid front vowel [e] to the high front vowel [i] is a process of Vowel Raising. This can occur as a regular sound change in stressed syllables, part of a chain shift, or as a reduction process in unstressed syllables. In Greek, the Attic long close-mid vowel /eː/ spelled ει became /i/ in Koine (εἰρήνη /eːrɛ̌ːnɛː/ > /iˈrini/), part of itacism.",
  "phoneticEffects": "Vowel Raising",
  "languageExamples": [
    {
      "language": "English (Great Vowel Shift)",
      "languageFamily": "Germanic",
      "examples": [
        {
          "from": "take [teːkə]",
          "to": "[tiːk] > [teɪk]",
          "note": "Middle English long /e:/ raised to /i:/ as part of the Great Vowel Shift (later diphthongizing in many words)."
        },
        {
          "from": "meet [meːtə]",
          "to": "meet [miːt]",
          "note": "Long /e:/ regularly raised to /i:/."
        }
      ]
    },
    {
      "language": "Latin to Romance",
      "languageFamily": "Romance",
      "examples": [
        {
          "from": "fēcī (Latin)",
          "to": "hice (Spanish)",
          "note": "Raising of /e:/ to /i/ in some Romance verb forms."
        }
      ]
    },
    {
      "language": "Cholan languages (Proto-Mayan)",
      "languageFamily": "Mayan",
      "examples": [
        {
          "from": "Proto-Mayan *eː (long close-mid front vowel)",
          "to": "i",
          "note": "All Cholan languages (Ch'ol, Ch'orti', Chontal) raised Proto-Mayan long *eː to short /i/. This is one of two parallel raising changes in Cholan (the other being *oː > u), eliminating vowel length in the branch. The change is well-documented in Kaufman and Norman's Proto-Cholan reconstruction and is diagnostic for Cholan membership."
        }
      ]
    },
    {
      "language": "Proto-Indo-European to Proto-Celtic",
      "languageFamily": "Celtic",
      "examples": [
        {
          "from": "*weh₁-ro- (*wēro-) 'true'",
          "to": "*wīros > Old Irish fír, Welsh gwir",
          "note": "Regular Proto-Celtic raising of long *ē to *ī; cf. Latin vērus"
        },
        {
          "from": "*h₃rēǵs 'king'",
          "to": "*rīxs > Old Irish rí",
          "note": "cf. Latin rēx"
        },
        {
          "from": "*bʰréh₂tēr 'brother'",
          "to": "*brātīr > Old Irish bráthair"
        },
        {
          "from": "*méh₂tēr 'mother'",
          "to": "*mātīr > Old Irish máthir"
        }
      ]
    },
    {
      "language": "Proto-Japonic to Okinawan",
      "languageFamily": "Japonic",
      "examples": [
        {
          "from": "*ke 'hair'",
          "to": "kī [kiː]",
          "note": "*e > i; unlike original *i, the new i does not palatalize a preceding k"
        },
        {
          "from": "*ame 'rain'",
          "to": "ami"
        }
      ]
    },
    {
      "language": "Northern Sami",
