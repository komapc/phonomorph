          "to": "amahăɣ"
        },
        {
          "from": "Proto-Berber *e-ɣăzăr 'valley'",
          "to": "eɣahar"
        },
        {
          "from": "Proto-Berber *ta-mazir-t 'former encampment, land'",
          "to": "tămahart"
        },
        {
          "from": "Proto-Berber *ăzyəḍ 'to have scabies'",
          "to": "əhyəḍ",
          "note": "Sister dialects give the parallel reflexes š (Tamasheq ămašǝɣ, eɣăšăr) and z (Tawellemmet eɣăzăr); Tahaggart h also continues Proto-Berber *h and *β (éhŏḍ 'night' from *eβăḍ)."
        }
      ]
    }
