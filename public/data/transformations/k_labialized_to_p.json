{
  "fromId": "k_labialized",
  "toId": "p",
  "preamble": "The labialized voiceless velar stop [kʷ] becomes the bilabial stop [p] when its lip-rounding gesture is turned into the primary closure and the velar contact is lost. Proto-Indo-European *kʷ gave p in Greek before back vowels and consonants (ἕπομαι, λείπω, Lesbian πέμπε), in the P-Celtic languages Gaulish and Brythonic, in Osco-Umbrian, and again in Romanian, where Latin qu became p in aqua > apă and quattuor > patru, while Latin and Goidelic kept or delabialized it (Latin quis vs Oscan pís; Old Irish cenn vs Welsh pen).",
  "phoneticEffects": "Bilabialization, Merger",
  "languageExamples": [
    {
      "language": "Ancient Greek (from Proto-Greek)",
      "languageFamily": "Hellenic",
      "examples": [
        {
          "from": "PIE *sekʷ- 'to follow'",
          "to": "ἕπομαι hépomai 'I follow'",
          "note": "Compare Latin sequor and Sanskrit sácate."
        },
        {
          "from": "PIE *leykʷ- 'to leave behind'",
          "to": "λείπω leípō 'I leave'"
        },
        {
          "from": "PIE *pénkʷe 'five'",
          "to": "Lesbian and Thessalian πέμπε pémpe",
          "note": "In Lesbian kʷ became p even before e; Attic-Ionic has πέντε with a dental."
        }
      ]
    },
    {
      "language": "Gaulish",
      "languageFamily": "Celtic",
      "examples": [
        {
          "from": "Proto-Celtic *ekʷos 'horse'",
          "to": "epos",
          "note": "Old Irish ech keeps a velar."
        },
        {
          "from": "Proto-Celtic *kʷenkʷe 'five'",
          "to": "pempe"
        },
        {
          "from": "Proto-Celtic *kʷennom 'head'",
          "to": "pennon"
        },
        {
          "from": "Proto-Celtic *makʷos 'son'",
          "to": "mapos",
          "note": "Primitive Irish Ogham maqi (genitive) still writes the labiovelar."
        }
      ]
    },
    {
      "language": "Welsh",
      "languageFamily": "Brythonic",
      "examples": [
        {
          "from": "Proto-Celtic *kʷennom 'head'",
          "to": "Proto-Brythonic *penn > Old Welsh penn, Welsh pen"
        },
        {
          "from": "Proto-Celtic *kʷetwores 'four'",
          "to": "Old Welsh petguar, Welsh pedwar"
        },
        {
          "from": "Proto-Celtic *kʷenkʷe 'five'",
          "to": "Old Welsh pimp, Welsh pump",
          "note": "Breton penn shows the same initial p; between vowels the new p was later voiced by lenition (Proto-Brythonic *mab 'son')."
        }
      ]
    },
    {
      "language": "Osco-Umbrian (from Proto-Italic)",
      "languageFamily": "Osco-Umbrian",
      "examples": [
        {
          "from": "Proto-Italic *kʷis 'who' (< PIE *kʷís)",
          "to": "Oscan pís, píd; Umbrian pisi",
          "note": "Latin keeps the labiovelar in quis, quid."
        },
        {
          "from": "Proto-Italic *kʷenkʷe 'five'",
          "to": "Umbrian pumpeřias (a derived adjective)",
          "note": "Latin quīnque keeps both labiovelars."
        }
      ]
    },
    {
      "language": "Romanian",
      "languageFamily": "Eastern Romance",
      "examples": [
        {
          "from": "Latin aqua 'water'",
          "to": "apă /ˈa.pə/",
          "note": "Aromanian apã, Megleno-Romanian apu and Istro-Romanian åpę agree."
        },
        {
          "from": "Latin quattuor 'four'",
          "to": "patru [ˈpa.tru]",
          "note": "Via Proto-Italic *kʷettwōr; Sardinian batero, batoro shows a voiced labial instead."
        }
      ]
    }
  ],
