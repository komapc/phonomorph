  "preamble": "The voiceless retroflex affricate /ʈʂ/ is voiced to [ɖʐ] before a voiced obstruent by regressive voicing assimilation in Polish, where obstruent clusters agree in voicing with their last member. Polish cz /t͡ʂ/ is pronounced [d͡ʐ] before b in liczba 'number' (cf. liczyć 'to count') and Kluczbork (cf. klucz 'key'). Before vowels and sonorants the affricate stays voiceless.",
  "phoneticEffects": "Voicing, Regressive Assimilation",
  "languageExamples": [
    {
      "language": "Polish",
      "languageFamily": "West Slavic",
      "isAllophone": true,
      "examples": [
        {
          "from": "liczyć /ˈli.t͡ʂɘt͡ɕ/ 'to count' (cz before a vowel)",
          "to": "liczba /ˈlid͡ʐ.ba/ 'number'",
          "note": "cz is voiced before the voiced stop b."
        },
        {
          "from": "klucz /ˈklut͡ʂ/ 'key'",
          "to": "Kluczbork /ˈklud͡ʐ.bɔrk/ (town)",
          "note": "The same assimilation applies in the compound place name."
        },
        {
          "from": "liczyć /ˈli.t͡ʂɘt͡ɕ/",
          "to": "liczbowy /lid͡ʐˈbɔ.vɘ/ 'numerical'"
        }
      ]
    }
  ],
