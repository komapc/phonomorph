    },
    {
      "language": "Yucatec Maya",
      "languageFamily": "Mayan",
      "examples": [
        {
          "from": "glottalized /tʼ/ in coda position",
          "to": "[ʔ]",
          "note": "In Yucatec Maya, glottalized stops /pʼ tʼ kʼ/ followed by an identical consonant optionally debuccalize to [ʔ], losing their oral place of articulation. The ejective quality is retained as a pure glottal closure."
        },
        {
          "from": "word-final [t] at prosodic boundary",
          "to": "[h] or [ʔ]",
          "note": "Word-final stop debuccalization /T/→[h] at phrase boundaries is well-documented in Yucatec. Final oral stops weaken to laryngeal segments in coda position across all places of articulation."
        }
      ]
    },
    {
      "language": "Wu and Jin Chinese",
      "languageFamily": "Sinitic",
      "examples": [
        {
          "from": "八 MC peat [-t]",
          "to": "Shanghainese paʔ [paʔ]",
          "note": "Final stops of Middle Chinese merged into a glottal stop in Wu and Jin; Cantonese keeps -p -t -k."
        }
      ]
    },
