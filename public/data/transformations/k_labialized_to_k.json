{
  "fromId": "k_labialized",
  "toId": "k",
  "preamble": "Delabialization removes the lip rounding of the labialized velar [kʷ], leaving a plain velar stop [k]. It is the defining merger of the satem branches, where Proto-Indo-European *kʷ fell together with plain *k in Indo-Iranian and Balto-Slavic (later palatalized before front vowels), and it happened independently in Goidelic Celtic, where Primitive Irish still wrote the labiovelar with the Ogham letter Q (maqi 'of the son') before it became Old Irish c.",
  "phoneticEffects": "Delabialization, Merger",
  "languageExamples": [
    {
      "language": "Old Irish (from Proto-Celtic)",
      "languageFamily": "Goidelic",
      "examples": [
        {
          "from": "Proto-Celtic *kʷennom 'head'",
          "to": "Old Irish cenn, Irish ceann",
          "note": "Welsh pen shows the P-Celtic outcome."
        },
        {
          "from": "Proto-Celtic *kʷetwores 'four'",
          "to": "Old Irish cethair"
        },
        {
          "from": "Proto-Celtic *kʷenkʷe 'five'",
          "to": "Old Irish cóic"
        },
        {
          "from": "Primitive Irish ᚋᚐᚊᚔ maqi 'of the son' (< Proto-Celtic *makʷos)",
          "to": "Old Irish macc"
        }
      ]
    },
    {
      "language": "Proto-Indo-Iranian",
      "languageFamily": "Indo-Iranian",
      "examples": [
        {
          "from": "PIE *wĺ̥kʷos 'wolf'",
          "to": "Proto-Indo-Iranian *wŕ̥kas (Sanskrit vṛ́ka)"
        },
        {
          "from": "PIE *kʷóh₁ 'how, with what' (instrumental)",
          "to": "Proto-Indo-Iranian *kaH (Avestan kā 'with what?')",
          "note": "Before front vowels the merged *k was later palatalized, so those words belong to a separate chain."
        }
      ]
    },
    {
      "language": "Proto-Balto-Slavic",
      "languageFamily": "Balto-Slavic",
      "examples": [
        {
          "from": "PIE *wĺ̥kʷos 'wolf'",
          "to": "Proto-Balto-Slavic *wilkás"
        },
        {
          "from": "PIE *kʷóh₁ 'how' (instrumental)",
          "to": "Lithuanian kuõ"
        }
      ]
    }
  ],
