          "from": "Old Latin vortō 'I turn' (Plautus)",
          "to": "Classical vertō",
          "note": "Part of the 2nd-century BC change vo- > ve- before s, t and r plus consonant."
        },
        {
          "from": "Old Latin voster 'your (pl.)'",
          "to": "Classical vester",
          "note": "The older vo- form survived in Vulgar Latin and underlies Spanish vuestro and Italian vostro."
        },
        {
          "from": "Old Latin vortex 'whirlpool'",
          "to": "vertex 'whirl, summit'",
          "note": "The two forms survived side by side as doublets."
        },
