  "preamble": "Spirantization of the aspirated dental stop [tʰ] to the dental fricative [θ]. Greek θ was [tʰ] in Classical Attic and [θ] by the 4th century CE Koine. Proto-Indo-Iranian *tʰ likewise became Iranian *θ (Sanskrit ratha vs. Avestan raθa).",
  "phoneticEffects": "Spirantization",
  "languageExamples": [
    {
      "language": "Greek",
      "languageFamily": "Hellenic",
      "examples": [
        {
          "from": "θεός /tʰe.ós/ 'god' (5th c. BCE Attic)",
          "to": "/θeˈos/ (4th c. CE Koine)",
          "note": "Aspirated stops φ θ χ became fricatives in the Koine period."
        },
        {
          "from": "θυγάτηρ /tʰu.ɡá.tɛːr/ 'daughter' (5th c. BCE Attic)",
          "to": "Modern Greek θυγατέρα /θi.ɣaˈte.ra/"
        },
        {
          "from": "θάνατος /tʰá.na.tos/ 'death' (5th c. BCE Attic)",
          "to": "/ˈθa.na.tos/ (4th c. CE Koine), Modern Greek θάνατος /ˈθa.na.tos/"
        },
        {
          "from": "θάλασσα /tʰá.las.sa/ 'sea' (5th c. BCE Attic)",
          "to": "/ˈθa.las.sa/ (4th c. CE Koine), Modern Greek θάλασσα [ˈθalasa]"
        }
      ]
    },
    {
      "language": "Avestan",
      "languageFamily": "Iranian",
      "examples": [
        {
          "from": "Proto-Indo-Iranian *HrátʰHas 'chariot' (Sanskrit रथ rátha)",
          "to": "raθa",
          "note": "Proto-Indo-Iranian *pʰ *tʰ *kʰ became *f *θ *x in most Iranian languages."
        },
        {
          "from": "Proto-Indo-Iranian *gaHtʰás 'song' (Sanskrit गाथा gāthā)",
          "to": "gāθā 'verse, Gatha'"
        }
      ]
    }
  ],
