        {
          "from": "Proto-Malayo-Polynesian *punti 'banana'",
          "to": "fontsy"
        },
        {
          "from": "Proto-Malayo-Polynesian *zaqat 'bad, evil'",
          "to": "ratsy",
          "note": "Final *-t with the Malagasy paragogic vowel -i yields -tsy; contrast -tra after other vowels, as in lanitra < *laŋit."
        }
      ]
