          "to": "Ancient Greek zugon",
          "note": "Meaning 'yoke'. Classic example of the PIE *y- to Greek z- shift."
        },
        {
          "from": "Proto-Indo-European *yes- 'to boil, foam'",
          "to": "ζέω (zéō) 'I boil'"
        }
      ]
    },
