      "language": "Malagasy (Merina)",
      "languageFamily": "Barito",
      "examples": [
        {
          "from": "Proto-Malagasy *yatuh 'hundred' (< PMP *Ratus)",
          "to": "zato",
          "note": "Merina z reflects Proto-Malagasy *y in all positions. The *y here comes from PMP *R by way of Proto-Southeast Barito *y. The change is recent and Merina-centred: Sakalava, Bara and Tandroy partly keep y."
        },
        {
          "from": "Proto-Malagasy *tetey-an 'bridge'",
          "to": "tetezana",
          "note": "The from-form is Adelaar's Proto-Malagasy reconstruction."
        },
        {
          "from": "Proto-Southeast Barito *uyat 'vein'",
          "to": "ozatra 'vein, nerve, tendon'",
          "note": "The from-form is Adelaar's Proto-Southeast Barito reconstruction, via Proto-Malagasy *uyat."
        }
      ]
