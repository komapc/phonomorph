{
  "fromId": "j_glide",
  "toId": "z",
  "preamble": "The palatal approximant [j] is strengthened to the voiced alveolar fricative [z]: the constriction is narrowed to frication and moved forward to the alveolar ridge. Olukumi has z for Proto-Yoruboid *j, Merina Malagasy has z for Proto-Malagasy *y, and Guajajára (Tenetehara) has z for Proto-Tupi-Guarani *j.",
  "phoneticEffects": "Fortition, Fronting, Alveolarization",
  "languageExamples": [
    {
      "language": "Proto-Yoruboid to Olukumi",
      "languageFamily": "Yoruboid",
      "examples": [
        {
          "from": "*é-jò 'snake'",
          "to": "ẹzò",
          "note": "Olukumi z for *j; cf. Yoruba ejò, Igala éjò"
        },
        {
          "from": "*á-jà 'village'",
          "to": "ọzà",
          "note": "cf. Igala ájà"
        },
        {
          "from": "*jĩ́ 'to steal'",
          "to": "zin",
          "note": "cf. Yoruba, Igala jí"
        }
      ]
    },
    {
      "language": "Malagasy (Merina)",
      "languageFamily": "Barito",
      "examples": [
        {
          "from": "Proto-Malagasy *yatuh 'hundred' (< PMP *Ratus)",
          "to": "zato",
          "note": "Merina z reflects Proto-Malagasy *y in all positions. The *y here comes from PMP *R by way of Proto-Southeast Barito *y. The change is recent and Merina-centred: Sakalava, Bara and Tandroy partly keep y."
        },
        {
          "from": "Proto-Malagasy *tetey-an 'bridge'",
          "to": "tetezana",
          "note": "The from-form is Adelaar's Proto-Malagasy reconstruction."
        },
        {
          "from": "Proto-Southeast Barito *uyat 'vein'",
          "to": "ozatra 'vein, nerve, tendon'",
          "note": "The from-form is Adelaar's Proto-Southeast Barito reconstruction, via Proto-Malagasy *uyat."
        }
      ]
    },
    {
      "language": "Guajajára (Tenetehara)",
      "languageFamily": "Tupi-Guarani",
      "examples": [
        {
          "from": "Proto-Tupi-Guarani *jakare 'caiman'",
          "to": "zakare",
          "note": "Tenetehara has a phoneme /z/, realized [j] only before a consonant or word-finally; Old Tupi keeps the glide (îakaré)."
        },
        {
          "from": "Proto-Tupi-Guarani *ajuru 'parrot'",
          "to": "azuru",
          "note": "Cf. Old Tupi aîuru."
        },
        {
          "from": "Proto-Tupi-Guarani *jawar 'jaguar'",
          "to": "zawar",
          "note": "Cf. Old Tupi îagûara."
        },
        {
          "from": "Proto-Tupi-Guarani *jukɨr 'salt'",
          "to": "zukyr",
          "note": "Cf. Old Tupi îukyra."
        }
      ]
    }
  ],
