  "fromId": "n",
  "toId": "t",
  "preamble": "The shift from the alveolar nasal [n] to the voiceless alveolar stop [t] is a denasalization (fortition) of the nasal. It is attested as a regular word-final change in Austronesian: Roglai (Chamic) and Urak Lawoi (Malayic) turned final *n into t (Proto-Chamic *hujaːn 'rain' > hujaːt, Proto-Malayic *bulan 'moon' > bulat).",
  "phoneticEffects": "Denasalization, Fortition",
  "languageExamples": [
    {
      "language": "Proto-Chamic to Roglai",
      "languageFamily": "Chamic",
      "examples": [
        {
          "from": "*hujaːn 'rain'",
          "to": "hujaːt",
          "note": "final nasal hardening; cf. Cham hajan"
        },
        {
          "from": "*jalaːn 'road'",
          "to": "jalàt"
        },
        {
          "from": "*thun 'year'",
          "to": "thut"
        },
        {
          "from": "*tiyaːn 'belly'",
          "to": "matiat"
        }
      ]
    },
    {
      "language": "Proto-Malayic to Urak Lawoi",
      "languageFamily": "Malayic",
      "examples": [
