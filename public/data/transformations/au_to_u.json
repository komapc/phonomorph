{
  "fromId": "au",
  "toId": "u",
  "preamble": "Monophthongization of [au] directly to a high back vowel, skipping or passing quickly through [o]. Proto-Balto-Slavic *au became Proto-Slavic *u under the law of open syllables (Lithuanian taũras ~ Old Church Slavonic turъ 'aurochs'); Proto-Semitic *aw contracted to ū in Akkadian (*yawm- > ūmum 'day'). More often au stops at o (see au_to_o).",
  "phoneticEffects": "Monophthongization, Raising",
  "languageExamples": [
    {
      "language": "Proto-Slavic",
      "languageFamily": "Slavic",
      "examples": [
        {
          "from": "Proto-Balto-Slavic *taurás 'aurochs'",
          "to": "*turъ (Old Church Slavonic туръ)",
          "note": "Lithuanian taũras, Old Prussian tauris keep the diphthong."
        },
        {
          "from": "Proto-Balto-Slavic *auš- 'ear'",
          "to": "*uxo (Old Church Slavonic оухо)",
          "note": "Lithuanian ausìs, Latvian auss; the s > x is the separate ruki rule."
        },
        {
          "from": "Proto-Balto-Slavic *saušás 'dry'",
          "to": "*suxъ",
          "note": "Same *au > *u monophthongization."
        }
      ]
    },
    {
      "language": "Akkadian",
      "languageFamily": "East Semitic",
      "examples": [
        {
          "from": "Proto-Semitic *yawm- 'day'",
          "to": "ūmum",
          "note": "The diphthong *aw contracted to long ū; compare Arabic yawm, which keeps it."
        },
        {
          "from": "Proto-Semitic *ṯawr- 'bull'",
          "to": "šūrum"
        }
      ]
    }
  ],
