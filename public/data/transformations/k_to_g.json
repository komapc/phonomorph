      "language": "Turkish",
      "languageFamily": "Turkic",
      "examples": [
        {
          "from": "Proto-Turkic *kẹl- 'to come'",
          "to": "gelmek",
          "note": "Oghuz (Western Turkic) voiced Proto-Turkic word-initial *k- before front vowels; Old Turkic keeps kel-."
        },
        {
          "from": "Proto-Turkic *kȫk 'blue, sky'",
          "to": "gök",
          "note": "cf. Old Turkic kök."
