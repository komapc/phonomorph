  "fromId": "t",
  "toId": "t_palatal",
  "preamble": "Palatalization of the alveolar stop [t] to the palatal stop [c]. In Czech and Slovak, Proto-Slavic *t became palatal ť [c] before front vowels (*i, *ě, and in Slovak also *e), so that Czech tichý is [ˈcɪxiː] and Slovak deti is [ˈɟeci]; the orthography still writes ⟨ti, tě⟩ for [ci, cɛ].",
  "languageExamples": [
    {
      "language": "Czech",
      "languageFamily": "West Slavic",
      "examples": [
        {
          "from": "Proto-Slavic *tixъ 'quiet'",
          "to": "tichý [ˈcɪxiː]",
          "note": "Inherited *t before *i became palatal ť, written ⟨t⟩ before ⟨i⟩."
        },
        {
          "from": "Proto-Slavic *tělo 'body'",
          "to": "tělo [ˈcɛlo]",
          "note": "Before *ě the same palatal ť arose; Old Czech is reconstructed as /ˈci̯ɛɫo/."
        }
      ]
    },
    {
      "language": "Slovak",
      "languageFamily": "West Slavic",
      "examples": [
        {
          "from": "Proto-Slavic *děti 'children'",
          "to": "deti [ˈɟeci]",
          "note": "Final *ti became [ci]; the initial *d shows the parallel change to [ɟ]."
        },
        {
          "from": "Proto-Slavic *platiti 'to pay'",
          "to": "platiť [ˈplacic]",
          "note": "Both the medial and the final *t became palatal before *i."
        }
      ]
    },
    {
      "language": "Paiwan",
      "languageFamily": "Paiwan",
      "examples": [
        {
          "from": "PAn *təlu 'three'",
          "to": "tjelu"
        },
        {
          "from": "PAn *tənun 'to weave (cloth)'",
          "to": "tjenun"
        },
        {
          "from": "PAn *təbuS 'sugarcane'",
          "to": "tjevus"
        },
        {
          "from": "PAn *pitu 'seven'",
          "to": "pitju"
        },
        {
          "from": "PAn *Səpat 'four'",
          "to": "sepatj",
          "note": "Paiwan ⟨tj⟩ is the voiceless palatal stop /c/."
        }
      ]
    }
  ],
