  "toId": "v",
  "preamble": "Prothetic [v] before word-initial back rounded vowels is a recurrent Slavic development. It gives a vowel-initial word a consonant onset. Belarusian and Ukrainian added v- before inherited initial *o and *u (Proto-Slavic *oko 'eye' > Belarusian вока, *uxo 'ear' > Ukrainian вухо). Russian has it in a few words such as восемь 'eight' from *osmь. Colloquial Common Czech adds v- to almost every word beginning with o- (vokno for standard okno 'window').",
  "phoneticEffects": "Prothesis, Epenthesis",
  "languageExamples": [
    {
      "language": "Belarusian",
      "languageFamily": "East Slavic",
      "examples": [
        {
          "from": "Proto-Slavic *oko 'eye' (Old Ruthenian око)",
          "to": "вока [ˈvoka]",
          "note": "Prothetic [v] before initial o; compare Russian око without prothesis."
        },
        {
          "from": "Proto-Slavic *uxo 'ear'",
          "to": "вуха [ˈvuxa]",
          "note": "Same prothesis before initial u; compare Russian ухо."
        }
      ]
    },
    {
      "language": "Ukrainian",
      "languageFamily": "East Slavic",
      "examples": [
        {
          "from": "Proto-Slavic *uxo 'ear'",
          "to": "вухо",
          "note": "Prothetic [v] before initial u."
        },
        {
          "from": "Proto-Slavic *okъno 'window'",
          "to": "вікно",
          "note": "Prothetic v- before initial o, whose vowel later became i in the newly closed syllable."
        }
      ]
    },
    {
      "language": "Russian",
      "languageFamily": "East Slavic",
      "examples": [
        {
          "from": "Old East Slavic осмь, Proto-Slavic *osmь 'eight'",
          "to": "восемь",
          "note": "Prothetic v- in a handful of Russian words."
        },
        {
          "from": "Old East Slavic отьчина 'patrimony'",
          "to": "вотчина",
          "note": "Same prothesis before initial o."
        }
      ]
    },
    {
      "language": "Czech (Common Czech)",
      "languageFamily": "West Slavic",
      "examples": [
        {
          "from": "standard okno 'window'",
          "to": "vokno",
          "note": "Common Czech, the colloquial interdialect of Bohemia, adds v- to words beginning with o-."
        },
        {
          "from": "standard oko 'eye'",
          "to": "voko",
          "note": "Same prothesis; also votevřít for otevřít 'to open'."
        }
      ]
    }
