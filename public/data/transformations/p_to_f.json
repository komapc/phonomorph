    {
      "language": "Proto-Iranian",
      "languageFamily": "Iranian",
      "examples": [
        {
          "from": "PIE *p before consonant (e.g. *ptar-)",
          "to": "Proto-Iranian *f (e.g. *ftar-)",
          "note": "Partial Grimm's Law in Iranian: voiceless stop /p/ became fricative /f/ before another consonant. PIE *sapta 'seven' → Proto-Iranian *hafta (cf. Persian هفت haft, Avestan hapta). Compare Sanskrit sapta, which preserves *p."
        },
        {
          "from": "PIE *pṇtí- 'path'",
          "to": "Avestan pantā / Old Persian *patha",
          "note": "The PIE aspirated *ph → Iranian /f/ in many cluster positions. Modern Persian panj 'five' < Proto-Iranian *panca, showing partial preservation of /p/ word-initially without a following consonant."
        }
      ]
    },
    {
      "language": "Kurdish",
      "languageFamily": "Iranian",
      "examples": [
        {
          "from": "Proto-Iranian *pra- cluster",
          "to": "fra- / f- in Kurdish",
          "note": "Proto-Iranian *pr > *fr spirantization is reflected in Kurdish farwâr 'present' (< *pra-bara- 'brought forward'). The p-to-f shift in consonant clusters is a hallmark of the Iranian branch."
        }
