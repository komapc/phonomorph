          "to": "peldón, Puelto Rico",
          "note": "Syllable-final /ɾ/ not followed by a vowel often becomes [l]."
        },
        {
          "from": "verso [ˈbeɾso] 'verse'",
          "to": "[ˈbelso]",
          "note": "Alternates with [ˈbeɾso], [ˈberso] and [ˈbeɹso]."
        }
